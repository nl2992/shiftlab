    60	# ------------------------------------------------------------------------------------------------
    61	# Pluggable certificates: update(z, event_t) -> current e-value for one side.
    62	# ------------------------------------------------------------------------------------------------
    63	class _Cert:
    64	    """Started mixture (QSG) e-process; ``side=+1`` tests H+: p<=1/2, ``-1`` tests H-: p>=1/2."""
    65	
    66	    def __init__(self, side: int):
    67	        self.m = StartedMixture(side)
    68	
    69	    def update(self, z: int, event_t: int, last=None) -> float:
    70	        return self.m.update(z)
    71	
    72	
    73	class _EnvCert:
    74	    """Gap-aware Markov-envelope started mixture (qsg.EnvelopeMixture, declared rho_bar)."""
    75	
    76	    def __init__(self, side: int, rho_bar: float = 0.8):
    77	        self.m = EnvelopeMixture(side, rho_bar)
    78	
    79	    def update(self, z: int, event_t: int, last=None) -> float:
    80	        return self.m.update_at(z, event_t)
    81	
    82	
    83	class _A1Cert:
    84	    """Family A's A1 evidence (fam_a.MarkovSUI: gap-aware Markov sequential universal inference,
    85	    no declared rho bound). ``last`` is the immediately preceding queried outcome of the WHOLE
    86	    stream (z, issue event), which the Markov null conditions on even for a test started later."""
    87	
    88	    def __init__(self, side: int, sui_cls, **kw):
    89	        self.side, self.m = side, sui_cls(**kw)
    90	
    91	    def update(self, z: int, event_t: int, last=None) -> float:
    92	        hit = z if self.side > 0 else 1 - z
    93	        prev, gap = None, 0
    94	        if last is not None:
    95	            prev = last[0] if self.side > 0 else 1 - last[0]
    96	            gap = event_t - last[1]
    97	        return self.m.update(hit, gap, prev)
    98	
    99	
   100	def started_mixture(side):
   101	    return _Cert(side)
   102	
   103	
   104	def envelope(rho_bar):
   105	    return lambda side: _EnvCert(side, rho_bar)
   106	
   107	
   108	def _a1_or_standin(rho_bar=0.8):
   109	    """Use Family A's A1 evidence (fam_a.MarkovSUI) if importable; else the envelope stand-in.
   110	
   111	    Returns (factory, label). The label is recorded in the ledger.
   112	    """
   113	    try:
   114	        import fam_a  # noqa: PLC0415
   115	
   116	        sui = fam_a.MarkovSUI
   117	        return (lambda side: _A1Cert(side, sui)), "fam_a.MarkovSUI (A1 evidence, default kwargs)"
   118	    except Exception:  # pragma: no cover - fam_a absent or broken: stand-in
   119	        pass
   120	    return envelope(rho_bar), f"A1 stand-in: qsg.EnvelopeMixture(rho_bar={rho_bar})"
   121	
   122	
   123	# ------------------------------------------------------------------------------------------------
   124	# Host adapters: the only per-host shim is how a gate-acquired label is handed to the host.
   125	# ------------------------------------------------------------------------------------------------
   126	def _host_extra(host, event) -> dict:
   127	    """Issue-time extras the host's update needs for a label it did not draw itself."""
   128	    if isinstance(host, CAMSDeploymentAdapter):
   129	        return {"E": host.core._prepare(event)["e"].copy()}
   130	    return {}
   131	
   132	
   133	def _host_u(host, event, hreq) -> float:
   134	    """The host's own issue-time query probability u_t for this event (whether or not it drew).
   135	
   136	    Model Picker reports u_t on every disagreement; CAMS reports it only when drawn, so it is
   137	    recomputed without a draw (no generator use); Model Selector's record gate is deterministic.
   138	    """
   139	    if hreq.requested:
   140	        return float(hreq.probability)
   141	    if isinstance(host, ModelPickerDeploymentAdapter):
   142	        return float(hreq.probability)
   143	    if isinstance(host, CAMSDeploymentAdapter):
   144	        return float(host.core.decide(event, draw=False)[0])
   145	    return 0.0
   146	
   147	
   148	def make_host(kind: str, r):
   149	    """Hosts use the SAME private generator names as the native registry entries, so a gated
   150	    host replays the native host's randomness exactly until gate-acquired labels change it."""
   151	    if kind == "mp":
   152	        return ModelPickerDeploymentAdapter(2, 2, r("model_picker"))
   153	    if kind == "cams":
   154	        return CAMSDeploymentAdapter(n_models=2, n_classes=2, advice_fn=stack_advice(2, []),
   155	                                     rng=r("cams"))
   156	    if kind == "ms":
   157	        return ModelSelectorCausalAdapter(2, 2, r("model_selector"))
   158	    raise ValueError(kind)
