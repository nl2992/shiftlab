    39	                "W_null_dep_r95", "W_worse_dep_r8"]

--- scripts/sota_sprint/gate_audit.py ---
     1	"""Mechanical audit of the sprint's mandatory execution gate (brief section 14A) from RAW records.
     2	
     3	For each of the 24 candidates it checks, from saved records under ``outputs/sota_sprint/{A,B,C,D,X}``
     4	(not from ledger prose): executed in the simulator; >= 4 diagnostic environments; paired seeds
     5	(same seed set as a published comparator in the same run); >= 1 null environment; >= 1 environment
     6	outside the intended advantage region; a mechanism ablation row (another policy whose name extends
     7	the candidate's, or a registered ablation alias); cost/efficacy/safety metrics present; and a
     8	manifest whose recorded source hash for the family module matches a committed revision.
     9	
    10	    uv run python scripts/sota_sprint/gate_audit.py
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	import hashlib
    16	import json
    17	import subprocess
    18	from collections import defaultdict
    19	from pathlib import Path
    20	
    21	ROOT = Path(__file__).resolve().parents[2]
    22	OUTS = ROOT / "outputs/sota_sprint"
    23	IDS = [f"{f}{i}" for f in "ABCD" for i in range(1, 7)]
    24	NULLS = {"F0_null", "F0_worse", "F5_dep_null_r8", "F5_dep_null_r95", "S_rare_null"}
    25	# environments outside each family's intended advantage region (declared in the family briefs)
    26	OUTSIDE = {"A": {"F1_late_800", "F1_late_1200", "F3_reversal_800", "F4_recurrent", "F2_transient"},
    27	           "B": {"F0_better", "F9_bursty_better", "F7_near_better"},
    28	           "C": {"F1_late_800", "F3_reversal_800", "F4_recurrent"},
    29	           "D": {"F3_reversal_800", "F4_recurrent"}}
    30	# ablation aliases where an ablation is not named "<id>-..." (from the family ledgers)
    31	ABLATION_ALIAS = {"B5": ["B5-reserve", "B5-rollback", "B5-deadline", "B5_no_reserve",
    32	                         "B5_no_rollback", "B5_no_deadline"],
    33	                  "A5": ["A5-fixedgap6", "A1"], "A6": ["A6-noinflight", "A5"],
    34	                  "D6": ["D1", "D6-D1params:ms"], "D5": ["D5-standin_env8", "D2"],
    35	                  "D4": ["D4-no_reserve", "D4-r10", "D1"], "D2": ["D2-host_only"],
    36	                  "C5": ["C2", "C1"], "C6": ["C6@discern"], "C3": ["QSG", "QSG-r25"],
    37	                  "C4": ["discern_design_floor+pace_tuned"], "C1": ["C1-kappa1"],
    38	                  "B1": ["B1_r10", "B1_r15", "B1_r25"],
    39	                  # single-mechanism candidates: the host without the mechanism is the ablation
    40	                  "A4": ["QSG", "A1"], "B2": ["B0_host"], "B3": ["B0_host"], "B4": ["B0_host"],
    41	                  "B6": ["B5"]}
    42	PUBLISHED = {"xu_acquisition_only", "gated_adaptive_range", "gated_adaptive_range+front",
    43	             "discern_style", "discern_design_floor", "SMCS+retain-incumbent",
    44	             "model_picker_adapter", "cams_adapter", "model_selector_causal"}
    45	
    46	
    47	def _blob_hashes(name: str) -> set[str]:
    48	    """sha256[:16] of every committed revision of scripts/sota_sprint/<name>."""
    49	    revs = subprocess.run(["git", "log", "--format=%H", "--", f"scripts/sota_sprint/{name}"],
    50	                          cwd=ROOT, capture_output=True, text=True).stdout.split()
    51	    out = set()
    52	    for r in revs:
    53	        b = subprocess.run(["git", "show", f"{r}:scripts/sota_sprint/{name}"], cwd=ROOT,
    54	                           capture_output=True).stdout
    55	        if b:
    56	            out.add(hashlib.sha256(b).hexdigest()[:16])
    57	    return out
    58	
    59	
    60	def main():
    61	    regs = defaultdict(set)
    62	    seeds = defaultdict(lambda: defaultdict(set))
    63	    runs = defaultdict(set)
    64	    metric_ok = defaultdict(bool)
    65	    for fam in "ABCDX":
    66	        for rec in (OUTS / fam).rglob("records.jsonl"):
    67	            run = rec.parent
    68	            with open(rec) as f:
    69	                for line in f:
    70	                    r = json.loads(line)
    71	                    p = r["policy"]
    72	                    regs[p].add(r["regime"])
    73	                    seeds[(run, r["regime"])][p].add((r["ep"], r["seed"]))
    74	                    runs[p].add(run)
    75	                    metric_ok[p] = metric_ok[p] or all(k in r for k in (
    76	                        "net", "loss", "labels", "switches", "ever_promote", "regret_expected_oracle"))
    77	    hashes = {n: _blob_hashes(n) for n in ("fam_a.py", "fam_b.py", "fam_c.py", "fam_d.py")}
    78	    report = {}
    79	    for cid in IDS:
    80	        fam = cid[0]
    81	        names = [p for p in regs if p == cid or p.startswith(cid + "_") and cid == "B1"]
    82	        if cid == "B1":
    83	            names = [p for p in regs if p in ("B1_r10", "B1_r15", "B1_r25")]
    84	        if cid == "D6":
    85	            names = [p for p in regs if p in ("D6:mp", "D6:cams", "D6:ms")]
    86	        if cid in ("C6",):
    87	            names = [p for p in regs if p in ("C6", "C6@discern")]
    88	        main_name = cid if cid in regs else (names[0] if names else None)
    89	        ok = {}
    90	        if main_name is None:
    91	            report[cid] = {"executed": False}
    92	            continue
    93	        rs = regs[main_name]
    94	        ok["executed"] = True
    95	        ok["n_envs"] = len(rs)
    96	        ok["envs_ge4"] = len(rs) >= 4
    97	        ok["null_env"] = bool(rs & NULLS)
    98	        ok["outside_env"] = bool(rs & OUTSIDE[fam])
    99	        abl = [p for p in regs if p != main_name and (p.startswith(cid + "-") or p.startswith(cid + "_")
   100	                                                      or p in ABLATION_ALIAS.get(cid, []))]
   101	        ok["ablation_rows"] = sorted(abl)[:6]
   102	        ok["ablation"] = bool(abl)
   103	        paired = False
   104	        for (run, reg), d in seeds.items():
   105	            if main_name in d and any(c in d and d[c] == d[main_name] for c in PUBLISHED):
   106	                paired = True
   107	                break
   108	        ok["paired_with_published"] = paired
   109	        ok["metrics"] = metric_ok[main_name]
   110	        mf_ok = []
   111	        for run in runs[main_name]:
   112	            m = run / "manifest.json"
   113	            if m.exists():
   114	                src = json.loads(m.read_text()).get("sources", {}).get(f"fam_{fam.lower()}.py")
   115	                mf_ok.append(src in hashes[f"fam_{fam.lower()}.py"] if src else None)
   116	        ok["manifest_hash_committed"] = any(mf_ok)
   117	        ok["runs"] = sorted(str(r.relative_to(ROOT)) for r in runs[main_name])
   118	        ok["PASS"] = all(ok[k] for k in ("executed", "envs_ge4", "null_env", "outside_env",
   119	                                         "ablation", "paired_with_published", "metrics",
   120	                                         "manifest_hash_committed"))
   121	        report[cid] = ok
   122	    out = ROOT / "docs/sota_sprint/gate_audit.json"
   123	    out.write_text(json.dumps(report, indent=1) + "\n")
   124	    for cid, ok in report.items():
   125	        miss = [k for k in ("executed", "envs_ge4", "null_env", "outside_env", "ablation",
   126	                            "paired_with_published", "metrics", "manifest_hash_committed")
   127	                if not ok.get(k)]
   128	        print(f"{cid}: {'PASS' if ok.get('PASS') else 'FAIL'} envs={ok.get('n_envs')} "
   129	              f"missing={miss} abl={ok.get('ablation_rows', [])[:3]}")
   130	
   131	
   132	if __name__ == "__main__":
   133	    main()

--- scripts/sota_sprint/leaderboard.py ---
     1	"""Merge family ledgers into the 24-candidate registry and build the machine-readable leaderboard.
     2	
     3	Inputs: ``docs/sota_sprint/candidates.json`` (registry) and ``docs/sota_sprint/family_*/ledger.json``
     4	(each a list or dict of entries with at least ``id`` and ``status``). Optional validation summaries
     5	are merged from ``docs/sota_sprint/validation/leaderboard_inputs.json``. Development and validated
     6	results are kept in separate fields; a candidate counts as executed only with a results artifact.
     7	
     8	    uv run python scripts/sota_sprint/leaderboard.py
     9	"""
    10	
    11	from __future__ import annotations
    12	
    13	import json
    14	from pathlib import Path
    15	
    16	ROOT = Path(__file__).resolve().parents[2]
    17	DOCS = ROOT / "docs/sota_sprint"
    18	IDS = [f"{f}{i}" for f in "ABCD" for i in range(1, 7)]
    19	FIELDS = ["id", "parent", "added_components", "intended_failure_mechanism", "implementation",
    20	          "status", "dev_environments", "n_runs", "dev_cost_vs_best_certified",
    21	          "dev_efficacy", "null_safety", "strongest_comparator_beaten", "novelty",
    22	          "ablation", "real_data", "validation", "next_action", "results_artifact"]
    23	
    24	
    25	def _entries(path: Path) -> list[dict]:
    26	    d = json.loads(path.read_text())
    27	    if isinstance(d, dict):
    28	        d = d.get("candidates", d.get("entries", d))
    29	        d = list(d.values()) if isinstance(d, dict) else d
    30	    return [e for e in d if isinstance(e, dict) and "id" in e]
    31	
    32	
    33	def main():
    34	    reg = json.loads((DOCS / "candidates.json").read_text())
    35	    for led in sorted(DOCS.glob("family_*/ledger.json")):
    36	        for e in _entries(led):
    37	            if e["id"] in reg:
    38	                reg[e["id"]].update({k: v for k, v in e.items() if v is not None})
    39	                reg[e["id"]]["ledger"] = str(led.relative_to(ROOT))
    40	    val = DOCS / "validation/leaderboard_inputs.json"
    41	    if val.exists():
    42	        for cid, v in json.loads(val.read_text()).items():
    43	            reg.setdefault(cid, {"id": cid}).update({"validation": v})
    44	    (DOCS / "candidates.json").write_text(json.dumps(reg, indent=1, default=str) + "\n")
    45	    executed = [i for i in IDS if reg[i].get("results_artifact") and reg[i]["status"] not in (
    46	        "NOT_IMPLEMENTED", "IMPLEMENTED", "BLOCKED")]
    47	    board = {"executed": executed, "missing": [i for i in IDS if i not in executed],
    48	             "rows": [{k: reg[c].get(k) for k in FIELDS} for c in reg]}
    49	    (DOCS / "leaderboard.json").write_text(json.dumps(board, indent=1, default=str) + "\n")
    50	    print(f"{len(executed)}/24 mandatory candidates executed; missing: {board['missing']}")
    51	    for c in reg:
    52	        print(f"{c:>8} {reg[c].get('status', ''):<20} {str(reg[c].get('disposition', ''))[:90]}")
    53	
    54	
    55	if __name__ == "__main__":
    56	    main()

