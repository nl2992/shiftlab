    73	class _EnvCert:
    74	    """Gap-aware Markov-envelope started mixture (qsg.EnvelopeMixture, declared rho_bar)."""
    75	
    76	    def __init__(self, side: int, rho_bar: float = 0.8):
    77	        self.m = EnvelopeMixture(side, rho_bar)
    78	
    79	    def update(self, z: int, event_t: int, last=None) -> float:
    80	        return self.m.update_at(z, event_t)
