   135	def main(argv=None):
   136	    ap = argparse.ArgumentParser(description=__doc__)
   137	    ap.add_argument("--kind", choices=("synthetic", "real"), default="synthetic")
   138	    ap.add_argument("--regimes", required=True)
   139	    ap.add_argument("--policies", required=True)
   140	    ap.add_argument("--seeds", type=int, default=20)
   141	    ap.add_argument("--seed-base", type=int, default=DEV_SEED_BASE)
   142	    ap.add_argument("--workers", type=int, default=max(1, mp.cpu_count() - 2))
   143	    ap.add_argument("--out", required=True)
   144	    a = ap.parse_args(argv)
   145	    from registry import EXTRA, IMPORT_ERRORS
   146	
   147	    names = [x for x in a.policies.split(",") if x]
   148	    unknown = [n for n in names if n not in EXTRA and n not in (
   149	        "gated_deployment", "discern_style", "SMCS+retain-incumbent", "model_picker_adapter",
   150	        "model_selector_causal", "online_llm_picker", "xu_acquisition_only", "cams_adapter",
   151	        "variance_min_ipw", "P7s_settled", "CONTROL_never_switch", "economic_replacement")]
   152	    if unknown:
   153	        sys.exit(f"unknown policies {unknown}; import errors: {IMPORT_ERRORS}")
   154	    regimes = [x for x in a.regimes.split(",") if x]
   155	    jobs = []
   156	    for r in regimes:
   157	        if a.kind == "synthetic":
   158	            jobs += [("synthetic", r, 0, s, a.seed_base, names) for s in range(a.seeds)]
   159	        else:
   160	            K = np.load(_loss_file(r))["l0"].shape[0]
   161	            jobs += [("real", r, e, s, a.seed_base, names) for e in range(K) for s in range(a.seeds)]
   162	    out = Path(a.out)
   163	    out.mkdir(parents=True, exist_ok=True)
   164	    t0 = time.time()
   165	    with open(out / "records.jsonl", "w") as f, mp.Pool(a.workers) as pool:
   166	        for rows in pool.imap_unordered(_job, jobs, chunksize=2):
   167	            for row in rows:
   168	                f.write(json.dumps(row) + "\n")
   169	    srcs = {p.name: hashlib.sha256(p.read_bytes()).hexdigest()[:16]
   170	            for p in sorted(HERE.glob("*.py"))}
   171	    manifest = {"argv": vars(a), "contract": CONTRACT, "git": _git_rev(), "sources": srcs,
   172	                "import_errors": IMPORT_ERRORS, "n_jobs": len(jobs),
   173	                "seconds": round(time.time() - t0, 1)}
   174	    (out / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
   175	    print(f"done {len(jobs)} jobs in {time.time() - t0:.0f}s -> {out}")
