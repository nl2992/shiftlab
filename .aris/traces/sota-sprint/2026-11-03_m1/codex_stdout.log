   284	# --------------------------------------------------------------------------- path diagnostics
   285	def diagnose(regimes, policies, seeds=20, seed_base=None, out=None):
   286	    """Replay screen.py's paired streams and classify every switch against the evaluator truth.
   287	
   288	    correct_rollback: a 1->0 switch while G_t < 0; false_rollback: a 1->0 switch while G_t >= 0;
   289	    reversal_delay: events from the first sign change of G from + to - until the first 1->0 switch
   290	    after it (only when the policy was on model 1 at that change). Evaluator-side only.
   291	    """
   292	    import json
   293	
   294	    import screen
   295	    from bench import CONTRACT, DEV_SEED_BASE, parse_regime
   296	    from registry import EXTRA as REG
   297	    from suite import build_suite, stream_from_losses
   298	    from simulator import run_episode
   299	
   300	    seed_base = DEV_SEED_BASE if seed_base is None else seed_base
   301	    rows = []
   302	    for name in regimes:
   303	        R, b = parse_regime(name)
   304	        budget = b or CONTRACT["budget"]
   305	        gain = R.truth_gain()
   306	        neg = np.flatnonzero((gain[1:] < 0) & (gain[:-1] > 0)) + 1
   307	        for s in range(seeds):
   308	            losses = R.sample(np.random.default_rng(np.random.SeedSequence(
   309	                [seed_base, screen._h(R.name), s])))
   310	            for pol in build_suite(losses.shape[0], budget, CONTRACT["cs"], CONTRACT["cq"],
   311	                                   CONTRACT["alpha"], R.delay, s, seed_base + screen._h(name) % 1000,
   312	                                   names=policies, extra=REG):
   313	                preds, labels = stream_from_losses(
   314	                    losses, np.random.default_rng([seed_base, screen._h(name), 0, s, 7]))
   315	                res = run_episode(pol, model_predictions=preds, labels=labels, delay=R.delay,
   316	                                  budget=budget, label_price=CONTRACT["cq"],
   317	                                  switch_cost=CONTRACT["cs"], trace=True)
   318	                dep = np.array([r["deployed_model"] for r in res.records])
   319	                tr = np.diff(np.r_[0, dep])
   320	                down = np.flatnonzero(tr == -1)
   321	                delays = []
   322	                for c in neg:
   323	                    if dep[c - 1] == 1:
   324	                        after = down[down >= c]
   325	                        delays.append(int(after[0] - c) if len(after) else int(len(dep) - c))
   326	                rows.append({"regime": name, "seed": s, "policy": pol.name, "net": res.net_cost,
   327	                             "correct_rollbacks": int((gain[down] < 0).sum()),
   328	                             "false_rollbacks": int((gain[down] >= 0).sum()),
   329	                             "on1_at_reversal": len(delays),
   330	                             "reversal_delay_mean": float(np.mean(delays)) if delays else None})
   331	    if out:
   332	        Path(out).parent.mkdir(parents=True, exist_ok=True)
   333	        with open(out, "w") as f:
   334	            for r in rows:
   335	                f.write(json.dumps(r) + "\n")
   336	    return rows
   337	
