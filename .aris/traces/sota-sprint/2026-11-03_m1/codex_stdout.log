   339	if __name__ == "__main__":
   340	    import argparse
   341	
   342	    ap = argparse.ArgumentParser(description="family-B path diagnostics")
   343	    ap.add_argument("--regimes", required=True)
   344	    ap.add_argument("--policies", required=True)
   345	    ap.add_argument("--seeds", type=int, default=20)
   346	    ap.add_argument("--out", required=True)
   347	    a = ap.parse_args()
   348	    for p in (ROOT / "scripts/failure_atlas_v2_flq", HERE):
   349	        sys.path.insert(0, str(p))
   350	    diagnose(a.regimes.split(","), a.policies.split(","), a.seeds, out=a.out)
   351	    print("wrote", a.out)

