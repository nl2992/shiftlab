   326	    def request_labels(self, event, remaining_budget):
   327	        dis = bool(event.model_predictions[0] != event.model_predictions[1])
   328	        q = self.pacer.propensity(event.t, remaining_budget, dis)
   329	        self.pacer.note_event(dis)
   330	        if self.phase == 1:
   331	            return self.host.request_labels(event, remaining_budget)
   332	        if not dis or remaining_budget <= 0:
   333	            return QueryRequest(requested=False)
   334	        take = bool(self.rng.random() < q)
   335	        return QueryRequest(requested=take, probability=q if take else 0.0)
