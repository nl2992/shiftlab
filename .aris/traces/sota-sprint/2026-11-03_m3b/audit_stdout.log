     1	"""Mechanical audit of the sprint's mandatory execution gate (brief section 14A) from RAW records.
     2	
     3	For each of the 24 candidates it checks, from saved records under ``outputs/sota_sprint/{A,B,C,D,X}``
     4	(not from ledger prose): executed in the simulator; >= 4 diagnostic environments; paired seeds
     5	(same seed set as a published comparator in the same run); >= 1 null environment; >= 1 environment
     6	outside the intended advantage region; a mechanism ablation row (another policy whose name extends
     7	the candidate's, or a registered ablation alias); cost/efficacy/safety metrics present; and a
     8	manifest whose recorded source hash for the family module matches a committed revision.
     9	
    10	    uv run python scripts/sota_sprint/gate_audit.py
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	import hashlib
    16	import json
    17	import subprocess
    18	from collections import defaultdict
    19	from pathlib import Path
    20	
    21	ROOT = Path(__file__).resolve().parents[2]
    22	OUTS = ROOT / "outputs/sota_sprint"
    23	IDS = [f"{f}{i}" for f in "ABCD" for i in range(1, 7)]
    24	NULLS = {"F0_null", "F0_worse", "F5_dep_null_r8", "F5_dep_null_r95", "S_rare_null"}
    25	# environments outside each family's intended advantage region (declared in the family briefs)
    26	OUTSIDE = {"A": {"F1_late_800", "F1_late_1200", "F3_reversal_800", "F4_recurrent", "F2_transient"},
    27	           "B": {"F0_better", "F9_bursty_better", "F7_near_better"},
    28	           "C": {"F1_late_800", "F3_reversal_800", "F4_recurrent"},
    29	           "D": {"F3_reversal_800", "F4_recurrent"}}
    30	# ablation aliases where an ablation is not named "<id>-..." (from the family ledgers)
    31	ABLATION_ALIAS = {"B5": ["B5-reserve", "B5-rollback", "B5-deadline", "B5_no_reserve",
    32	                         "B5_no_rollback", "B5_no_deadline"],
    33	                  "A5": ["A5-fixedgap6", "A1"], "A6": ["A6-noinflight", "A5"],
    34	                  "D6": ["D1", "D6-D1params:ms"], "D5": ["D5-standin_env8", "D2"],
    35	                  "D4": ["D4-no_reserve", "D4-r10", "D1"], "D2": ["D2-host_only"],
    36	                  "C5": ["C2", "C1"], "C6": ["C6@discern"], "C3": ["QSG", "QSG-r25"],
    37	                  "C4": ["discern_design_floor+pace_tuned"], "C1": ["C1-kappa1"],
    38	                  "B1": ["B1_r10", "B1_r15", "B1_r25"],
    39	                  # single-mechanism candidates: the host without the mechanism is the ablation
    40	                  "A4": ["QSG", "A1"], "B2": ["B0_host"], "B3": ["B0_host"], "B4": ["B0_host"],
    41	                  "B6": ["B5"]}
    42	PUBLISHED = {"xu_acquisition_only", "gated_adaptive_range", "gated_adaptive_range+front",
    43	             "discern_style", "discern_design_floor", "SMCS+retain-incumbent",
    44	             "model_picker_adapter", "cams_adapter", "model_selector_causal"}
    45	
    46	
    47	def _blob_hashes(name: str) -> set[str]:
    48	    """sha256[:16] of every committed revision of scripts/sota_sprint/<name>."""
    49	    revs = subprocess.run(["git", "log", "--format=%H", "--", f"scripts/sota_sprint/{name}"],
    50	                          cwd=ROOT, capture_output=True, text=True).stdout.split()
    51	    out = set()
    52	    for r in revs:
    53	        b = subprocess.run(["git", "show", f"{r}:scripts/sota_sprint/{name}"], cwd=ROOT,
    54	                           capture_output=True).stdout
    55	        if b:
    56	            out.add(hashlib.sha256(b).hexdigest()[:16])
    57	    return out
    58	
    59	
    60	def main(roots=None):
    61	    """``roots``: {family letter: [run dirs]}; default = every run under outputs/sota_sprint/<F>/.
    62	    Records are keyed by FAMILY as well as policy name, so a candidate is credited only with runs
    63	    from its own family's directories (ARIS milestone-1 audit: names are reused across families)."""
    64	    regs = defaultdict(set)
    65	    seeds = defaultdict(lambda: defaultdict(set))
    66	    runs = defaultdict(set)
    67	    metric_ok = defaultdict(bool)
    68	    roots = roots or {f: [OUTS / f] for f in "ABCD"}
    69	    for fam, dirs in roots.items():
    70	        for rec in (x for d in dirs for x in Path(d).rglob("records.jsonl")):
    71	            run = rec.parent
    72	            with open(rec) as f:
    73	                for line in f:
    74	                    r = json.loads(line)
    75	                    p = (fam, r["policy"])
    76	                    regs[p].add(r["regime"])
    77	                    seeds[(run, r["regime"])][p].add((r["ep"], r["seed"]))
    78	                    runs[p].add(run)
    79	                    metric_ok[p] = metric_ok[p] or all(k in r for k in (
    80	                        "net", "loss", "labels", "switches", "ever_promote", "regret_expected_oracle"))
    81	    hashes = {n: _blob_hashes(n) for n in ("fam_a.py", "fam_b.py", "fam_c.py", "fam_d.py")}
    82	    report = {}
    83	    for cid in IDS:
    84	        fam = cid[0]
    85	        mine = {p[1] for p in regs if p[0] == fam}
    86	        alias = {"B1": ["B1_r15", "B1_r10", "B1_r25"], "D6": ["D6:mp", "D6:cams", "D6:ms"]}
    87	        names = [n for n in [cid] + alias.get(cid, []) if n in mine]
    88	        main_name = (fam, names[0]) if names else None
    89	        ok = {}
    90	        if main_name is None:
    91	            report[cid] = {"executed": False}
    92	            continue
    93	        rs = regs[main_name]
    94	        ok["executed"] = True
    95	        ok["n_envs"] = len(rs)
    96	        ok["envs_ge4"] = len(rs) >= 4
    97	        ok["null_env"] = bool(rs & NULLS)
    98	        ok["outside_env"] = bool(rs & OUTSIDE[fam])
    99	        abl = [n for n in mine if n != main_name[1] and (n.startswith(cid + "-") or n.startswith(cid + "_")
   100	                                                        or n in ABLATION_ALIAS.get(cid, []))]
   101	        ok["ablation_rows"] = sorted(abl)[:6]
   102	        ok["ablation"] = bool(abl)
   103	        paired = False
   104	        for (run, reg), d in seeds.items():
   105	            if main_name in d and any((fam, c) in d and d[(fam, c)] == d[main_name] for c in PUBLISHED):
   106	                paired = True
   107	                break
   108	        ok["paired_with_published"] = paired
   109	        ok["metrics"] = metric_ok[main_name]
   110	        mf_ok = []
   111	        for run in runs[main_name]:
   112	            m = run / "manifest.json"
   113	            if m.exists():
   114	                src = json.loads(m.read_text()).get("sources", {}).get(f"fam_{fam.lower()}.py")
   115	                mf_ok.append(src in hashes[f"fam_{fam.lower()}.py"] if src else None)
   116	        ok["manifest_hash_committed"] = any(mf_ok)
   117	        ok["runs"] = sorted(str(r.relative_to(ROOT)) for r in runs[main_name])
   118	        ok["PASS"] = all(ok[k] for k in ("executed", "envs_ge4", "null_env", "outside_env",
   119	                                         "ablation", "paired_with_published", "metrics",
   120	                                         "manifest_hash_committed"))
   121	        report[cid] = ok
   122	    out = ROOT / "docs/sota_sprint/gate_audit.json"
   123	    out.write_text(json.dumps(report, indent=1) + "\n")
   124	    for cid, ok in report.items():
   125	        miss = [k for k in ("executed", "envs_ge4", "null_env", "outside_env", "ablation",
   126	                            "paired_with_published", "metrics", "manifest_hash_committed")
   127	                if not ok.get(k)]
   128	        print(f"{cid}: {'PASS' if ok.get('PASS') else 'FAIL'} envs={ok.get('n_envs')} "
   129	              f"missing={miss} abl={ok.get('ablation_rows', [])[:3]}")
   130	
   131	
   132	if __name__ == "__main__":
   133	    import argparse
   134	
   135	    ap = argparse.ArgumentParser()
   136	    ap.add_argument("--root", default="", help="dir with A/ B/ C/ D/ subdirs (e.g. the gate re-screen)")
   137	    a = ap.parse_args()
   138	    main({f: [(ROOT / a.root / f).resolve()] for f in "ABCD"} if a.root else None)
===== scripts/sota_sprint/leaderboard_views.py =====
     1	"""The seven ranked leaderboard views of the sprint brief (section 12), development vs validated.
     2	
     3	Development views use the family-isolated gate re-screen (`outputs/sota_sprint/gate/<F>`, 20 seeds,
     4	dev base); each family screened its own environments, so cross-family development ranks use only the
     5	environments every family shares (F0_better, F0_null, F1_late_800, F3_reversal_800, F5_dep_null_r8).
     6	Validated views use the 100-seed / 1000-null-seed validation records. A policy counts as "safe" when
     7	its null promotion is within the bound (Wilson upper bound <= .0936 on validated nulls; on dev, at
     8	most 1/20 on every null environment, a screening proxy only).
     9	
    10	    uv run python scripts/sota_sprint/leaderboard_views.py
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	import json
    16	import math
    17	from pathlib import Path
    18	
    19	import numpy as np
    20	import pandas as pd
    21	
    22	ROOT = Path(__file__).resolve().parents[2]
    23	GATE = ROOT / "outputs/sota_sprint/gate"
    24	VAL = ROOT / "outputs/sota_sprint/validation"
    25	DOC = ROOT / "docs/sota_sprint"
    26	SHARED = ["F0_better", "F0_null", "F1_late_800", "F3_reversal_800", "F5_dep_null_r8"]
    27	DEV_NULLS = {"F0_null", "F5_dep_null_r8", "F5_dep_null_r95", "F0_worse"}
    28	IDS = [f"{f}{i}" for f in "ABCD" for i in range(1, 7)]
    29	REP = {"B1": "B1_r15", "D6": "D6:mp"}  # representative policy row for multi-setting candidates
    30	HOSTS = {"C6": ("C6", "gated_adaptive_range", "C6@discern", "discern_design_floor"),
    31	         "D6": ("D6:mp", "model_picker_adapter", "D6:cams", "cams_adapter", "D6:ms",
    32	                "model_selector_causal"),
    33	         "FLQ": ("gated_deployment+QCE+front", "gated_deployment")}
    34	CHANGE = {"F1_late_800", "F3_reversal_800", "F4_recurrent", "F2_transient", "S_reversal_400",
    35	          "S_late_1500", "S_transient_short", "F1_late_1200", "V_late_600", "V_reversal_1000",
    36	          "V_recurrent", "W_late_1000", "W_reversal_700"}
    37	
    38	
    39	def wilson_hi(k, n, z=1.96):
    40	    p = k / n
    41	    c = (p + z * z / (2 * n)) / (1 + z * z / n)
    42	    return min(1.0, c + z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / (1 + z * z / n))
    43	
    44	
    45	def _load(dirs):
    46	    fs = [d / "records.jsonl" for d in dirs if (d / "records.jsonl").exists()]
    47	    return pd.concat([pd.read_json(f, lines=True) for f in fs], ignore_index=True) if fs else None
    48	
    49	
    50	def views(df, nulls, safe_fn, label):
    51	    alts = [r for r in df.regime.unique() if r not in nulls]
    52	    g = df.groupby("policy")
    53	    out = {}
    54	    cost = df[df.regime.isin(alts)].groupby("policy").net.mean()
    55	    safe = {p: safe_fn(gg) for p, gg in df[df.regime.isin(nulls)].groupby("policy")}
    56	    out["1_lowest_total_cost"] = cost.sort_values().round(2).head(15).to_dict()
    57	    out["2_best_safe_efficacy"] = cost[[p for p in cost.index if safe.get(p)]].sort_values().round(2).head(15).to_dict()
    58	    fb = df[df.regime.isin(["F0_better", "V_better_a"])]
    59	    first = fb[fb.first_deploy >= 0].groupby("policy").first_deploy.median()
    60	    prate = fb.groupby("policy").ever_promote.mean()  # median over promoting runs only means
    61	    out["3_fastest_correct_detection_safe"] = first[[p for p in first.index if safe.get(p)
    62	                                                     and prate[p] >= 0.5]].sort_values().head(15).to_dict()
    63	    ch = df[df.regime.isin(CHANGE)]
    64	    out["4_lowest_dynamic_regret"] = ch.groupby("policy").regret_expected_oracle.mean().sort_values().round(2).head(15).to_dict()
    65	    # 5: labels used per unit of correct-decision value, among safe policies promoting on >= 80% of
    66	    # the clear-advantage streams (matched decision quality)
    67	    pr = fb.groupby("policy").ever_promote.mean()
    68	    lab = fb.groupby("policy").labels.mean()
    69	    q = [p for p in pr.index if pr[p] >= 0.8 and safe.get(p)]
    70	    out["5_best_label_efficiency_matched_quality"] = lab[q].sort_values().round(1).head(15).to_dict()
    71	    # 6: transferable improvement: mean (candidate - native host) over hosts, all regimes (nulls too)
    72	    tr = {}
    73	    piv = df.pivot_table(index=["regime", "ep", "seed"], columns="policy", values="net")
    74	    for k, pairs in HOSTS.items():
    75	        ds = [float((piv[a] - piv[b]).mean()) for a, b in zip(pairs[::2], pairs[1::2])
    76	              if a in piv and b in piv]
    77	        if ds:
    78	            tr[k] = {"mean_over_hosts": round(float(np.mean(ds)), 2), "per_host": [round(d, 2) for d in ds],
    79	                     "n_hosts": len(ds)}
    80	    out["6_largest_transferable_improvement"] = tr
    81	    # 7: overall research candidate: safe first, then cost; only sprint candidates
    82	    cands = [p for p in cost.index if p[:2] in IDS or p.startswith(("A5b", "A1b", "X_", "B1_r"))]
    83	    out["7_best_overall_research_candidate"] = sorted(
    84	        [{"policy": p, "safe": bool(safe.get(p)), "alt_cost": round(float(cost[p]), 2)} for p in cands],
    85	        key=lambda d: (not d["safe"], d["alt_cost"]))[:15]
    86	    out["_basis"] = label
    87	    return out
    88	
    89	
    90	def main():
    91	    res = {}
    92	    dev = _load([GATE / f for f in "ABCD"])
    93	    if dev is not None:
    94	        shared = dev[dev.regime.isin(SHARED)].drop_duplicates(["regime", "ep", "seed", "policy"])
    95	        res["development"] = views(shared, DEV_NULLS,
    96	                                   lambda g: g.groupby("regime").ever_promote.sum().max() <= 1,
    97	                                   "gate re-screen, 20 dev seeds, shared environments " + ",".join(SHARED))
    98	    syn = _load([VAL / n for n in ("synth", "synth_b5", "synth_qce")])
    99	    nul = _load([VAL / n for n in ("null1000", "null1000_b5", "null1000_qce")])
   100	    if syn is not None and nul is not None:
   101	        nn = set(nul.regime.unique())
   102	        safe_val = {p: all(wilson_hi(int(g2.ever_promote.sum()), len(g2)) <= 0.0936
   103	                           for _, g2 in g.groupby("regime")) for p, g in nul.groupby("policy")}
   104	        syn = syn.drop_duplicates(["regime", "ep", "seed", "policy"])
   105	        res["validated"] = views(syn, nn, lambda g: safe_val.get(g.policy.iloc[0], False),
   106	                                 "validation: 100 fresh seeds; safety = Wilson ub on 1000-seed in-class nulls")
   107	    (DOC / "leaderboard_views.json").write_text(json.dumps(res, indent=1, default=float) + "\n")
   108	    L = ["# Leaderboard: ranked views (brief section 12)", ""]
   109	    for stage, v in res.items():
   110	        L += [f"## {stage} ({v['_basis']})", ""]
   111	        for k, d in v.items():
   112	            if k.startswith("_"):
   113	                continue
   114	            L.append(f"**{k}**: " + (", ".join(f"{p} {x}" for p, x in d.items()) if isinstance(d, dict)
   115	                                     else ", ".join(f"{e['policy']} ({'safe' if e['safe'] else 'unsafe'}, {e['alt_cost']})" for e in d)))
   116	            L.append("")
   117	    (DOC / "leaderboard_views.md").write_text("\n".join(L) + "\n")
   118	    print("\n".join(L)[:4000])
   119	
   120	
   121	if __name__ == "__main__":
   122	    main()

