    71	
    72	HOST_LAMBDAS = (0.15, 0.3, 0.5)
    73	WIDE_LAMBDAS = (0.1, 0.2, 0.35, 0.5, 0.7)
    74	G_REF = 0.1  # registered upper reference for |G_t| per event (dis .2 * |2p-1| <= .1 in the atlas)
