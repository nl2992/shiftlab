    38	# Phase 7 cross-family combinations (lead, 2026-11-03, after the 24-candidate screen). Parameters are
    39	# the families' registered/dev-tuned values; nothing below was tuned.
    40	# ------------------------------------------------------------------------------------------------
    41	import fam_a  # noqa: E402
    42	import fam_d  # noqa: E402
    43	from simulator import QueryRequest  # noqa: E402
    44	
    45	
    46	def _a5b(name, reserve=0.0, **kw):
    47	    def f(T, B, cs, cq, a, d, r):
    48	        pol = fam_a.FamA(T, B, a, rng=r("QSG"), name=name, evidence="sui", density="adaptive",
    49	                         rho_sig=2.0, sui_kw=fam_a._B, **kw)
    50	        pol.reserve = int(round(reserve * B))  # QSG semantics: kept back from front-loading
    51	        return pol
    52	    return f
    53	
    54	
    55	class _SaveAfterDiscard(fam_a.FamA):
    56	    """A5b + economic acquisition (C-family finding): no post-verdict labels after a DISCARD
    57	    verdict (the incumbent is kept and only a late improvement could use them); monitoring after a
    58	    promotion is kept for rollback. Acquisition only: validity is A5b's."""
    59	
    60	    def request_labels(self, event, remaining_budget):
    61	        if self.decided and self.deployed == 0:
    62	            self.acq.note_event(bool(event.model_predictions[0] != event.model_predictions[1]))
    63	            return QueryRequest(requested=False)
    64	        return super().request_labels(event, remaining_budget)
    65	
    66	
    67	def _a1b_cert(side):
    68	    return fam_d._A1Cert(side, fam_a.MarkovSUI, **fam_a._B)
    69	
    70	
    71	def _gate(kind, name, **kw):
    72	    return lambda T, B, cs, cq, a, d, r: fam_d.DeployGate(fam_d.make_host(kind, r), T, B, a,
    73	                                                          rng=r("D_gate"), name=name, **kw)
    74	
    75	
    76	EXTRA.update({
    77	    # A5 + B5: dependence-valid evidence + monitoring reserve (B's .15) + rollback (QSG's)
    78	    "X_A5B5": _a5b("X_A5B5", reserve=0.15),
    79	    # A6 + B5 (+ C5 components are acquisition-only and did not replicate; see ledger)
    80	    "X_A6B5": _a5b("X_A6B5", reserve=0.15, dualclock=True, inflight=True),
    81	    # A5 + C (label saving after a discard verdict)
    82	    "X_A5C": lambda T, B, cs, cq, a, d, r: _SaveAfterDiscard(
    83	        T, B, a, rng=r("QSG"), name="X_A5C", evidence="sui", density="adaptive", rho_sig=2.0,
    84	        sui_kw=fam_a._B),
    85	    # D4 + A1: certified fast selection under dependence (Model Picker host, A1b evidence)
    86	    "X_D4A1": _gate("mp", "X_D4A1", cert=_a1b_cert, rollback=True, reserve=0.10),
    87	    # D6 + A1: the shared wrapper with dependence-valid evidence, on two independent hosts
    88	    "X_D6A1:mp": _gate("mp", "X_D6A1:mp", cert=_a1b_cert),
    89	    "X_D6A1:cams": _gate("cams", "X_D6A1:cams", cert=_a1b_cert),
    90	})

