    77	class GridMixtureDetector:
    78	    """Weighted mixture of restart-grid SR e-detectors; total prior mass one.
    79	
    80	    ``components`` = [(weight, gap, n_starts)]: component c opens a product with prior mass
    81	    weight_c / n_starts_c before every gap_c-th label (the first n_starts_c of them). Each product
    82	    is a nonnegative supermartingale under the conditional null E[X | past] <= 0 for any bet in
    83	    [0, 1), so stat + (mass of starts not yet opened) is a nonnegative supermartingale started at
    84	    one, and Ville gives P(sup stat >= 1/alpha) <= alpha. With one component (1, 10, ceil(B/10))
    85	    and the host bets this is exactly the host's MixtureSRDetector.
    86	    """
    87	
    88	    def __init__(self, alpha: float, components, lambdas=HOST_LAMBDAS):
    89	        self.alpha = float(alpha)
    90	        tot = sum(w for w, _, _ in components)
    91	        self.comps = [(w / tot, int(g), max(1, int(n))) for w, g, n in components]
    92	        self.lams = np.asarray(lambdas, float)
    93	        self.sr = np.zeros((len(self.comps), len(self.lams)))
    94	        self.n = 0
    95	
    96	    def update(self, x: int) -> bool:
    97	        for i, (w, g, ns) in enumerate(self.comps):
    98	            if self.n % g == 0 and self.n // g < ns:
    99	                self.sr[i] += w / ns
   100	        self.sr *= 1.0 + self.lams * x
   101	        self.n += 1
   102	        return self.stat >= 1.0 / self.alpha
   103	
   104	    @property
   105	    def stat(self) -> float:
   106	        return float(self.sr.mean(axis=1).sum())
   107	
   108	    def max_reachable(self, k: int) -> float:
   109	        """Upper bound on stat after k more labels (every bet wins, every unopened start opens)."""
   110	        if k <= 0:
   111	            return self.stat
   112	        unopened = sum(w * (ns - min(ns, -(-self.n // g))) / ns for w, g, ns in self.comps)
   113	        grow = (1.0 + self.lams) ** k
   114	        return float(((self.sr.sum(axis=0) + unopened) * grow).mean())
   115	
   116	
   117	def host_detector(alpha, max_labels, gap=10):
   118	    return GridMixtureDetector(alpha, [(1.0, gap, math.ceil(max_labels / gap))], HOST_LAMBDAS)
   119	
   120	
   121	def multiscale_detector(alpha, max_labels):
   122	    return GridMixtureDetector(alpha, [(0.3, max_labels + 1, 1),
   123	                                       (0.35, 25, math.ceil(max_labels / 25)),
   124	                                       (0.35, 5, math.ceil(max_labels / 5))], WIDE_LAMBDAS)
