    74	        P = g.pivot_table(index="seed", columns="policy", values="net")
    75	        harm[r] = (P.sub(P["CONTROL_never_switch"], axis=0)).mean().round(3).to_dict()
    76	    piv = {r: g.pivot_table(index="seed", columns="policy", values="net")
    77	           for r, g in syn.groupby("regime")}
    78	    res = {"null_safety": {}, "regimes": {}, "H1": {}, "H2": {}, "H3": {}}
    79	
    80	    # null safety, 1000 seeds
    81	    for (r, p), g in nul.groupby(["regime", "policy"]):
    82	        k, n = int(g.ever_promote.sum()), len(g)
    83	        lo, hi = wilson(k, n)
    84	        res["null_safety"].setdefault(p, {})[r] = {"k": k, "n": n, "rate": k / n,
