   145	        for m in (0, 1):
   146	            best, arg = INF, m
   147	            for n in (0, 1):
   148	                v = (cs if n != m else 0.0) + (-gain[t] if n == 1 else 0.0) + val[t + 1, n]
   149	                if v < best - 1e-12:
   150	                    best, arg = v, n
   151	            val[t, m], choice[t, m] = best, arg
   152	    path = np.empty(T_, dtype=int)
   153	    m = 0
   154	    for t in range(T_):
   155	        m = choice[t, m]

