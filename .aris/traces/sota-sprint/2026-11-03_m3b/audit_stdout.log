    42	def wilson(k, n, z=1.96):
    43	    p = k / n
    44	    c = (p + z * z / (2 * n)) / (1 + z * z / n)
    45	    h = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / (1 + z * z / n)
    46	    return max(0.0, c - h), min(1.0, c + h)
    47	
    48	
    49	def diff(piv, a, b):
    50	    d = (piv[a] - piv[b]).dropna().to_numpy()
    51	    se = d.std(ddof=1) / np.sqrt(len(d))
    52	    t = d.mean() / se if se > 0 else 0.0
    53	    return {"vs": b, "mean": round(float(d.mean()), 2), "lo": round(float(d.mean() - 1.96 * se), 2),
    54	            "hi": round(float(d.mean() + 1.96 * se), 2), "n": len(d),
    55	            "p_one_sided_less": float(stats.t.cdf(t, len(d) - 1)),
    56	            "frac_better": round(float((d < 0).mean()), 3)}
    57	
    58	
    59	def holm(ps):
    60	    order = np.argsort(ps)
    61	    adj = np.empty(len(ps))
    62	    run = 0.0
    63	    for i, j in enumerate(order):
    64	        run = max(run, min(1.0, (len(ps) - i) * ps[j]))
    65	        adj[j] = run
    66	    return adj
