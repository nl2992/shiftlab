     1	"""SOTA sprint validation registry. Registered 2026-11-03 while family screening was running and
     2	BEFORE any candidate was selected or any validation row existed.
     3	
     4	Seeds: VAL_SEED_BASE (never used before) with 100 paired seeds per regime; null-safety checks on
     5	NULL_SEEDS seeds at NULL_SEED_BASE. Regimes: the Atlas v2 V_* instances (previously run only with
     6	seed base 2026110399, so these streams are fresh) plus new W_* instances below, whose parameters
     7	differ from every development regime. Primary metric: paired Delta J vs the strongest applicable
     8	published comparator chosen per regime on the same seeds; Holm correction over the regimes a claim
     9	covers. A certified claim additionally requires promotion <= NULL_PROMOTION_BOUND on every null
    10	regime here with the NULL_SEEDS check, and the Wilson 95% upper bound reported.
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	from bench import SPRINT_REGIMES, _r
    16	
    17	VAL_SEED_BASE = 2026110601
    18	NULL_SEED_BASE = 2026110602
    19	VAL_SEEDS = 100
    20	NULL_SEEDS = 1000
    21	
    22	NEW = {r.name: r for r in [
    23	    _r("W_better_dep_r7", "dependence", [(0, 0.66)], dis=((0, 0.22),), rho=0.7, tags=("alt", "dep")),
    24	    _r("W_better_dep_r9", "dependence", [(0, 0.68)], dis=((0, 0.2),), rho=0.9, tags=("alt", "dep")),
    25	    _r("W_null_dep_r9", "dependence", [(0, 0.5)], dis=((0, 0.22),), rho=0.9, tags=("null", "dep")),
    26	    _r("W_null_dep_r95", "dependence", [(0, 0.5)], dis=((0, 0.25),), rho=0.95, tags=("null", "dep")),
    27	    _r("W_worse_dep_r8", "dependence", [(0, 0.42)], dis=((0, 0.2),), rho=0.8, tags=("null", "dep")),
    28	    _r("W_late_1000", "late", [(0, 0.42), (1000, 0.72)], dis=((0, 0.22),), tags=("alt", "change")),
    29	    _r("W_reversal_700", "reversal", [(0, 0.68), (700, 0.32)], tags=("change",)),
    30	    _r("W_delay600_better", "delay", [(0, 0.64)], delay=600, tags=("alt",)),
    31	]}
    32	SPRINT_REGIMES.update(NEW)
