    96	def stream_from_losses(losses: np.ndarray, rng) -> tuple[np.ndarray, np.ndarray]:
    97	    """Balanced labels with predictions = label XOR loss: reproduces the loss stream exactly."""
    98	    labels = rng.integers(0, 2, losses.shape[0])
    99	    preds = labels[:, None].astype(int) ^ losses.astype(int)
   100	    return preds, labels
   101	
   102	
   103	def run_metrics(pol, losses, gain, *, delay, budget, cq, cs, stream_rng, oracle_cost=None,
   104	                exp_path=None) -> dict:
   105	    preds, labels = stream_from_losses(losses, stream_rng)
   106	    res = run_episode(pol, model_predictions=preds, labels=labels, delay=delay, budget=budget,
   107	                      label_price=cq, switch_cost=cs, trace=True)
   108	    if res.requested_labels > budget:
   109	        raise AssertionError(f"{pol.name} exceeded budget")
   110	    dep = np.fromiter((r["deployed_model"] for r in res.records), int, len(res.records))
   111	    req = np.fromiter((r["requested"] for r in res.records), int, len(res.records))
   112	    Tn = len(dep)
   113	    req_t = np.flatnonzero(req)
   114	    first1 = int(np.argmax(dep == 1)) if (dep == 1).any() else -1
   115	    better = gain > 0
   116	    worse = gain < 0
   117	    on_wrong = ((dep == 1) & worse) | ((dep == 0) & better)
   118	    m = {
   119	        "net": res.net_cost, "loss": res.prediction_loss, "labels": res.requested_labels,
   120	        "switches": res.deployment_switches, "first_deploy": first1, "final": int(dep[-1]),
   121	        "ever_promote": int(first1 >= 0),
   122	        "frac_on_better_when_better": float((dep[better] == 1).mean()) if better.any() else np.nan,
   123	        "frac_on_wrong": float(on_wrong.mean()),
   124	        "label_mean_t": float(req_t.mean()) if len(req_t) else np.nan,
   125	        "labels_by_500": int((req_t < 500).sum()),
   126	        "labels_after_1000": int((req_t >= 1000).sum()),
   127	        "exhaust_t": int(req_t[budget - 1]) if len(req_t) >= budget else Tn,
