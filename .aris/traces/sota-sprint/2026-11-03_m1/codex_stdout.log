   296	# =============================================================================== C3 on QSG
   297	class QSGTwoStage(QSG):
   298	    """C3: QSG with a concentrated first phase (q = 1 on disagreements while undecided, at most
   299	    ``f*B`` labels and only before ``tau*T``) and a protected monitoring phase that paces the
   300	    remainder uniformly over the rest of the horizon (verdict or not). QSG ingests queried
   301	    outcomes with weight one, so any predictable q is valid (QCE null)."""
   302	
   303	    def __init__(self, T, B, alpha, *, rng, f=0.75, tau=1.0, name="C3"):
   304	        super().__init__(T, B, alpha, rng=rng, reserve=1.0 - f, name=name)
   305	        self.f, self.tau = f, tau
   306	
   307	    def request_labels(self, event, remaining_budget):
   308	        dis = bool(event.model_predictions[0] != event.model_predictions[1])
   309	        q = self.acq.propensity(event.t, remaining_budget, dis)
   310	        self.acq.note_event(dis)
   311	        if not dis or remaining_budget <= 0:
   312	            return QueryRequest(requested=False)
   313	        spent = self.B - remaining_budget
   314	        if (not self.decided and spent < self.f * self.B and event.t < self.tau * self.T):
   315	            q = 1.0
   316	        take = bool(self.rng.random() < q)
   317	        return QueryRequest(requested=take, probability=q if take else 0.0)
