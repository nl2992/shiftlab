   142	class RecoveryMonitor(RestartMixtureMonitor):
   143	    def __init__(self, make_base, horizon, budget, alpha, *, rng, name="", delay=100, cs=5.0,
   144	                 reserve=0.0, rollback=False, multiscale=False, deadline=False,
   145	                 alpha_rb_new=0.10, g_ref=G_REF):
   146	        self.reserve_n = int(math.ceil(reserve * budget))
   147	        self.rollback_on, self.multiscale, self.deadline = bool(rollback), bool(multiscale), bool(deadline)
   148	        self.alpha_rb_new = float(alpha_rb_new)
   149	        self.h_min = int(math.ceil(cs / g_ref))
   150	        self.delay = int(delay)
   151	        self.decided = False
   152	        self.n_rollbacks = 0
   153	        self.n_vetoed = 0
   154	        self.n_skipped_potential = 0
   155	        self._remaining_hint = int(budget)
   156	        super().__init__(make_base, horizon, budget, alpha, rng=rng, name=name)
   157	        self.t_dead = self.T - self.delay - self.h_min
   158	        if self.deadline:
   159	            self.acq = DeadlinePacer(horizon, budget, self.t_dead, p_min=0.05)
   160	
   161	    # -- detectors
   162	    def _new_detector(self):
   163	        if self.deployed == 0:
   164	            a = self.alpha_det / (2.0 ** self.n_promotions)
   165	            m = self.B
   166	        else:
   167	            a = self.alpha_rb_new if self.rollback_on else self.alpha_rb
   168	            m = max(int(self._remaining_hint), 20) if self.rollback_on else self.B
   169	        return multiscale_detector(a, m) if self.multiscale else host_detector(a, m, self.gap)
   170	
   171	    # -- budget view
   172	    def _effective(self, t, remaining):
   173	        eff = remaining
   174	        if self.reserve_n and not self.decided:
   175	            eff = max(0, remaining - self.reserve_n)
   176	        if self.deadline and t >= self.t_dead:
   177	            eff = 0
   178	        return eff
   179	
   180	    def _mark_decided(self):
   181	        if not self.decided and (self.deployed == 1 or self.n_alarms > 0
   182	                                 or getattr(self.base, "stopped", False)):
   183	            self.decided = True
   184	
   185	    # -- Policy protocol
   186	    def predict(self, event: Event) -> int:
   187	        self.t = event.t
   188	        k = self.view.model(int(self.base.predict(self.view.event(event))))
   189	        if k != self.deployed:  # the base switched under its own CS
   190	            if self.rollback_on:  # B2 alpha accounting counts base switches too (host does not)
   191	                if k == 1:
   192	                    self.n_promotions += 1
   193	                else:
   194	                    self.n_rollbacks += 1
