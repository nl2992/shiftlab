     1	"""SOTA sprint frozen benchmark specification (Agent E). Registered 2026-11-03 before any sprint run.
     2	
     3	Contract: T=2000, B=200, c_q=.05, c_s=5, alpha=.05, common simulator, paired streams.
     4	Development screening uses seed base DEV_SEED_BASE (never used before). Validation seeds and the
     5	validation regime set are registered separately, after screening and before any validation run.
     6	
     7	Regimes: the locked Atlas v2 FLQ discovery registry (F0-F9) plus sprint additions below, which
     8	target conditions the earlier atlas covered thinly (strong dependence under an alternative, very
     9	long delay, very late change, short transient, early reversal, rare-observation null). A regime
    10	name may carry ``@B<budget>`` to run that regime at another hard budget (budget-tightness axis).
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	import sys
    16	from pathlib import Path
    17	
    18	ROOT = Path(__file__).resolve().parents[2]
    19	FLQ = ROOT / "scripts/failure_atlas_v2_flq"
    20	if str(FLQ) not in sys.path:
    21	    sys.path.insert(0, str(FLQ))
    22	
    23	from regimes import ALL_REGIMES, Regime, _r  # noqa: E402
    24	
    25	CONTRACT = dict(T=2000, budget=200, cq=0.05, cs=5.0, alpha=0.05)
    26	DEV_SEED_BASE = 2026110501
    27	DEV_SEEDS = 20
    28	# Registered null-safety bound: Wilson-style upper tolerance used in Atlas v2 Amendment 2 for 100
    29	# seeds at nominal .05. Point estimates on 20 dev seeds are screening diagnostics only.
    30	NULL_PROMOTION_BOUND = 0.0936
    31	
    32	SPRINT_ADDITIONS: dict[str, Regime] = {r.name: r for r in [
    33	    _r("S_dep_better_r95", "dependence", [(0, 0.65)], rho=0.95, tags=("alt", "dep")),
    34	    _r("S_dep_better_r8_d25", "dependence", [(0, 0.65)], dis=((0, 0.25),), rho=0.8,
    35	       tags=("alt", "dep")),
    36	    _r("S_delay800_better", "delay", [(0, 0.65)], delay=800, tags=("alt",)),
    37	    _r("S_late_1500", "late", [(0, 0.4), (1500, 0.75)], tags=("alt", "change")),
    38	    _r("S_transient_short", "transient", [(0, 0.45), (600, 0.75), (900, 0.45)],
    39	       tags=("change",)),
    40	    _r("S_reversal_400", "reversal", [(0, 0.7), (400, 0.3)], tags=("change",)),
    41	    _r("S_rare_null", "rare", [(0, 0.5)], dis=((0, 0.03),), tags=("null",)),
    42	]}
    43	
    44	SPRINT_REGIMES: dict[str, Regime] = {**ALL_REGIMES, **SPRINT_ADDITIONS}
