    94	def _job(args):
    95	    kind, name, ep, seed, seed_base, names = args
    96	    from registry import EXTRA
    97	
    98	    if kind == "synthetic":
    99	        R, b = parse_regime(name)
   100	        budget = b or CONTRACT["budget"]
   101	        losses = R.sample(np.random.default_rng(np.random.SeedSequence(
   102	            [seed_base, _h(R.name), seed])))
   103	        gain, delay = R.truth_gain(), R.delay
   104	    else:
   105	        z = np.load(_loss_file(name))
   106	        losses = np.stack([z["l0"][ep], z["l1"][ep]], axis=1).astype(np.int8)
   107	        # PROXY (ARIS milestone-1 audit, check A): real data has no causal truth, so the evaluator-side
   108	        # gain is the episode's realised mean advantage. Only the diagnostics regret_expected_oracle,
   109	        # frac_on_wrong, detect_delay and excess_vs_expected_G use it; the primary metric `net` does not.
   110	        gain = np.full(losses.shape[0], float((losses[:, 0].astype(int) - losses[:, 1]).mean()))
   111	        delay, budget = {**REAL_DELAYS, **FRESH_DELAYS}[name], CONTRACT["budget"]
   112	    rows = []
   113	    run_ep = ep * 100_000 + seed
   114	    for pol in build_suite(losses.shape[0], budget, CONTRACT["cs"], CONTRACT["cq"],
   115	                           CONTRACT["alpha"], delay, run_ep, seed_base + _h(name) % 1000,
   116	                           names=names, extra=EXTRA):
   117	        stream_rng = np.random.default_rng([seed_base, _h(name), ep, seed, 7])
   118	        m = metrics(pol, losses, gain, delay=delay, budget=budget, cq=CONTRACT["cq"],
   119	                    cs=CONTRACT["cs"], stream_rng=stream_rng)
   120	        rows.append({"kind": kind, "gain_is_proxy": kind == "real", "regime": name, "ep": ep,
   121	                     "seed": seed, "policy": pol.name,
   122	                     "delay": delay, "budget": budget, **m})
   123	    return rows
