    61	# Pluggable certificates: update(z, event_t) -> current e-value for one side.
    62	# ------------------------------------------------------------------------------------------------
    63	class _Cert:
    64	    """Started mixture (QSG) e-process; ``side=+1`` tests H+: p<=1/2, ``-1`` tests H-: p>=1/2."""
    65	
    66	    def __init__(self, side: int):
    67	        self.m = StartedMixture(side)
    68	
    69	    def update(self, z: int, event_t: int, last=None) -> float:
    70	        return self.m.update(z)
