--- scripts/sota_sprint/registry.py ---
     1	"""Policy registry for the SOTA sprint: published ports, earlier ShiftLab candidates, family modules.
     2	
     3	Every factory has the Atlas v2 signature ``f(T, B, cs, cq, alpha, delay, r) -> Policy`` where
     4	``r(name)`` returns a private generator. Family modules ``fam_a`` .. ``fam_d`` (one per agent)
     5	each expose ``EXTRA``; a family module that fails to import is reported, not silently dropped.
     6	"""
     7	
     8	from __future__ import annotations
     9	
    10	import importlib
    11	import importlib.util
    12	import sys
    13	from pathlib import Path
    14	
    15	HERE = Path(__file__).resolve().parent
    16	ROOT = HERE.parents[1]
    17	for _p in (ROOT / "scripts/failure_atlas_v2_flq", HERE):
    18	    if str(_p) not in sys.path:
    19	        sys.path.insert(0, str(_p))
    20	
    21	import bench  # noqa: E402,F401  (pins the FLQ regimes module before the RMM path is added)
    22	from v2_extra import EXTRA as _FLQ  # noqa: E402
    23	
    24	IMPORT_ERRORS: dict[str, str] = {}
    25	
    26	
    27	def _rmm() -> dict:
    28	    """Load the RMM/LRMD line under a private module name (its directory reuses FLQ file names)."""
    29	    path = ROOT / "scripts/failure_atlas_v2/restart_monitor.py"
    30	    spec = importlib.util.spec_from_file_location("atlas_v2_restart_monitor", path)
    31	    mod = importlib.util.module_from_spec(spec)
    32	    sys.modules[spec.name] = mod
    33	    saved = list(sys.path)
    34	    try:
    35	        spec.loader.exec_module(mod)
    36	    finally:  # RMM prepends its own directory, whose regimes.py/suite.py would shadow FLQ's
    37	        sys.path[:] = saved  # (spawned workers inherit the parent's sys.path)
    38	    keep = ("gated_deployment+RMM", "discern_style+RMM", "SMCS+retain-incumbent+RMM",
    39	            "model_picker_adapter+RMM", "LRMD")
    40	    return {f"rmm:{k}": v for k, v in mod.FACTORIES.items() if k in keep}
    41	
    42	
    43	def build_extra() -> dict:
    44	    extra = dict(_FLQ)
    45	    try:
    46	        extra.update(_rmm())
    47	    except Exception as e:  # pragma: no cover - reported in manifests
    48	        IMPORT_ERRORS["rmm"] = repr(e)
    49	    for fam in ("fam_a", "fam_b", "fam_c", "fam_d", "fam_x"):
    50	        if not (HERE / f"{fam}.py").exists():
    51	            continue
    52	        try:
    53	            extra.update(importlib.import_module(fam).EXTRA)
    54	        except Exception as e:
    55	            IMPORT_ERRORS[fam] = repr(e)
    56	    return extra
    57	
    58	
    59	EXTRA = build_extra()

--- scripts/sota_sprint/screen.py ---
     1	"""SOTA sprint screening runner: paired synthetic (or cached real) streams x chosen policies.
     2	
     3	Synthetic seed ``s`` of regime ``R`` draws one loss stream from
     4	``SeedSequence([seed_base, sha(R_base), s])``; every policy replays that stream with its own
     5	private generator, so all comparisons are paired. A ``@B<n>`` regime suffix changes the hard budget.
     6	
     7	    uv run python scripts/sota_sprint/screen.py --regimes F0_better,F0_null \
     8	        --policies QSG,xu_acquisition_only --seeds 20 --out outputs/sota_sprint/screen/demo
     9	"""
    10	
    11	from __future__ import annotations
    12	
    13	import argparse
    14	import hashlib
    15	import json
    16	import multiprocessing as mp
    17	import subprocess
    18	import sys
    19	import time
    20	from pathlib import Path
    21	
    22	import numpy as np
    23	
    24	HERE = Path(__file__).resolve().parent
    25	ROOT = HERE.parents[1]
    26	for _p in (ROOT / "scripts/failure_atlas_v2_flq", HERE):
    27	    if str(_p) not in sys.path:
    28	        sys.path.insert(0, str(_p))
    29	
    30	from bench import CONTRACT, DEV_SEED_BASE, parse_regime  # noqa: E402
    31	import validation_spec  # noqa: E402,F401  (registers the W_* validation regimes)
    32	import ooc_regimes  # noqa: E402,F401  (registers the out-of-class nulls, Amendment 2)
    33	from regimes import expected_oracle_path, hindsight_oracle_cost  # noqa: E402
    34	from suite import build_suite, stream_from_losses  # noqa: E402  (also adds the simulator path)
    35	from simulator import run_episode  # noqa: E402
    36	
    37	LOSS_DIR = ROOT / "data/atlas_v2_losses"
    38	FRESH_DIR = ROOT / "data/sprint_fresh_losses"  # fresh external-validation streams (aeb2d4f)
    39	FRESH_DELAYS = {"metro": 24, "beijing_pm25": 24, "bike_hour": 24, "appliances": 144,
    40	                "household_power": 144}  # = fresh_real.DELAYS, registered before any policy run
    41	
    42	
    43	def _loss_file(name: str) -> Path:
    44	    return (FRESH_DIR if name in FRESH_DELAYS else LOSS_DIR) / f"{name}.npz"
    45	REAL_DELAYS = {"rialto": 100, "spam": 50, "weather": 1, "openml_ldpa": 100, "uci_occupancy": 100,
    46	               "airlines": 100, "bank": 100, "elec2": 48, "criteo": 100}
    47	
    48	
    49	def _h(s: str) -> int:
    50	    return int.from_bytes(hashlib.sha256(s.encode()).digest()[:4], "big")
    51	
    52	
    53	def metrics(pol, losses, gain, *, delay, budget, cq, cs, stream_rng) -> dict:
    54	    preds, labels = stream_from_losses(losses, stream_rng)
    55	    t0 = time.perf_counter()
    56	    res = run_episode(pol, model_predictions=preds, labels=labels, delay=delay, budget=budget,
    57	                      label_price=cq, switch_cost=cs, trace=True)
    58	    runtime = time.perf_counter() - t0
    59	    if res.requested_labels > budget:
    60	        raise AssertionError(f"{pol.name} exceeded budget")
    61	    rec = res.records
    62	    dep = np.fromiter((r["deployed_model"] for r in rec), int, len(rec))
    63	    req = np.fromiter((r["requested"] for r in rec), int, len(rec))
    64	    Tn = len(dep)
    65	    req_t = np.flatnonzero(req)
    66	    first1 = int(np.argmax(dep == 1)) if (dep == 1).any() else -1
    67	    better, worse = gain > 0, gain < 0
    68	    on_wrong = ((dep == 1) & worse) | ((dep == 0) & better)
    69	    trans = np.diff(np.r_[0, dep])
    70	    pending = np.convolve(req, np.ones(max(delay, 1), int))[:Tn]  # requested, not yet released
    71	    onset = int(np.argmax(better)) if better.any() else -1
    72	    after = np.flatnonzero((dep == 1) & (np.arange(Tn) >= onset)) if onset >= 0 else []
    73	    exp_path = expected_oracle_path(gain, cs)
    74	    exp_cost = float(np.sum(losses[np.arange(Tn), exp_path])
    75	                     + cs * np.sum(np.diff(np.r_[0, exp_path]) != 0))
    76	    return {
    77	        "net": res.net_cost, "loss": res.prediction_loss, "labels": res.requested_labels,
    78	        "switches": res.deployment_switches, "first_deploy": first1, "final": int(dep[-1]),
    79	        "ever_promote": int(first1 >= 0), "n_promotions": int((trans == 1).sum()),
    80	        "n_rollbacks": int((trans == -1).sum()),
    81	        "frac_on_wrong": float(on_wrong.mean()),
    82	        "detect_delay": int(after[0] - onset) if len(after) else -1,
    83	        "labels_by_500": int((req_t < 500).sum()),
    84	        "labels_after_1000": int((req_t >= 1000).sum()),
    85	        "exhaust_t": int(req_t[budget - 1]) if len(req_t) >= budget else Tn,
    86	        "max_pending": int(pending.max()) if Tn else 0,
    87	        "excess_vs_expected_G": float(np.sum(np.where(dep == 1, -gain, 0.0))),
    88	        "regret_hindsight": res.net_cost - hindsight_oracle_cost(losses, cs),
    89	        "regret_expected_oracle": res.net_cost - exp_cost,
    90	        "runtime_s": round(runtime, 4),
    91	    }
    92	
    93	
    94	def _job(args):
    95	    kind, name, ep, seed, seed_base, names = args
    96	    from registry import EXTRA
    97	
    98	    if kind == "synthetic":
    99	        R, b = parse_regime(name)
   100	        budget = b or CONTRACT["budget"]
   101	        losses = R.sample(np.random.default_rng(np.random.SeedSequence(
   102	            [seed_base, _h(R.name), seed])))
   103	        gain, delay = R.truth_gain(), R.delay
   104	    else:
   105	        z = np.load(_loss_file(name))
   106	        losses = np.stack([z["l0"][ep], z["l1"][ep]], axis=1).astype(np.int8)
   107	        gain = np.full(losses.shape[0], float((losses[:, 0].astype(int) - losses[:, 1]).mean()))
   108	        delay, budget = {**REAL_DELAYS, **FRESH_DELAYS}[name], CONTRACT["budget"]
   109	    rows = []
   110	    run_ep = ep * 100_000 + seed
   111	    for pol in build_suite(losses.shape[0], budget, CONTRACT["cs"], CONTRACT["cq"],
   112	                           CONTRACT["alpha"], delay, run_ep, seed_base + _h(name) % 1000,
   113	                           names=names, extra=EXTRA):
   114	        stream_rng = np.random.default_rng([seed_base, _h(name), ep, seed, 7])
   115	        m = metrics(pol, losses, gain, delay=delay, budget=budget, cq=CONTRACT["cq"],
   116	                    cs=CONTRACT["cs"], stream_rng=stream_rng)
   117	        rows.append({"kind": kind, "regime": name, "ep": ep, "seed": seed, "policy": pol.name,
   118	                     "delay": delay, "budget": budget, **m})
   119	    return rows
   120	
   121	
   122	def _git_rev() -> str:
   123	    try:
   124	        rev = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()
   125	        dirty = subprocess.call(["git", "diff", "--quiet", "--", "scripts"], cwd=ROOT) != 0
   126	        return rev + ("+dirty" if dirty else "")
   127	    except Exception:
   128	        return "unknown"
   129	
   130	
   131	def main(argv=None):
   132	    ap = argparse.ArgumentParser(description=__doc__)
   133	    ap.add_argument("--kind", choices=("synthetic", "real"), default="synthetic")
   134	    ap.add_argument("--regimes", required=True)
   135	    ap.add_argument("--policies", required=True)
   136	    ap.add_argument("--seeds", type=int, default=20)
   137	    ap.add_argument("--seed-base", type=int, default=DEV_SEED_BASE)
   138	    ap.add_argument("--workers", type=int, default=max(1, mp.cpu_count() - 2))
   139	    ap.add_argument("--out", required=True)
   140	    a = ap.parse_args(argv)
   141	    from registry import EXTRA, IMPORT_ERRORS
   142	
   143	    names = [x for x in a.policies.split(",") if x]
   144	    unknown = [n for n in names if n not in EXTRA and n not in (
   145	        "gated_deployment", "discern_style", "SMCS+retain-incumbent", "model_picker_adapter",
   146	        "model_selector_causal", "online_llm_picker", "xu_acquisition_only", "cams_adapter",
   147	        "variance_min_ipw", "P7s_settled", "CONTROL_never_switch", "economic_replacement")]
   148	    if unknown:
   149	        sys.exit(f"unknown policies {unknown}; import errors: {IMPORT_ERRORS}")
   150	    regimes = [x for x in a.regimes.split(",") if x]
   151	    jobs = []
   152	    for r in regimes:
   153	        if a.kind == "synthetic":
   154	            jobs += [("synthetic", r, 0, s, a.seed_base, names) for s in range(a.seeds)]
   155	        else:
   156	            K = np.load(_loss_file(r))["l0"].shape[0]
   157	            jobs += [("real", r, e, s, a.seed_base, names) for e in range(K) for s in range(a.seeds)]
   158	    out = Path(a.out)
   159	    out.mkdir(parents=True, exist_ok=True)
   160	    t0 = time.time()
   161	    with open(out / "records.jsonl", "w") as f, mp.Pool(a.workers) as pool:
   162	        for rows in pool.imap_unordered(_job, jobs, chunksize=2):
   163	            for row in rows:
   164	                f.write(json.dumps(row) + "\n")
   165	    srcs = {p.name: hashlib.sha256(p.read_bytes()).hexdigest()[:16]
   166	            for p in sorted(HERE.glob("*.py"))}
   167	    manifest = {"argv": vars(a), "contract": CONTRACT, "git": _git_rev(), "sources": srcs,
   168	                "import_errors": IMPORT_ERRORS, "n_jobs": len(jobs),
   169	                "seconds": round(time.time() - t0, 1)}
   170	    (out / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
   171	    print(f"done {len(jobs)} jobs in {time.time() - t0:.0f}s -> {out}")
   172	
   173	
   174	if __name__ == "__main__":
   175	    main()

--- scripts/sota_sprint/validation_spec.py ---
     1	"""SOTA sprint validation registry. Registered 2026-11-03 while family screening was running and
     2	BEFORE any candidate was selected or any validation row existed.
     3	
     4	Seeds: VAL_SEED_BASE (never used before) with 100 paired seeds per regime; null-safety checks on
     5	NULL_SEEDS seeds at NULL_SEED_BASE. Regimes: the Atlas v2 V_* instances (previously run only with
     6	seed base 2026110399, so these streams are fresh) plus new W_* instances below, whose parameters
     7	differ from every development regime. Primary metric: paired Delta J vs the strongest applicable
     8	published comparator chosen per regime on the same seeds; Holm correction over the regimes a claim
     9	covers. A certified claim additionally requires promotion <= NULL_PROMOTION_BOUND on every null
    10	regime here with the NULL_SEEDS check, and the Wilson 95% upper bound reported.
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	from bench import SPRINT_REGIMES, _r
    16	
    17	VAL_SEED_BASE = 2026110601
    18	NULL_SEED_BASE = 2026110602
    19	VAL_SEEDS = 100
    20	NULL_SEEDS = 1000
    21	
    22	NEW = {r.name: r for r in [
    23	    _r("W_better_dep_r7", "dependence", [(0, 0.66)], dis=((0, 0.22),), rho=0.7, tags=("alt", "dep")),
    24	    _r("W_better_dep_r9", "dependence", [(0, 0.68)], dis=((0, 0.2),), rho=0.9, tags=("alt", "dep")),
    25	    _r("W_null_dep_r9", "dependence", [(0, 0.5)], dis=((0, 0.22),), rho=0.9, tags=("null", "dep")),
    26	    _r("W_null_dep_r95", "dependence", [(0, 0.5)], dis=((0, 0.25),), rho=0.95, tags=("null", "dep")),
    27	    _r("W_worse_dep_r8", "dependence", [(0, 0.42)], dis=((0, 0.2),), rho=0.8, tags=("null", "dep")),
    28	    _r("W_late_1000", "late", [(0, 0.42), (1000, 0.72)], dis=((0, 0.22),), tags=("alt", "change")),
    29	    _r("W_reversal_700", "reversal", [(0, 0.68), (700, 0.32)], tags=("change",)),
    30	    _r("W_delay600_better", "delay", [(0, 0.64)], delay=600, tags=("alt",)),
    31	]}
    32	SPRINT_REGIMES.update(NEW)
    33	
    34	V_ATLAS = ["V_better_a", "V_better_b", "V_better_c", "V_dep_better_r5", "V_near", "V_bursty",
    35	           "V_null", "V_worse", "V_null_dep_r5", "V_null_dep_r8", "V_late_600", "V_reversal_1000",
    36	           "V_recurrent"]
