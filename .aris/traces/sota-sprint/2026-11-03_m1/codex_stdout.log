   161	def prep(xtr: pd.DataFrame, cat: list[str]):
   162	    """Train-only preprocessing (as b3_real_data.prep)."""
   163	    from sklearn.preprocessing import OneHotEncoder, StandardScaler
   164	
   165	    num = [c for c in xtr.columns if c not in cat]
   166	    sc = StandardScaler().fit(xtr[num])
   167	    oh = (
   168	        OneHotEncoder(handle_unknown="ignore", min_frequency=20, sparse_output=False).fit(xtr[cat])
   169	        if cat
   170	        else None
   171	    )
   172	
   173	    def f(a):
   174	        parts = [sc.transform(a[num])]
   175	        if oh is not None:
   176	            parts.append(oh.transform(a[cat]))
   177	        return np.hstack(parts)
   178	
   179	    return f
   180	
   181	
   182	def build(name: str) -> dict:
   183	    x, yraw, ts = LOADERS[name]()
   184	    cat = CATEGORICAL.get(name, [])
   185	    for c in cat:
   186	        x[c] = x[c].astype(str)
   187	    n = len(x)
   188	    n15, n30 = int(0.15 * n), int(0.30 * n)
   189	    thr = float(np.median(yraw.to_numpy()[:n30]))
   190	    y = (yraw.to_numpy() > thr).astype(int)
   191	    f = prep(x.iloc[:n30], cat)
   192	    m0 = LogisticRegression(max_iter=300, C=1.0).fit(f(x.iloc[:n15]), y[:n15])
   193	    m1 = HistGradientBoostingClassifier(
   194	        max_iter=100, max_depth=4, learning_rate=0.1, random_state=0
   195	    ).fit(f(x.iloc[:n30]), y[:n30])
   196	    k = min(MAX_EPS, (n - n30) // T_EP)
   197	    starts = np.array([n30 + i * T_EP for i in range(k)], dtype=np.int64)
   198	    end = n30 + k * T_EP
   199	    xe = f(x.iloc[n30:end])
   200	    l0 = (m0.predict(xe) != y[n30:end]).astype(np.int8).reshape(k, T_EP)
   201	    l1 = (m1.predict(xe) != y[n30:end]).astype(np.int8).reshape(k, T_EP)
   202	    OUT.mkdir(parents=True, exist_ok=True)
   203	    out = OUT / f"{name}.npz"
   204	    np.savez(out, l0=l0, l1=l1, starts=starts)
   205	    content = hashlib.sha256(l0.tobytes() + l1.tobytes() + starts.tobytes()).hexdigest()
   206	    adv = (l0.astype(float) - l1).mean(axis=1)  # incumbent loss - challenger loss
   207	    return {
   208	        "dataset": name,
   209	        "uci_id": SOURCES[name][0],
   210	        "url": url(name),
   211	        "license": LICENSE,
   212	        "raw_sha256": sha256(raw_zip(name)),
   213	        "npz": str(out.relative_to(ROOT)),
   214	        "npz_sha256": sha256(out),
   215	        "array_content_sha256": content,
   216	        "n_rows": n,
   217	        "time_span": [str(ts.iloc[0]), str(ts.iloc[-1])],
   218	        "n_features_raw": int(x.shape[1]),
   219	        "label_threshold_train_median": thr,
   220	        "train_pos_rate": float(y[:n30].mean()),
   221	        "eval_pos_rate": float(y[n30:end].mean()),
   222	        "n15": n15,
   223	        "n30": n30,
   224	        "K": int(k),
   225	        "eval_end": int(end),
   226	        "delay_events": DELAYS[name],
   227	        "incumbent_err": float(l0.mean()),
   228	        "challenger_err": float(l1.mean()),
   229	        "disagreement": float((l0 != l1).mean()),
   230	        "mean_adv_per_episode": [round(float(a), 4) for a in adv],
   231	        "n_challenger_better": int((adv > 0).sum()),
   232	        "n_tied": int((adv == 0).sum()),
   233	    }
   234	
   235	
   236	def main() -> None:
   237	    stats = [build(nm) for nm in LOADERS]
   238	    (OUT / "stats.json").write_text(json.dumps(stats, indent=1) + "\n")
   239	    for s in stats:
   240	        print(
   241	            f"{s['dataset']:16s} n={s['n_rows']:6d} K={s['K']:2d} err0={s['incumbent_err']:.3f} "
   242	            f"err1={s['challenger_err']:.3f} dis={s['disagreement']:.3f} "
   243	            f"better={s['n_challenger_better']}/{s['K']}"
   244	        )
   245	
   246	
   247	if __name__ == "__main__":
   248	    main()
     1	"""SOTA sprint family A: dependence-aware certification (candidates A1-A6).
     2	
     3	All candidates keep QSG's decision skeleton (incumbent 0 vs frozen challenger 1; promote test,
     4	discard test, mirrored rollback test; cycle j of promotion runs at alpha / 2^j) and change one or
     5	more of: the evidence process, the acquisition density, the clock semantics.
     6	
     7	Observation model and filtration
     8	--------------------------------
     9	Queried disagreement outcomes ``z_k = 1[challenger correct]`` are processed in query (= issue
    10	event) order; with the common simulator's constant delay, release order equals issue order. Write
    11	``t_k`` for the issue event of query k and ``g_k = t_k - t_{k-1}``. ``F_{k-1}`` is generated by
    12	``(z_i, t_i)_{i<k}``, the disagreement indicators and the policy's private randomness. The query
    13	decision at ``t_k`` uses only labels released before ``t_k`` (a subset of ``F_{k-1}``),
    14	disagreement indicators (independent of the sign process) and private randomness, so the issue
    15	time ``t_k`` is predictable and the sign at ``t_k`` is not read before issue.
    16	
    17	Declared null class (A1, A5, A6). ``H+``: the event-time sign process ``s_t`` (``z_k = s_{t_k}``)
    18	is a stationary two-state Markov chain with ``P(s=1) = p <= 1/2`` and persistence
    19	``rho in [0, 1]`` (at each event it keeps its value w.p. rho, else redraws Bernoulli(p)), and is
    20	independent of the disagreement process. NO bound on rho is declared. Then
    21	``P(z_k = 1 | F_{k-1}) = a_k z_{k-1} + (1 - a_k) p`` with ``a_k = rho^{g_k}``, and
    22	``P(z_1 = 1) = p``. ``H-`` mirrors it (``p >= 1/2``) for the discard and rollback tests.
    23	
    24	A1 evidence: sequential universal inference (Wasserman, Ramdas & Balakrishnan 2020, Sec. 7).
    25	For a start index j, ``R_{j,k} = Q_{j:k} / U_{j:k}`` where ``Q`` is a mixture over alternative
    26	Markov models (p' > 1/2, rho' in a grid) of the conditional likelihood of ``z_j..z_k`` given
    27	``z_{j-1}`` and the gaps, and ``U_{j:k}`` is a rigorous UPPER bound on
    28	``sup_{(p,rho) in H+} L_{p,rho}(z_j..z_k | z_{j-1}, gaps)``. Because ``U >= L_theta`` for the true
    29	null member theta, ``R_{j,k} <= Q_{j:k} / L_theta(j:k)``, a nonnegative martingale from j with
    30	mean 1. Started mixture ``E_k = sum_m w_m R_{s_m,k}`` over sparse starts ``s_m`` with
    31	``sum w_m = 1``; ``E_k + sum_{s_m > k} w_m`` is dominated by a test supermartingale, and Ville
    32	gives ``P(sup_k E_k >= 1/a) <= a`` under every member of H+ simultaneously.
    33	
    34	The upper bound U: partition [0,1/2] x [0,1] into (p, rho) cells. On a cell each one-step factor
    35	is monotone in p and in rho separately (``P(+|+) = a + (1-a)p`` increasing in both;
    36	``P(-|+) = (1-a)(1-p)`` decreasing in both; ``P(+|-) = (1-a)p`` increasing in p, decreasing in
    37	rho; ``P(-|-) = 1 - (1-a)p`` decreasing in p, increasing in rho), so its cell maximum is at a known
    38	corner. The product of per-factor cell maxima bounds the cell sup; the max over cells bounds the
    39	null sup. No grid point is ever used as a proxy for the sup, so a coarse grid is conservative,
    40	never anti-conservative.
    41	
    42	A4 evidence: post-unfavourable transition betting. Under H+ (any rho),
    43	``P(z_k = 1 | z_{k-1} = 0, F_{k-1}) = (1 - a_k) p <= 1/2``, so a QSG started-mixture factor applied
    44	only to outcomes whose previous queried outcome was 0 (and to the very first outcome) has
    45	conditional mean <= 1; other outcomes contribute factor 1. Valid with no rho bound.
    46	
    47	A2 acquisition: adaptive evidence density. While front-loading, a disagreement at event t is
    48	queried only if the event gap since the last ISSUED query is at least
    49	``g* = min{g : rho_hat^g <= c}`` where ``rho_hat`` is the gap-indexed Markov MLE from released
    50	outcomes (p profiled). Deterministic and predictable: depends only on released labels and issue
    51	times. A2 alone keeps QSG's iid evidence (empirically screened, NOT certified under dependence);
    52	A5 pairs it with A1's evidence.
    53	
    54	A3 dual-clock. (i) Segment semantics: after a verdict, QSG starts the new test at the RELEASE time
    55	of the verdict and discards every outcome issued in the preceding ``delay`` events. A3 starts the
    56	new test at the next outcome in query order (all in-flight outcomes are used); each new test is a
    57	fresh e-process from that index, conditional on the past, so validity is unchanged. (ii) In-flight
    58	awareness: front-loading pauses (falls back to paced monitoring) while the number of issued but
    59	unreleased queries already exceeds a margin times the projected number of further outcomes the
    60	current test needs (projection from the running mean; predictable).
    61	"""
    62	
    63	from __future__ import annotations
    64	
