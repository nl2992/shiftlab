   467	def tune(records_dir: str, out: str) -> dict:
   468	    """Pick each grid's point minimising the mean (over regimes) of mean net cost, dev seeds only.
   469	
   470	    Host pacing grids also include the host's own uniform pacing (k = 1) as a grid point, so a
   471	    tuned baseline can never be worse in-sample than its host on the tuning set.
   472	    """
   473	    import json
   474	
   475	    import pandas as pd
   476	
   477	    df = pd.concat([pd.read_json(Path(d) / "records.jsonl", lines=True)
   478	                    for d in records_dir.split(",")], ignore_index=True)
   479	    score = df.groupby(["policy", "regime"]).net.mean().groupby("policy").mean()
   480	    tuned, table = {}, {}
   481	    for key, (prefixes, _) in _GRIDS.items():
   482	        cand = [p for p in score.index if p.startswith(prefixes) or p in _HOST_POINTS.get(key, {})]
   483	        if not cand:
   484	            continue
   485	        best = min(cand, key=lambda p: score[p])
   486	        table[key] = {p: round(float(score[p]), 2) for p in sorted(cand)}
   487	        pt = _point(best)
   488	        if key in ("gated_pace", "discern_pace"):
   489	            tuned[key] = pt
   490	        else:
   491	            tuned.update(pt)
   492	        table[key]["_selected"] = best
   493	    meta = {"tuned": tuned, "grid_scores_mean_net_over_regimes": table,
   494	            "regimes": sorted(df.regime.unique()), "seeds": int(df.seed.nunique()),
   495	            "seed_base": "DEV_SEED_BASE=2026110501", "source": records_dir}
   496	    Path(out).parent.mkdir(parents=True, exist_ok=True)
   497	    Path(out).write_text(json.dumps(tuned, indent=1) + "\n")
   498	    Path(out).with_name("tuning.json").write_text(json.dumps(meta, indent=1) + "\n")
   499	    return meta
   500	
   501	
