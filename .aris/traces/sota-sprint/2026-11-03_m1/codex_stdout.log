    82	def _p_edges(n_fine=100):
    83	    # cell edges on p in [0, 1/2]; fine near 1/2 where the constrained MLE sits under alternatives
    84	    return np.unique(np.r_[np.linspace(0.0, 0.3, 7), np.linspace(0.3, 0.45, 16),
    85	                           np.linspace(0.45, 0.5, n_fine + 1)])
    86	
    87	
    88	def _rho_edges(n=300):
    89	    # rho = exp(-r), r log-spaced; includes rho = 0 and rho = 1 exactly
    90	    r = np.geomspace(1e-4, 8.0, n)
    91	    return np.unique(np.r_[0.0, np.exp(-r[::-1]), 1.0])
