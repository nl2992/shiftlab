print('keys',sorted(rows[0]))
for k in sorted(rows[0]):
    v=rows[0][k]
    print(k, type(v).__name__, (sorted(v) if isinstance(v,dict) else v if not isinstance(v,(list,tuple)) else ('len',len(v),v[:3])))
print('datasets',Counter(r.get('dataset') for r in rows))
print('policies',len(set(r.get('policy') for r in rows)), sorted(set(r.get('policy') for r in rows)))
print('split',len(set((r.get('dataset'),r.get('split')) for r in rows)), 'episodes',len(set((r.get('dataset'),r.get('split'),r.get('episode')) for r in rows)), 'seeds',len(set(r.get('seed') for r in rows)))
