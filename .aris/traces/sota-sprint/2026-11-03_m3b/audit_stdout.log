   126	def _git_rev() -> str:
   127	    try:
   128	        rev = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()
   129	        dirty = subprocess.call(["git", "diff", "--quiet", "--", "scripts"], cwd=ROOT) != 0
   130	        return rev + ("+dirty" if dirty else "")
   131	    except Exception:
   132	        return "unknown"
