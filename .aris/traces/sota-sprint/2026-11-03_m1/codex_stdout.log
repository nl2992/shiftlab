   528	def report(dirs: str, out: str) -> dict:
   529	    """Paired contrasts (candidate - comparator) per regime and pooled; gain-source diagnostics."""
   530	    import json
   531	
   532	    import pandas as pd
   533	
   534	    sys.path.insert(0, str(Path(__file__).resolve().parent))
   535	    from bench import CERTIFIED_PUBLISHED
   536	
   537	    df = pd.concat([pd.read_json(Path(d) / "records.jsonl", lines=True)
   538	                    for d in dirs.split(",")], ignore_index=True)
   539	    df = df.drop_duplicates(["regime", "ep", "seed", "policy"])
   540	    piv = df.pivot_table(index=["regime", "ep", "seed"], columns="policy", values="net")
   541	
   542	    def pc(a, b, regs=None):
   543	        if a not in piv or b not in piv:
   544	            return None
   545	        x = piv if regs is None else piv.loc[piv.index.get_level_values(0).isin(regs)]
   546	        d = (x[a] - x[b]).dropna().to_numpy()
   547	        if len(d) < 2:
   548	            return None
   549	        se = d.std(ddof=1) / np.sqrt(len(d))
   550	        return [round(float(d.mean()), 2), round(float(d.mean() - 1.96 * se), 2),
   551	                round(float(d.mean() + 1.96 * se), 2), int(len(d))]
   552	
   553	    regs = sorted(df.regime.unique())
   554	    means = df.groupby(["regime", "policy"]).net.mean()
   555	    res = {}
   556	    for c, comps in CONTRASTS.items():
   557	        if c not in piv:
   558	            continue
   559	        r = {"pooled": {}, "by_regime": {}, "diagnostics": {}, "ablations": {}}
   560	        for k, b in comps.items():
   561	            r["pooled"][k] = pc(c, b)
   562	        for reg in regs:
   563	            cert = [p for p in CERTIFIED_PUBLISHED if (reg, p) in means.index]
   564	            best = min(cert, key=lambda p: means[(reg, p)])
   565	            cell = {k: pc(c, b, [reg]) for k, b in comps.items()}
   566	            cell["best_certified_published"] = [best] + (pc(c, best, [reg]) or [])
   567	            r["by_regime"][reg] = cell
   568	            g = df[(df.regime == reg) & (df.policy == c)]
   569	            r["diagnostics"][reg] = {
   570	                "net": round(float(g.net.mean()), 2), "promote": round(float(g.ever_promote.mean()), 3),
   571	                "labels": round(float(g.labels.mean()), 1),
   572	                "labels_by_500": round(float(g.labels_by_500.mean()), 1),
   573	                "labels_after_1000": round(float(g.labels_after_1000.mean()), 1),
   574	                "exhaust_t": round(float(g.exhaust_t.mean()), 0),
   575	                "max_pending": round(float(g.max_pending.mean()), 1),
   576	                "first_deploy_median": (float(g.first_deploy[g.first_deploy >= 0].median())
   577	                                        if (g.first_deploy >= 0).any() else -1)}
   578	        for a in ABLATIONS.get(c, []):
   579	            r["ablations"][a] = pc(c, a)
   580	        res[c] = r
   581	    Path(out).write_text(json.dumps(res, indent=1) + "\n")
   582	    return res
   583	
   584	
   585	if __name__ == "__main__":
   586	    import json
   587	
   588	    if len(sys.argv) >= 4 and sys.argv[1] == "report":
   589	        r = report(sys.argv[2], sys.argv[3])
   590	        for c, v in r.items():
   591	            print(c, json.dumps(v["pooled"]), json.dumps(v["ablations"]))
   592	
   593	    if len(sys.argv) >= 3 and sys.argv[1] == "tune":
   594	        print(json.dumps(tune(sys.argv[2], sys.argv[3] if len(sys.argv) > 3
   595	                              else str(ROOT / "docs/sota_sprint/family_c/tuned.json")), indent=1))

