   226	
   227	    def _switch(self) -> None:
   228	        new = 1 - self.deployed
   229	        if new == 0 and self.rollback_on and self.T - (self.t + 1) < self.h_min:
   230	            self.n_vetoed += 1  # too late to repay c_s: keep the challenger, stop testing
   231	            self.det = GridMixtureDetector(1e-12, [(1.0, 1, 1)])
   232	            self.order, self.queue = [], {}
   233	            return
   234	        self.n_alarms += 1
   235	        if new == 1:
   236	            self.n_promotions += 1
   237	        else:
   238	            self.n_rollbacks += 1
   239	        self.deployed = new
   240	        h = max(self.T - (self.t + 1), 1)
   241	        self.view = _rmm._View(self.t + 1, h, swap=(new == 1))
   242	        a_base = self.alpha_base
   243	        if new == 0 and self.rollback_on:  # re-promotion spends a halving share
   244	            a_base = self.alpha_base / (2.0 ** self.n_rollbacks)
   245	        self.base = self.make_base(h, max(self.remaining, 0), a_base, self.rng)
   246	        self.base_owned = set()
   247	        self.det = self._new_detector()
   248	        self.order, self.queue = [], {}
   249	        self.decided = True
   250	
   251	    def decision_state(self) -> str:
   252	        return f"dep={self.deployed};alarms={self.n_alarms};rb={self.n_rollbacks}"
   253	
   254	
   255	def _gated(T, B, a, r):
   256	    return GatedDeploymentStop(T, B, a, rng=r)
   257	
   258	
   259	def _make(**kw):
   260	    def f(T, B, cs, cq, alpha, delay, r):
   261	        return RecoveryMonitor(_gated, T, B, alpha, rng=r("gated_deployment"), delay=delay,
   262	                               cs=cs, **kw)
   263	    return f
