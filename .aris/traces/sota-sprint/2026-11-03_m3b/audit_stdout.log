   161	# ------------------------------------------------------------------------------------------------
   162	# The shared deploy-or-abstain wrapper (D1, D2, D4, D5, D6).
   163	# ------------------------------------------------------------------------------------------------
   164	class DeployGate:
   165	    """Host ranks and queries; an anytime certificate gates promotion of the challenger.
   166	
   167	    Parameters
   168	    ----------
   169	    acq : "host_pref" (default) the gate front-loads every disagreement (q=1) while undecided and
   170	          the host ranks the challenger first; "always" front-loads while undecided regardless of
   171	          the host (QSG-like); "host_only" adds no queries (pure veto on the host's own labels).
   172	    and_host : promotion also requires the host to rank the challenger first.
   173	    rollback : after promotion a mirrored test (H-: p>=1/2 on outcomes issued after promotion)
   174	               at level alpha_r rolls back; the next promotion cycle runs at alpha/2^cycle.
   175	    reserve : fraction of the budget withheld from all pre-promotion queries (host and gate),
   176	              usable only after promotion for the rollback test.
   177	    share : gate-acquired labels are also given to the host (with the combined frozen issue-time
   178	            propensity u + (1-u) q_gate, so the host's IPW stays unbiased).
   179	    stop_when_final : once promoted with no rollback, deployment is absorbing, so all queries stop.
   180	    """
   181	
   182	    def __init__(self, host, T, B, alpha, *, rng, cert=started_mixture, acq="host_pref",
   183	                 and_host=True, rollback=False, reserve=0.0, alpha_r=0.05, share=True,
   184	                 stop_when_final=True, monitor=True, name="DeployGate"):
   185	        self.host, self.name = host, name
   186	        self.T, self.B, self.alpha, self.alpha_r = T, B, alpha, alpha_r
   187	        self.rng, self.cert, self.acq = rng, cert, acq
   188	        self.and_host, self.rollback, self.share = and_host, rollback, share
   189	        self.stop_when_final, self.monitor = stop_when_final, monitor
   190	        self.reserve = int(round(reserve * B))
   191	        self.pacer = PacedDisagreementAcquisition(T, B)
   192	        self.deployed, self.cycle, self.decided, self.cert_ok = 0, 1, False, False
   193	        self.seg = 0
   194	        self.host_pref = 0
   195	        self.n_promotions = 0
   196	        self.last = None  # last queried disagreement outcome of the stream: (z, issue event)
   197	        self._req: dict[int, tuple[bool, float, float]] = {}  # t -> (host drew, u_host, q_comb)
   198	        self._new_tests()
   199	
   200	    def _new_tests(self):
   201	        if self.deployed == 0:
   202	            self.e_up, self.e_dn = self.cert(+1), self.cert(-1)
   203	        else:
   204	            self.e_up, self.e_dn = None, self.cert(-1)
   205	        self.cert_ok = False
   206	
   207	    # -- deployment ---------------------------------------------------------------------------
   208	    def predict(self, event):
   209	        self.host_pref = int(self.host.predict(event))
   210	        if self.deployed == 0 and self.cert_ok and (self.host_pref == 1 or not self.and_host):
   211	            self.deployed, self.decided, self.seg = 1, True, event.t
   212	            self.n_promotions += 1
   213	            self._new_tests()
   214	        return self.deployed
   215	
   216	    # -- acquisition --------------------------------------------------------------------------
   217	    def request_labels(self, event, remaining_budget):
   218	        dis = bool(event.model_predictions[0] != event.model_predictions[1])
   219	        q_pace = self.pacer.propensity(event.t, remaining_budget, dis)
   220	        self.pacer.note_event(dis)
   221	        final = self.deployed == 1 and not self.rollback and self.stop_when_final
   222	        hreq = self.host.request_labels(event, remaining_budget)  # host keeps its own draw
   223	        if final or not dis or remaining_budget <= 0:
   224	            return QueryRequest(requested=False)
   225	        pre = self.deployed == 0
   226	        if pre and remaining_budget <= self.reserve:
   227	            return QueryRequest(requested=False)  # reserve is for post-promotion monitoring only
   228	        u = _host_u(self.host, event, hreq)
   229	        if pre and not self.decided and (
   230	                self.acq == "always" or (self.acq == "host_pref" and self.host_pref == 1)):
   231	            q_g = 1.0
   232	        elif self.deployed == 1 and self.rollback and self.monitor:
   233	            q_g = q_pace  # paced rollback monitoring from the remaining (reserved) budget
   234	        else:
   235	            q_g = 0.0
   236	        take = bool(hreq.requested) or (q_g > 0 and bool(self.rng.random() < q_g))
   237	        if not take:
   238	            return QueryRequest(requested=False)
   239	        # issue-time propensity of the union of two independent draws, frozen here
   240	        q_comb = u + (1.0 - u) * q_g
   241	        extra = dict(hreq.extra) if hreq.requested else _host_extra(self.host, event)
   242	        self._req[event.t] = (bool(hreq.requested), u, q_comb)
   243	        return QueryRequest(requested=True, probability=q_comb, extra=extra)
   244	
   245	    # -- feedback ------------------------------------------------------------------------------
   246	    def observe(self, feedback):
   247	        fbs = sorted(feedback, key=lambda f: f.event_id)
   248	        host_fb = []
   249	        for fb in fbs:
   250	            drew, u, q_comb = self._req.pop(fb.event_id, (True, fb.query_probability,
   251	                                                          fb.query_probability))
   252	            if self.share or drew:
   253	                p = q_comb if self.share else u
   254	                host_fb.append(ReleasedFeedback(fb.event_id, fb.t_requested, fb.t_released,
   255	                                                fb.label, fb.model_losses, float(p), fb.extra))
   256	        if host_fb:
   257	            self.host.observe(host_fb)
   258	        for fb in fbs:
   259	            d = int(fb.model_losses[0]) - int(fb.model_losses[1])
   260	            if d == 0:
   261	                continue
   262	            z, last = int(d > 0), self.last
   263	            self.last = (z, fb.event_id)
   264	            if fb.event_id < self.seg:
   265	                continue
   266	            if self.deployed == 0:
   267	                up = self.e_up.update(z, fb.event_id, last)
   268	                dn = self.e_dn.update(z, fb.event_id, last)
   269	                if up >= 2.0 ** self.cycle / self.alpha:
   270	                    # latched: Ville bounds the event "ever crossed"; stop front-loading and
   271	                    # wait for the host to rank the challenger first
   272	                    self.cert_ok, self.decided = True, True
   273	                elif dn >= 1.0 / self.alpha and not self.cert_ok:
   274	                    self.decided = True  # discard: stop gate front-loading, host continues
   275	            elif self.rollback:
   276	                if self.e_dn.update(z, fb.event_id, last) >= 1.0 / self.alpha_r:
   277	                    self.deployed, self.decided, self.seg = 0, False, fb.t_released
   278	                    self.cycle += 1
   279	                    self._new_tests()
   280	
   281	    def decision_state(self):
   282	        return f"dep={self.deployed};cycle={self.cycle};cert={int(self.cert_ok)};pref={self.host_pref}"
   283	
   284	    def state_dict(self):
   285	        return {}
   286	
   287	    def load_state_dict(self, s):
   288	        pass
   289	
   290	
   291	# ------------------------------------------------------------------------------------------------
   292	# D3: Model Selector + post-decision monitoring.
   293	# ------------------------------------------------------------------------------------------------
   294	class SelectThenMonitor:
   295	    """Model Selector picks once, then a sequential monitor replaces the model on evidence.
   296	
   297	    Phase 1: the Model Selector causal adapter runs natively (its own paced record-gate queries
   298	    and labeled-accuracy rule, deploying what it selects) until ``n_select`` labels have been
   299	    released; its choice is then frozen (the published method is a one-shot selection).
   300	    Phase 2: the remaining budget is paced over disagreements; a started-mixture test of
   301	    "the deployed model is never worse on a disagreement" runs on outcomes issued after the
   302	    selection. Rejection replaces the model. A replacement *to the challenger* is a promotion and
   303	    uses threshold 2^cycle/alpha; a replacement back to the incumbent uses 1/alpha_r.
   304	    The initial selection is uncertified (that is the host's behaviour); ``gate_initial=True``
   305	    holds the incumbent at selection time unless the phase-1 evidence certifies the challenger.
   306	    """
   307	
   308	    def __init__(self, T, B, alpha, *, r, rng, n_select=100, alpha_r=0.05, cert=started_mixture,
   309	                 gate_initial=False, name="D3"):
   310	        self.host = make_host("ms", r)
   311	        self.name, self.T, self.B, self.alpha, self.alpha_r = name, T, B, alpha, alpha_r
   312	        self.rng, self.cert, self.n_select, self.gate_initial = rng, cert, n_select, gate_initial
   313	        self.pacer = PacedDisagreementAcquisition(T, B)
   314	        self.phase, self.deployed, self.cycle, self.seg, self.n_obs = 1, 0, 1, 0, 0
   315	        self.pre_up = cert(+1)  # phase-1 evidence (for gate_initial only)
   316	        self.pre_ok = False
   317	        self.mon = None
   318	
   319	    def predict(self, event):
   320	        if self.phase == 1:
   321	            self.deployed = int(self.host.predict(event))
   322	            if self.gate_initial and not self.pre_ok:
   323	                self.deployed = 0
   324	        return self.deployed
   325	
   326	    def request_labels(self, event, remaining_budget):
   327	        dis = bool(event.model_predictions[0] != event.model_predictions[1])
   328	        q = self.pacer.propensity(event.t, remaining_budget, dis)
   329	        self.pacer.note_event(dis)
   330	        if self.phase == 1:
   331	            return self.host.request_labels(event, remaining_budget)
   332	        if not dis or remaining_budget <= 0:
   333	            return QueryRequest(requested=False)
   334	        take = bool(self.rng.random() < q)
   335	        return QueryRequest(requested=take, probability=q if take else 0.0)
   336	
   337	    def _start_monitor(self, t):
   338	        self.phase, self.seg = 2, t
   339	        # test "deployed never worse": deployed=0 -> H+ (z favours challenger), deployed=1 -> H-
   340	        self.mon = self.cert(+1 if self.deployed == 0 else -1)
   341	
   342	    def observe(self, feedback):
   343	        for fb in sorted(feedback, key=lambda f: f.event_id):
   344	            d = int(fb.model_losses[0]) - int(fb.model_losses[1])
   345	            if self.phase == 1:
   346	                self.host.observe([fb])
   347	                self.n_obs += 1
   348	                if d != 0 and self.gate_initial and not self.pre_ok:
   349	                    if self.pre_up.update(int(d > 0), fb.event_id) >= 2.0 / self.alpha:
   350	                        self.pre_ok = True
   351	                if self.n_obs >= self.n_select:
   352	                    c0, c1 = self.host.correct
   353	                    pref = 1 if c1 > c0 else 0 if c0 > c1 else self.deployed
   354	                    if self.gate_initial and not self.pre_ok:
   355	                        pref = 0
   356	                        self.cycle = 2  # phase-1 test spent alpha/2; next promotion test alpha/4
   357	                    self.deployed = pref
   358	                    self._start_monitor(fb.t_released)
   359	                continue
   360	            if d == 0 or fb.event_id < self.seg:
   361	                continue
   362	            e = self.mon.update(int(d > 0), fb.event_id)
   363	            thr = (2.0 ** self.cycle / self.alpha) if self.deployed == 0 else 1.0 / self.alpha_r
   364	            if e >= thr:
   365	                self.deployed = 1 - self.deployed
   366	                if self.deployed == 0:
   367	                    self.cycle += 1
   368	                self._start_monitor(fb.t_released)
   369	
   370	    def decision_state(self):
   371	        return f"phase={self.phase};dep={self.deployed}"
   372	
   373	    def state_dict(self):
   374	        return {}
   375	
   376	    def load_state_dict(self, s):
   377	        pass
   378	
