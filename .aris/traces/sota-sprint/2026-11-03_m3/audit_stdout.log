    34	V_ATLAS = ["V_better_a", "V_better_b", "V_better_c", "V_dep_better_r5", "V_near", "V_bursty",
    35	           "V_null", "V_worse", "V_null_dep_r5", "V_null_dep_r8", "V_late_600", "V_reversal_1000",
    36	           "V_recurrent"]
    37	VAL_REGIMES = V_ATLAS + list(NEW)
