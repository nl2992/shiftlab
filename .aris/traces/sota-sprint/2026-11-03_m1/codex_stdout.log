   286	
   287	    def c_phase2(self, rem, exp_left):
   288	        return (1.0, min(max(rem / exp_left, self.p_min), 1.0))
   289	
   290	    def c_skip(self, action, explore):
   291	        if (action or "floor") == "floor":
   292	            return (1.0, self.p_min)
   293	        return (explore, 1.0)
