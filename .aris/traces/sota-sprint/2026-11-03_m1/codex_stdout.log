    46	
    47	def parse_regime(name: str) -> tuple[Regime, int | None]:
    48	    """``F0_better@B100`` -> (regime, 100); plain name -> (regime, None)."""
    49	    base, _, b = name.partition("@B")
    50	    return SPRINT_REGIMES[base], (int(b) if b else None)
