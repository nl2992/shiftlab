--- scripts/promising_directions/sota/simulator.py ---
     1	"""Common streaming-deployment simulator for the SOTA comparison.
     2	
     3	The simulator owns the hidden labels. A policy sees a label only after it has requested it and
     4	the declared delay has elapsed. The evaluator may read hidden labels to score predictions; the
     5	policy may not, and the only channel from labels to a policy is ``observe``.
     6	
     7	Design points that the comparison depends on:
     8	
     9	* **Frozen propensities.** The query probability and any betting parameter are recorded at
    10	  *issue* time and travel with the request. Nothing is recomputed at release. ``ReleasedFeedback``
    11	  carries the issue-time values so a policy cannot accidentally use a later estimate.
    12	* **Hard budget.** ``remaining_budget`` is enforced by the simulator, not by the policy. A policy
    13	  that asks when the budget is exhausted simply does not get the label, and the attempt is
    14	  recorded. Several published methods do not enforce a cap at all; forcing one on them is an
    15	  adapter decision and is recorded per policy rather than hidden.
    16	* **One documented event order** for every method, supplied by the caller.
    17	* **Determinism.** Each policy is driven by its own ``numpy`` Generator seeded from
    18	  ``(seed_base, episode, policy_name)``, so policies do not consume one another's randomness and a
    19	  run is reproducible from its seed alone.
    20	"""
    21	
    22	from __future__ import annotations
    23	
    24	import hashlib
    25	from dataclasses import dataclass, field
    26	from typing import Any, Protocol
    27	
    28	import numpy as np
    29	
    30	# Columns of the per-event record, in order.
    31	EVENT_FIELDS = (
    32	    "event_id",
    33	    "deployed_model",
    34	    "requested",
    35	    "query_probability",
    36	    "request_time",
    37	    "release_time",
    38	    "budget_remaining",
    39	    "prediction_loss",
    40	    "query_cost",
    41	    "switch_cost",
    42	    "decision_state",
    43	)
    44	
    45	
    46	@dataclass(frozen=True)
    47	class Event:
    48	    """What a policy may see before it acts. Never carries the label."""
    49	
    50	    event_id: int
    51	    t: int
    52	    horizon: int
    53	    model_predictions: np.ndarray  # (n_models,) predicted labels
    54	    context: Any = None  # features, or None where a policy is context-free
    55	
    56	
    57	@dataclass(frozen=True)
    58	class QueryRequest:
    59	    """A policy's acquisition decision. ``probability`` is frozen here and never recomputed."""
    60	
    61	    requested: bool
    62	    probability: float = 0.0
    63	    extra: dict = field(default_factory=dict)  # e.g. a frozen betting fraction
    64	
    65	
    66	@dataclass(frozen=True)
    67	class ReleasedFeedback:
    68	    """A label coming back, with the issue-time values that accompanied its request."""
    69	
    70	    event_id: int
    71	    t_requested: int
    72	    t_released: int
    73	    label: int
    74	    model_losses: np.ndarray  # (n_models,) 0/1 loss of every frozen model on this event
    75	    query_probability: float  # the issue-time propensity, not a recomputed one
    76	    extra: dict = field(default_factory=dict)
    77	
    78	
    79	class Policy(Protocol):
    80	    """The interface every competitor and every one of our policies implements."""
    81	
    82	    name: str
    83	
    84	    def predict(self, event: Event) -> int:
    85	        """Return the index of the model to deploy for this event."""
    86	
    87	    def request_labels(self, event: Event, remaining_budget: int) -> QueryRequest:
    88	        """Decide whether to buy this event's label. Called after ``predict``."""
    89	
    90	    def observe(self, feedback: list[ReleasedFeedback]) -> None:
    91	        """Receive labels whose delay has now elapsed. May be empty."""
    92	
    93	    def state_dict(self) -> dict:
    94	        """Serialisable state sufficient for deterministic restoration."""
    95	
    96	    def load_state_dict(self, state: dict) -> None:
    97	        """Restore from ``state_dict``."""
    98	
    99	
   100	def policy_rng(seed_base: int, episode: int, policy_name: str) -> np.random.Generator:
   101	    """A generator private to one (episode, policy), so policies cannot perturb each other."""
   102	    h = hashlib.sha256(policy_name.encode()).digest()[:8]
   103	    return np.random.default_rng(
   104	        np.random.SeedSequence([seed_base, episode, int.from_bytes(h, "big") % (2**31)])
   105	    )
   106	
   107	
   108	@dataclass
   109	class EpisodeResult:
   110	    policy: str
   111	    net_cost: float
   112	    prediction_loss: float
   113	    requested_labels: int
   114	    deployment_switches: int
   115	    records: list[dict]
   116	    refused_requests: int  # asked with no budget left; evidence of a cap being binding
   117	
   118	    def as_summary(self) -> dict:
   119	        return {
   120	            "policy": self.policy,
   121	            "net_cost": self.net_cost,
   122	            "prediction_loss": self.prediction_loss,
   123	            "requested_labels": self.requested_labels,
   124	            "deployment_switches": self.deployment_switches,
   125	            "refused_requests": self.refused_requests,
   126	        }
   127	
   128	
   129	def run_episode(
   130	    policy: Policy,
   131	    *,
   132	    model_predictions: np.ndarray,  # (T, n_models) predicted labels
   133	    labels: np.ndarray,  # (T,) hidden ground truth, evaluator-only
   134	    contexts: Any = None,  # (T, d) or None
   135	    delay: int,
   136	    budget: int,
   137	    label_price: float,
   138	    switch_cost: float,
   139	    initial_model: int = 0,
   140	    trace: bool = True,
   141	) -> EpisodeResult:
   142	    """Run one policy over one episode. Returns its net cost and per-event records.
   143	
   144	    ``labels`` is read only to score predictions and to construct released feedback. It is never
   145	    passed to the policy except through ``observe`` for events the policy paid for.
   146	    """
   147	    horizon = int(model_predictions.shape[0])
   148	    n_models = int(model_predictions.shape[1])
   149	    if labels.shape[0] != horizon:
   150	        raise ValueError("labels and model_predictions disagree on horizon")
   151	    if delay < 1:
   152	        # Releases are drained at the START of an event, before that event's act, so a request
   153	        # filed at t with delay 0 would land in a slot already passed and never be delivered:
   154	        # the policy would silently never learn. Within one event everything is already decided
   155	        # by the time the label exists, so delay 0 has no meaning in this loop. Immediate
   156	        # feedback -- the label of event t usable for event t+1 -- is delay = 1.
   157	        raise ValueError(
   158	            f"delay must be >= 1 (got {delay}); immediate feedback is delay=1, since a label "
   159	            "cannot inform the event it belongs to"
   160	        )
   161	
   162	    deployed = int(initial_model)
   163	    remaining = int(budget)
   164	    n_requested = 0
   165	    n_switches = 0
   166	    n_refused = 0
   167	    total_loss = 0.0
   168	    records: list[dict] = []
   169	    pending: dict[int, list[ReleasedFeedback]] = {}
   170	
   171	    for t in range(horizon):
   172	        event = Event(
   173	            event_id=t,
   174	            t=t,
   175	            horizon=horizon,
   176	            model_predictions=model_predictions[t],
   177	            context=None if contexts is None else contexts[t],
   178	        )
   179	
   180	        # ---- release first: labels earned earlier become usable now, before this event's act
   181	        due = pending.pop(t, [])
   182	        if due:
   183	            policy.observe(due)
   184	
   185	        # ---- deploy
   186	        prev = deployed
   187	        deployed = int(policy.predict(event))
   188	        if not 0 <= deployed < n_models:
   189	            raise ValueError(f"{policy.name} deployed invalid model index {deployed}")
   190	        switched = int(deployed != prev)
   191	        n_switches += switched
   192	        loss = float(model_predictions[t, deployed] != labels[t])
   193	        total_loss += loss
   194	
   195	        # ---- acquire
   196	        req = policy.request_labels(event, remaining)
   197	        granted = bool(req.requested) and remaining > 0
   198	        if req.requested and remaining <= 0:
   199	            n_refused += 1
   200	        release_time = None
   201	        if granted:
   202	            remaining -= 1
   203	            n_requested += 1
   204	            release_time = t + delay
   205	            if release_time < horizon:
   206	                pending.setdefault(release_time, []).append(
   207	                    ReleasedFeedback(
   208	                        event_id=t,
   209	                        t_requested=t,
   210	                        t_released=release_time,
   211	                        label=int(labels[t]),
   212	                        model_losses=(model_predictions[t] != labels[t]).astype(np.int8),
   213	                        query_probability=float(req.probability),  # frozen at issue
   214	                        extra=dict(req.extra),
   215	                    )
   216	                )
   217	
   218	        if trace:
   219	            records.append(
   220	                {
   221	                    "event_id": t,
   222	                    "deployed_model": deployed,
   223	                    "requested": int(granted),
   224	                    "query_probability": float(req.probability) if req.requested else 0.0,
   225	                    "request_time": t if granted else None,
   226	                    "release_time": release_time if granted else None,
   227	                    "budget_remaining": remaining,
   228	                    "prediction_loss": loss,
   229	                    "query_cost": label_price if granted else 0.0,
   230	                    "switch_cost": switch_cost * switched,
   231	                    "decision_state": getattr(policy, "decision_state", lambda: "")(),
   232	                }
   233	            )
   234	
   235	    net = total_loss + label_price * n_requested + switch_cost * n_switches
   236	    return EpisodeResult(
   237	        policy=policy.name,
   238	        net_cost=float(net),
   239	        prediction_loss=float(total_loss),
   240	        requested_labels=int(n_requested),
   241	        deployment_switches=int(n_switches),
   242	        records=records,
   243	        refused_requests=int(n_refused),
   244	    )
   245	
   246	
   247	def check_no_future_access(result: EpisodeResult, delay: int) -> list[str]:
   248	    """Validation: no label may be released before its delay has elapsed."""
   249	    problems = []
   250	    for r in result.records:
   251	        if r["release_time"] is not None and r["release_time"] - r["request_time"] != delay:
   252	            problems.append(f"event {r['event_id']}: release-request != delay")
   253	    return problems
   254	
   255	
   256	def check_budget_feasible(result: EpisodeResult, budget: int) -> list[str]:
   257	    """Validation: the hard cap holds pathwise, not merely on average."""
   258	    problems = []
   259	    if result.requested_labels > budget:
   260	        problems.append(f"{result.policy}: {result.requested_labels} labels > budget {budget}")
   261	    for r in result.records:
   262	        if r["budget_remaining"] < 0:
   263	            problems.append(f"{result.policy}: negative budget at event {r['event_id']}")
   264	    return problems

--- scripts/failure_atlas_v2_flq/regimes.py ---
     1	"""Failure Atlas v2 synthetic regimes: paired 0/1 loss streams for two frozen models.
     2	
     3	Each regime is a generator of a (T, 2) 0/1 loss array (column 0 incumbent, column 1 challenger)
     4	plus an evaluator-only truth record (the per-event challenger advantage G_t = E[l0 - l1]). The
     5	truth is never passed to a policy: the runner replays losses through the common simulator, so a
     6	policy sees only predictions and, after paying and waiting, labels.
     7	
     8	Construction. At event t the models disagree with probability ``dis_t``. On a disagreement the
     9	challenger is the correct one with probability ``p_t`` (so ``D = l0 - l1 = +1``), otherwise the
    10	incumbent is (``D = -1``). On agreement both are right or both wrong (``err_agree``), giving
    11	``D = 0``. Hence ``G_t = dis_t (2 p_t - 1)``. Serial dependence, where requested, is a two-state
    12	Markov chain on the disagreement-outcome sign with stationary probability ``p_t`` and persistence
    13	``rho``; it changes no marginal and so no ``G_t``.
    14	
    15	The families mirror Failure Atlas v1 (late/transient improvement, regime change, serial
    16	dependence, delay, near-indistinguishability, rare informative subpopulations) under the v2
    17	contract T=2000, B=200, c_q=.05, c_s=5. Parameters were fixed before any competitor was run on
    18	them; see ``docs/failure_atlas_v2_flq/protocol.md``.
    19	"""
    20	
    21	from __future__ import annotations
    22	
    23	from dataclasses import dataclass, field
    24	
    25	import numpy as np
    26	
    27	T = 2000
    28	
    29	
    30	@dataclass(frozen=True)
    31	class Regime:
    32	    name: str
    33	    family: str
    34	    p: tuple[tuple[int, float], ...]  # piecewise-constant p_t: ((start, p), ...)
    35	    dis: tuple[tuple[int, float], ...] = ((0, 0.2),)
    36	    rho: float = 0.0  # Markov persistence of the disagreement-outcome sign
    37	    burst: float = 0.0  # >0: disagreements arrive in Markov bursts with this persistence
    38	    delay: int = 100
    39	    err_agree: float = 0.1
    40	    notes: str = ""
    41	    tags: tuple[str, ...] = field(default=())
    42	
    43	    def schedule(self, horizon: int = T) -> tuple[np.ndarray, np.ndarray]:
    44	        def pw(spec):
    45	            out = np.empty(horizon)
    46	            for i, (s, v) in enumerate(spec):
    47	                e = spec[i + 1][0] if i + 1 < len(spec) else horizon
    48	                out[s:e] = v
    49	            return out
    50	
    51	        return pw(self.p), pw(self.dis)
    52	
    53	    def truth_gain(self, horizon: int = T) -> np.ndarray:
    54	        p, dis = self.schedule(horizon)
    55	        return dis * (2.0 * p - 1.0)
    56	
    57	    def sample(self, rng: np.random.Generator, horizon: int = T) -> np.ndarray:
    58	        p, dis = self.schedule(horizon)
    59	        u = rng.random(horizon)
    60	        if self.burst > 0.0:
    61	            # two-state on/off chain with stationary on-probability dis_t and persistence burst
    62	            on = np.empty(horizon, dtype=bool)
    63	            on[0] = u[0] < dis[0]
    64	            for t in range(1, horizon):
    65	                stay = rng.random() < self.burst
    66	                on[t] = on[t - 1] if stay else (u[t] < dis[t])
    67	        else:
    68	            on = u < dis
    69	        v = rng.random(horizon)
    70	        sign = np.empty(horizon, dtype=bool)  # True => challenger correct on a disagreement
    71	        sign[0] = v[0] < p[0]
    72	        if self.rho > 0.0:
    73	            for t in range(1, horizon):
    74	                keep = rng.random() < self.rho
    75	                sign[t] = sign[t - 1] if keep else (v[t] < p[t])
    76	        else:
    77	            sign = v < p
    78	        both_wrong = rng.random(horizon) < self.err_agree
    79	        l0 = np.where(on, sign, both_wrong).astype(np.int8)
    80	        l1 = np.where(on, ~sign, both_wrong).astype(np.int8)
    81	        return np.stack([l0, l1], axis=1)
    82	
    83	
    84	def _r(name, family, p, **kw) -> Regime:
    85	    return Regime(name=name, family=family, p=tuple(p), **kw)
    86	
    87	
    88	# Locked regime registry. Families F0-F9 follow the v1 failure families; the p values give a
    89	# per-event stationary advantage of .2*(2p-1): p=.65 -> .06, p=.58 -> .032, p=.53 -> .012.
    90	REGIMES: dict[str, Regime] = {r.name: r for r in [
    91	    # F0: stationary references
    92	    _r("F0_better", "stationary", [(0, 0.65)], tags=("alt",)),
    93	    _r("F0_null", "stationary", [(0, 0.5)], tags=("null",)),
    94	    _r("F0_worse", "stationary", [(0, 0.35)], tags=("null",)),
    95	    # F1: late improvement (challenger worse, then better)
    96	    _r("F1_late_400", "late", [(0, 0.4), (400, 0.68)], tags=("alt", "change")),
    97	    _r("F1_late_800", "late", [(0, 0.4), (800, 0.7)], tags=("alt", "change")),
    98	    _r("F1_late_1200", "late", [(0, 0.4), (1200, 0.75)], tags=("alt", "change")),
    99	    # F2: transient improvement
   100	    _r("F2_transient", "transient", [(0, 0.4), (300, 0.72), (1100, 0.4)], tags=("change",)),
   101	    # F3: abrupt reversal after a genuine early advantage (rollback needed)
   102	    _r("F3_reversal_800", "reversal", [(0, 0.7), (800, 0.3)], tags=("change",)),
   103	    _r("F3_reversal_1200", "reversal", [(0, 0.7), (1200, 0.3)], tags=("change",)),
   104	    # F4: recurrent regimes
   105	    _r("F4_recurrent", "recurrent",
   106	       [(0, 0.7), (500, 0.32), (1000, 0.7), (1500, 0.32)], tags=("change",)),
   107	    # F5: serial dependence (Markov sign persistence)
   108	    _r("F5_dep_null_r8", "dependence", [(0, 0.5)], rho=0.8, tags=("null", "dep")),
   109	    _r("F5_dep_better_r8", "dependence", [(0, 0.65)], rho=0.8, tags=("alt", "dep")),
   110	    _r("F5_dep_null_r95", "dependence", [(0, 0.5)], rho=0.95, tags=("null", "dep")),
   111	    # F6: long label delay
   112	    _r("F6_delay400_better", "delay", [(0, 0.65)], delay=400, tags=("alt",)),
   113	    _r("F6_delay400_late", "delay", [(0, 0.4), (800, 0.7)], delay=400, tags=("alt", "change")),
   114	    # F7: near-indistinguishable models
   115	    _r("F7_near_better", "near", [(0, 0.58)], tags=("alt",)),
   116	    _r("F7_near_tiny", "near", [(0, 0.53)], tags=("alt",)),
   117	    # F8: rare informative subpopulation (rare disagreements, strong advantage)
   118	    _r("F8_rare_better", "rare", [(0, 0.9)], dis=((0, 0.03),), tags=("alt",)),
   119	    # F9: high-disagreement (budget pressure) and bursty disagreements
   120	    _r("F9_highdis_better", "budget", [(0, 0.58)], dis=((0, 0.5),), tags=("alt",)),
   121	    _r("F9_bursty_better", "budget", [(0, 0.65)], burst=0.95, tags=("alt",)),
   122	]}
   123	
   124	
   125	def hindsight_oracle_cost(losses: np.ndarray, cs: float, start: int = 0) -> float:
   126	    """Evaluator-only: minimum cost over all deployment paths given realised losses (DP).
   127	
   128	    A hindsight bound, not a feasible policy: it sees every label for free.
   129	    """
   130	    INF = float("inf")
   131	    c = [0.0 if m == start else INF for m in (0, 1)]
   132	    for t in range(losses.shape[0]):
   133	        c = [min(c[m], c[1 - m] + cs) + float(losses[t, m]) for m in (0, 1)]
   134	    return float(min(c))
   135	
   136	
   137	def expected_oracle_path(gain: np.ndarray, cs: float) -> np.ndarray:
   138	    """Evaluator-only: deployment path minimising EXPECTED cost given true G_t (DP on means)."""
   139	    T_ = len(gain)
   140	    INF = float("inf")
   141	    # cost of model 0 = 0, model 1 = -G_t (relative)
   142	    val = np.zeros((T_ + 1, 2))
   143	    choice = np.zeros((T_, 2), dtype=int)
   144	    for t in range(T_ - 1, -1, -1):
   145	        for m in (0, 1):
   146	            best, arg = INF, m
   147	            for n in (0, 1):
   148	                v = (cs if n != m else 0.0) + (-gain[t] if n == 1 else 0.0) + val[t + 1, n]
   149	                if v < best - 1e-12:
   150	                    best, arg = v, n
   151	            val[t, m], choice[t, m] = best, arg
   152	    path = np.empty(T_, dtype=int)
   153	    m = 0
   154	    for t in range(T_):
   155	        m = choice[t, m]
   156	        path[t] = m
   157	    return path
   158	
   159	
