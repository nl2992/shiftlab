--- scripts/failure_atlas_v2_flq/strong_hosts.py ---
     1	"""Strongest-reading re-ports of gated deployment and DISCERN (review response, 2026-11-03).
     2	
     3	The discovery ports fixed the importance-weight range at the declared worst case ``1/p_min = 20``.
     4	The independent review (docs/failure_atlas_v2_flq/results/review_discovery_algorithm.md) pointed out that the
     5	issue-time propensity ``q_t`` is predictable, so a tighter per-step range is legitimate:
     6	
     7	* ``GatedAdaptiveRange``: MOPE (Karampatziakis et al., Alg. 2) with the bet set ``C`` of Section 4.4
     8	  evaluated at ``wmax_t = 1/q_t`` for a disagreement record and ``wmax_t = 2`` for an agreement
     9	  (where ``w = 1`` exactly). The bet is recomputed from the past sufficient statistics immediately
    10	  before each increment is ingested, so it is predictable; every realised ``w <= wmax_t`` keeps the
    11	  Lemma 1 condition ``x >= -1/2`` and wealth positive.
    12	* ``DiscernDesignFloor``: DISCERN-style with a declared design floor ``pi_min = .25`` (``c = 4``)
    13	  shared by its pacer, instead of ``.05``. A per-step ``c_t`` would change the [0,1] mapping of the
    14	  mean step by step and is not covered by the PrPl-EB theorem, so the design floor is the
    15	  strongest reading we can defend.
    16	
    17	Front-loaded variants (q = 1 while undecided) are the attachable repair on these stronger hosts.
    18	"""
    19	
    20	from __future__ import annotations
    21	
    22	from qce import DiscernFrontOnly, GatedDeploymentStop, DiscernStyleStop  # noqa: F401
    23	
    24	
    25	class GatedAdaptiveRange(GatedDeploymentStop):
    26	    def __init__(self, horizon, budget, alpha, *, rng, p_min=0.05, front=False,
    27	                 name="gated_adaptive_range"):  # fmt: skip
    28	        super().__init__(horizon, budget, alpha, rng=rng, p_min=p_min, name=name)
    29	        self._wmax: dict[int, float] = {}
    30	        self.front = front
    31	        if front:
    32	            base = self.acq.propensity
    33	            self.acq.propensity = lambda t, rem, dis, _b=base: (
    34	                1.0 if (dis and rem > 0) else _b(t, rem, dis))
    35	
    36	    def request_labels(self, event, remaining_budget):
    37	        req = super().request_labels(event, remaining_budget)
    38	        dis = bool(event.model_predictions[0] != event.model_predictions[1])
    39	        if dis and req.probability > 0:
    40	            self._wmax[event.t] = max(1.0 / req.probability, 2.0)
    41	        else:
    42	            self._wmax[event.t] = 2.0  # agreement: w = 1 exactly
    43	        return req
    44	
    45	    def _ingest(self, w, d, event_ref):
    46	        wm = self._wmax.pop(event_ref, 1.0 / self.p_min)
    47	        for side in (self.cs.plus, self.cs.minus):
    48	            side.wmax = wm
    49	            side._bet()  # bet over C(wmax_t) from past statistics only
    50	        super()._ingest(w, d, event_ref)
    51	
    52	
    53	class DiscernDesignFloor(DiscernStyleStop):
    54	    def __init__(self, horizon, budget, alpha, eps=0.0, *, rng, front=False,
    55	                 name="discern_design_floor"):  # fmt: skip
    56	        super().__init__(horizon, budget, alpha, eps, rng=rng, p_min=0.25, name=name)
    57	        if front:
    58	            base = self.acq.propensity
    59	            self.acq.propensity = lambda t, rem, dis, _b=base: (
    60	                1.0 if (dis and rem > 0) else _b(t, rem, dis))
    61	
    62	
    63	EXTRA = {
    64	    "gated_adaptive_range": lambda T, B, cs, cq, a, d, r: GatedAdaptiveRange(
    65	        T, B, a, rng=r("gated_deployment")),
    66	    "gated_adaptive_range+front": lambda T, B, cs, cq, a, d, r: GatedAdaptiveRange(
    67	        T, B, a, rng=r("gated_deployment"), front=True, name="gated_adaptive_range+front"),
    68	    "discern_design_floor": lambda T, B, cs, cq, a, d, r: DiscernDesignFloor(
    69	        T, B, a, rng=r("discern_style")),
    70	    "discern_design_floor+front": lambda T, B, cs, cq, a, d, r: DiscernDesignFloor(
    71	        T, B, a, rng=r("discern_style"), front=True, name="discern_design_floor+front"),
    72	}

