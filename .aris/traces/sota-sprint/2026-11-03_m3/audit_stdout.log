   278	                mk, T, B, a, rng=r(sn), name="", restart_base=False)))()
   279	        out[f"{nm}+RMM_noacq"] = (lambda mk=mk, sn=seed_name: (
   280	            lambda T, B, cs, cq, a, d, r: RestartMixtureMonitor(
   281	                mk, T, B, a, rng=r(sn), name="", keep_acquiring=False)))()
   282	    from controls import FixedModel as _Fixed
