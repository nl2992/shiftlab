   127	class RestartMixtureMonitor:
   128	    """Wrap any simulator Policy factory ``make(T, B, alpha, rng)`` with the RMM rule."""
   129	
   130	    def __init__(self, make_base, horizon: int, budget: int, alpha: float, *, rng,
   131	                 name: str, alpha_split: float = 0.5, alpha_rb: float | None = None,
   132	                 gap: int = 10, keep_acquiring: bool = True, restart_base: bool = True,
   133	                 p_min: float = 0.05, single_start: bool = False, pace_k: float = 1.0,
   134	                 w_first: float | None = None):
   135	        self.single_start = bool(single_start)
   136	        self.w_first = w_first
   137	        self.name = name
   138	        self.make_base, self.T, self.B = make_base, int(horizon), int(budget)
   139	        self.rng = rng
   140	        self.alpha_base = alpha * (1.0 - alpha_split)
   141	        self.alpha_det = alpha * alpha_split
   142	        self.alpha_rb = alpha if alpha_rb is None else alpha_rb
   143	        self.gap, self.keep, self.restart_base = int(gap), bool(keep_acquiring), bool(restart_base)
   144	        self.acq = HorizonWeightedPacer(horizon, budget, p_min=p_min, k=pace_k)
   145	        self.n_promotions = 0
   146	        self.deployed = 0
   147	        self.view = _View(0, self.T, False)
   148	        self.base = make_base(self.T, self.B, self.alpha_base, rng)
   149	        self.base_owned: set[int] = set()
   150	        self.own: set[int] = set()
   151	        self.queue: dict[int, int] = {}  # event id -> signed outcome, waiting for ordered entry
   152	        self.order: list[int] = []
   153	        self.det = self._new_detector()
   154	        self.t = 0
   155	        self.remaining = self.B
   156	        self.n_alarms = 0
   157	        self.override = False
   158	
   159	    def _new_detector(self) -> MixtureSRDetector:
   160	        if self.deployed == 0:  # next alarm would promote the challenger
   161	            a = self.alpha_det / (2.0 ** self.n_promotions)
   162	        else:
   163	            a = self.alpha_rb
   164	        return MixtureSRDetector(a, self.B, self.gap, single_start=self.single_start,
   165	                                 w_first=self.w_first)
   166	
   167	    # -- Policy protocol
   168	    def predict(self, event: Event) -> int:
   169	        self.t = event.t
   170	        k = self.view.model(int(self.base.predict(self.view.event(event))))
   171	        if self.override:
   172	            return self.deployed
   173	        if k != self.deployed:  # the base itself switched (under its own alpha_base)
   174	            self.deployed = k
   175	            self.det = self._new_detector()
   176	            self.order, self.queue = [], {}
   177	        return self.deployed
   178	
   179	    def request_labels(self, event: Event, remaining_budget: int) -> QueryRequest:
   180	        self.remaining = remaining_budget
   181	        dis = bool(event.model_predictions[0] != event.model_predictions[1])
   182	        req = self.base.request_labels(self.view.event(event), remaining_budget)
   183	        q_own = self.acq.propensity(event.t, remaining_budget, dis)
   184	        self.acq.note_event(dis)
   185	        if req.requested:
   186	            self.base_owned.add(event.t)
   187	            if dis:
   188	                self.order.append(event.t)
   189	            return req
   190	        if self.keep and dis and q_own > 0.0 and self.rng.random() < q_own:
   191	            self.own.add(event.t)
   192	            self.order.append(event.t)
   193	            return QueryRequest(requested=True, probability=q_own)
   194	        return QueryRequest(requested=False)
   195	
   196	    def observe(self, feedback: list[ReleasedFeedback]) -> None:
   197	        to_base = []
   198	        for fb in feedback:
   199	            d = int(fb.model_losses[0]) - int(fb.model_losses[1])
   200	            if fb.event_id in self.base_owned:
   201	                self.base_owned.discard(fb.event_id)
   202	                to_base.append(self.view.feedback(fb))
   203	            else:
   204	                self.own.discard(fb.event_id)
   205	            if d != 0:
   206	                self.queue[fb.event_id] = d
   207	        if to_base:
   208	            self.base.observe(to_base)
   209	        alarm = False
   210	        while self.order and self.order[0] in self.queue:
   211	            d = self.queue.pop(self.order.pop(0))
   212	            x = d if self.deployed == 0 else -d
   213	            if self.det.update(x):
   214	                alarm = True
   215	                break
   216	        if alarm:
   217	            self._switch()
   218	
   219	    def _switch(self) -> None:
   220	        self.n_alarms += 1
   221	        new = 1 - self.deployed
   222	        if new == 1:
   223	            self.n_promotions += 1
   224	        self.deployed = new
   225	        if self.restart_base:
   226	            h = self.T - (self.t + 1)
   227	            self.view = _View(self.t + 1, max(h, 1), swap=(new == 1))
   228	            self.base = self.make_base(max(h, 1), max(self.remaining, 0), self.alpha_base,
   229	                                       self.rng)
   230	            self.base_owned = set()
   231	        else:
   232	            self.override = True  # ablation: the stale base no longer controls deployment
   233	        self.det = self._new_detector()
   234	        self.order, self.queue = [], {}
   235	
   236	    def decision_state(self) -> str:
   237	        return f"dep={self.deployed};alarms={self.n_alarms}"
   238	
   239	    def state_dict(self) -> dict:
   240	        return {}
   241	
   242	    def load_state_dict(self, s: dict) -> None:
   243	        pass
