   221	class FamA(QSG):
   222	    """QSG skeleton with switchable evidence / density / clock mechanisms."""
   223	
   224	    def __init__(self, horizon, budget, alpha=0.05, *, rng, evidence="sui", density="front",
   225	                 dualclock=False, inflight=False, c_corr=0.25, min_pairs=8, fixed_gap=6,
   226	                 inflight_margin=2.0, sui_kw=None, rho_sig=0.0, name="A"):
   227	        self.evidence, self.density = evidence, density
   228	        self.dualclock, self.inflight = dualclock, inflight
   229	        self.c_corr, self.min_pairs, self.fixed_gap = c_corr, min_pairs, fixed_gap
   230	        self.inflight_margin = inflight_margin
   231	        self.rho_sig = rho_sig
   232	        self.sui_kw = sui_kw or {}
   233	        self.last = None  # last observed outcome (z, issue event), any segment
   234	        self.rel_z: list[int] = []
   235	        self.rel_t: list[int] = []
   236	        self.rho_hat = None
   237	        self.last_issue = -10**9
   238	        self.n_issued = 0
   239	        self.n_processed = 0
   240	        self.seg_k = 0  # outcomes processed in current segment
   241	        self.seg_hits = 0
   242	        super().__init__(horizon, budget, alpha, rng=rng, name=name)
   243	
   244	    # ------------------------------------------------------------------ evidence
   245	    def _mk(self):
   246	        if self.evidence == "sui":
   247	            return MarkovSUI(**self.sui_kw)
   248	        if self.evidence == "post0":
   249	            return PostZeroMixture(+1)
   250	        return IIDMixture(+1)
   251	
   252	    def _new_tests(self):
   253	        if self.deployed == 0:
   254	            self.e_up, self.e_dn = self._mk(), self._mk()
   255	        else:
   256	            self.e_up, self.e_dn = None, self._mk()
   257	        self.seg_k = self.seg_hits = 0
   258	
   259	    # ------------------------------------------------------------------ acquisition
   260	    def _gmin(self):
   261	        if self.density == "fixedgap":
   262	            return self.fixed_gap
   263	        if self.density != "adaptive" or self.rho_hat is None or self.rho_hat <= 0:
   264	            return 0
   265	        if self.rho_hat >= 1:
   266	            return 10**9
   267	        return int(math.ceil(math.log(self.c_corr) / math.log(self.rho_hat)))
   268	
   269	    def _inflight_enough(self):
   270	        if not self.inflight or self.seg_k < 20:
   271	            return False
   272	        pending = self.n_issued - self.n_processed
   273	        ph = (self.seg_hits + 0.5) / (self.seg_k + 1.0)
   274	        need = []
   275	        for e, side, thr in ((self.e_up, 1, 2.0 ** self.cycle / self.alpha),
   276	                             (self.e_dn, -1, 1.0 / self.alpha)):
   277	            if e is None:
   278	                continue
   279	            q = ph if side > 0 else 1.0 - ph
   280	            if q <= 0.52:
   281	                continue
   282	            kl = q * math.log(2 * q) + (1 - q) * math.log(2 * (1 - q))
   283	            need.append(max(math.log(thr) - math.log(max(e.value, 1e-300)), 0.0) / kl)
   284	        return bool(need) and pending >= self.inflight_margin * min(need) + 5
   285	
   286	    def request_labels(self, event, remaining_budget):
   287	        dis = bool(event.model_predictions[0] != event.model_predictions[1])
   288	        q = self.acq.propensity(event.t, remaining_budget, dis)
   289	        self.acq.note_event(dis)
   290	        if not dis or remaining_budget <= 0:
   291	            return QueryRequest(requested=False)
   292	        if not self.decided and self.front and remaining_budget > self.reserve:
   293	            if event.t - self.last_issue < self._gmin():
   294	                return QueryRequest(requested=False)
   295	            if not self._inflight_enough():
   296	                q = 1.0
   297	        elif self.decided and not self.monitor:
   298	            return QueryRequest(requested=False)
   299	        take = bool(self.rng.random() < q)
   300	        if take:
   301	            self.last_issue = event.t
   302	            self.n_issued += 1
   303	        return QueryRequest(requested=take, probability=q if take else 0.0)
   304	
   305	    # ------------------------------------------------------------------ observation
   306	    def _upd(self, test, side, z, e):
   307	        hit = z if side > 0 else 1 - z
   308	        prev, gap = None, 0
   309	        if self.last is not None:
   310	            prev = self.last[0] if side > 0 else 1 - self.last[0]
   311	            gap = e - self.last[1]
   312	        return test.update(hit, gap, prev)
   313	
   314	    def observe(self, feedback):
   315	        for fb in sorted(feedback, key=lambda f: f.event_id):
   316	            d = int(fb.model_losses[0]) - int(fb.model_losses[1])
   317	            if d == 0:
   318	                continue
   319	            z, e, t = int(d > 0), fb.event_id, fb.t_released
   320	            self.n_processed += 1
   321	            self.rel_z.append(z)
   322	            self.rel_t.append(e)
   323	            if fb.event_id >= self.seg:
   324	                self.seg_k += 1
   325	                self.seg_hits += z
   326	                if self.deployed == 0:
   327	                    up = self._upd(self.e_up, +1, z, e)
   328	                    dn = self._upd(self.e_dn, -1, z, e)
   329	                    if up >= 2.0 ** self.cycle / self.alpha:
   330	                        self.deployed, self.decided = 1, True
   331	                        self.seg = e + 1 if self.dualclock else t
   332	                        self.last = (z, e)
   333	                        self._new_tests()
   334	                        continue
   335	                    if dn >= 1.0 / self.alpha:
   336	                        self.decided = True
   337	                elif self.rollback and self._upd(self.e_dn, -1, z, e) >= 1.0 / self.alpha_r:
   338	                    self.deployed, self.decided, self.cycle = 0, False, self.cycle + 1
   339	                    self.seg = e + 1 if self.dualclock else t
   340	                    self.last = (z, e)
   341	                    self._new_tests()
   342	                    continue
   343	            self.last = (z, e)
   344	        if self.density == "adaptive" and len(self.rel_z) >= self.min_pairs + 1:
   345	            self.rho_hat = rho_mle(np.array(self.rel_z[-150:]), np.array(self.rel_t[-150:]),
   346	                                 sig=self.rho_sig)
   347	
   348	    def decision_state(self):
   349	        return f"dep={self.deployed};cycle={self.cycle};decided={self.decided}"
   350	
   351	
   352	def _f(name, **kw):
   353	    return lambda T, B, cs, cq, a, d, r: FamA(T, B, a, rng=r("QSG"), name=name, **kw)
