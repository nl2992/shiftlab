   436	def _point(name: str) -> dict:
   437	    import re
   438	
   439	    for pts in _HOST_POINTS.values():
   440	        if name in pts:
   441	            return dict(pts[name])
   442	    if "+pace_k" in name:
   443	        return {"base": "k", "k": float(name.split("+pace_k")[1])}
   444	    if "+frontfrac" in name:
   445	        return {"base": "frontfrac", "f": float(name.split("+frontfrac")[1])}
   446	    m = re.fullmatch(r"C1-k([\d.]+)", name)
   447	    if m:
   448	        return {"C1_kappa": float(m[1])}
   449	    m = re.fullmatch(r"C2-g([\d.]+)z([\d.]+)", name)
   450	    if m:
   451	        return {"C2_gamma": float(m[1]), "C2_zeta": float(m[2])}
   452	    m = re.fullmatch(r"C3-f([\d.]+)t([\d.]+)", name)
   453	    if m:
   454	        return {"C3_f": float(m[1]), "C3_tau": float(m[2])}
   455	    m = re.fullmatch(r"C4-k([\d.]+)", name)
   456	    if m:
   457	        return {"C4_k": float(m[1]), "C4_beta": None}
   458	    m = re.fullmatch(r"C4-b([\d.]+)k([\d.]+)", name)
   459	    if m:
   460	        return {"C4_k": float(m[2]), "C4_beta": float(m[1])}
   461	    m = re.fullmatch(r"C6-f([\d.]+)", name)
   462	    if m:
   463	        return {"C6_f2": float(m[1])}
   464	    raise ValueError(name)
