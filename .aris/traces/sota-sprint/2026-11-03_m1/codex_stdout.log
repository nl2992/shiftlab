--- scripts/failure_atlas_v2_flq/suite.py ---
     1	"""Failure Atlas v2 competitor suite and per-run metrics on the common streaming simulator.
     2	
     3	Every policy is the existing implementation in ``scripts/promising_directions/sota/competitors``;
     4	nothing here re-implements a competitor. Names follow the fidelity record in
     5	``docs/promising_directions/sota/SOTA_IMPLEMENTATION_VALIDATION.md``: an entry is called by its
     6	published name only where that document allows, otherwise it carries an adapter suffix.
     7	
     8	Not run on loss-only streams (no features exist to fit their nuisance models): Sawade et al.
     9	calibrated, Xu prediction-assisted, CAMS with contextual policies. CAMS is run with constant
    10	policies only, and variance minimisation with a uniform class prior, which in the binary
    11	two-model task is exact because its surrogate cancels (validation round 2).
    12	"""
    13	
    14	from __future__ import annotations
    15	
    16	import sys
    17	from pathlib import Path
    18	
    19	import numpy as np
    20	
    21	ROOT = Path(__file__).resolve().parents[2]
    22	SOTA = ROOT / "scripts/promising_directions/sota"
    23	for _p in (SOTA, SOTA / "competitors", SOTA.parent, Path(__file__).resolve().parent):
    24	    if str(_p) not in sys.path:
    25	        sys.path.insert(0, str(_p))
    26	
    27	from cams import CAMSDeploymentAdapter, stack_advice  # noqa: E402
    28	from certificate_stops import DiscernStyleStop, GatedDeploymentStop  # noqa: E402
    29	from controls import EconomicReplacement, FixedModel  # noqa: E402
    30	from model_picker import ModelPickerDeploymentAdapter  # noqa: E402
    31	from model_selector import ModelSelectorCausalAdapter  # noqa: E402
    32	from online_llm_picker import OnlineLLMPicker  # noqa: E402
    33	from simulator import policy_rng, run_episode  # noqa: E402
    34	from smcs import SMCSDeploymentPolicy  # noqa: E402
    35	from variance_min import VarianceMinStreamingIPW  # noqa: E402
    36	from xu_acquisition import XuAcquisitionPolicy  # noqa: E402
    37	
    38	# Display name -> (published-name status, family). "family" groups independently developed
    39	# approaches so that a shared failure can be counted across distinct lines of work.
    40	SUITE_INFO = {
    41	    "gated_deployment": ("Gated Deployment / off-policy CS adapter (Karampatziakis+21)", "anytime-CS"),
    42	    "discern_style": ("DISCERN-style certificate stop (no author code)", "anytime-CS"),
    43	    "SMCS+retain-incumbent": ("SMCS inference + retain-incumbent rule", "e-value-elimination"),
    44	    "model_picker_adapter": ("Model Picker deployment adapter", "online-bayes-selection"),
    45	    "model_selector_causal": ("Model Selector, causal record-gate adapter", "pool-active-selection"),
    46	    "online_llm_picker": ("Online LLM Picker (eps ours)", "online-bandit-selection"),
    47	    "xu_acquisition_only": ("Xu et al. acquisition-only adapter", "active-testing-betting"),
    48	    "cams_adapter": ("CAMS with constant policies only (adapter)", "expert-advice-selection"),
    49	    "variance_min_ipw": ("variance-min score + streaming IPW (not LURE)", "active-risk-estimation"),
    50	    "P7s_settled": ("P7s settled acquisition (ours, B3+)", "ours-prior"),
    51	    "CONTROL_never_switch": ("control", "control"),
    52	    "economic_replacement": ("control: development-tuned economic rule", "control"),
    53	}
    54	
    55	
    56	def build_suite(T, budget, cs, cq, alpha, delay, ep, seed_base, *, names=None, extra=None):
    57	    def r(nm):
    58	        return policy_rng(seed_base, ep, nm)
    59	
    60	    def p7s():
    61	        from b3_plus_policy import b1
    62	        from b3_plus_policy_adapter import P7sPolicy
    63	
    64	        return P7sPolicy(horizon=T, budget=budget, delay=delay, switch_cost=cs, label_price=cq,
    65	                         rng=r("P7s"), params=b1.Params(T=T, delay=delay, cq=cq, alpha=alpha))
    66	
    67	    makers = {
    68	        "gated_deployment": lambda: GatedDeploymentStop(T, budget, alpha, rng=r("gated_deployment")),
    69	        "discern_style": lambda: DiscernStyleStop(T, budget, alpha, 0.0, rng=r("discern_style")),
    70	        "SMCS+retain-incumbent": lambda: SMCSDeploymentPolicy(2, r("smcs"), alpha=alpha),
    71	        "model_picker_adapter": lambda: ModelPickerDeploymentAdapter(2, 2, r("model_picker")),
    72	        "model_selector_causal": lambda: ModelSelectorCausalAdapter(2, 2, r("model_selector")),
    73	        "online_llm_picker": lambda: OnlineLLMPicker(2, 2, rng=r("online_llm_picker")),
    74	        "xu_acquisition_only": lambda: XuAcquisitionPolicy("acquisition_only", r("xu"),
    75	                                                           delay=delay),
    76	        "cams_adapter": lambda: CAMSDeploymentAdapter(n_models=2, n_classes=2,
    77	                                                      advice_fn=stack_advice(2, []),
    78	                                                      rng=r("cams")),
    79	        "variance_min_ipw": lambda: VarianceMinStreamingIPW(2, 2, r("vmin"), rate=budget / T,
    80	                                                            class_prior=np.array([.5, .5])),
    81	        "P7s_settled": p7s,
    82	        "CONTROL_never_switch": lambda: FixedModel(0, name="CONTROL_never_switch"),
    83	        "economic_replacement": lambda: EconomicReplacement(T, budget, cs, rng=r("econ")),
    84	    }
    85	    if extra:
    86	        makers.update({k: (lambda f=f: f(T, budget, cs, cq, alpha, delay, r)) for k, f in extra.items()})
    87	    names = names or list(makers)
    88	    out = []
    89	    for n in names:
    90	        pol = makers[n]()
    91	        pol.name = n
    92	        out.append(pol)
    93	    return out
    94	
    95	
    96	def stream_from_losses(losses: np.ndarray, rng) -> tuple[np.ndarray, np.ndarray]:
    97	    """Balanced labels with predictions = label XOR loss: reproduces the loss stream exactly."""
    98	    labels = rng.integers(0, 2, losses.shape[0])
    99	    preds = labels[:, None].astype(int) ^ losses.astype(int)
   100	    return preds, labels
   101	
   102	
   103	def run_metrics(pol, losses, gain, *, delay, budget, cq, cs, stream_rng, oracle_cost=None,
   104	                exp_path=None) -> dict:
   105	    preds, labels = stream_from_losses(losses, stream_rng)
   106	    res = run_episode(pol, model_predictions=preds, labels=labels, delay=delay, budget=budget,
   107	                      label_price=cq, switch_cost=cs, trace=True)
   108	    if res.requested_labels > budget:
   109	        raise AssertionError(f"{pol.name} exceeded budget")
   110	    dep = np.fromiter((r["deployed_model"] for r in res.records), int, len(res.records))
   111	    req = np.fromiter((r["requested"] for r in res.records), int, len(res.records))
   112	    Tn = len(dep)
   113	    req_t = np.flatnonzero(req)
   114	    first1 = int(np.argmax(dep == 1)) if (dep == 1).any() else -1
   115	    better = gain > 0
   116	    worse = gain < 0
   117	    on_wrong = ((dep == 1) & worse) | ((dep == 0) & better)
   118	    m = {
   119	        "net": res.net_cost, "loss": res.prediction_loss, "labels": res.requested_labels,
   120	        "switches": res.deployment_switches, "first_deploy": first1, "final": int(dep[-1]),
   121	        "ever_promote": int(first1 >= 0),
   122	        "frac_on_better_when_better": float((dep[better] == 1).mean()) if better.any() else np.nan,
   123	        "frac_on_wrong": float(on_wrong.mean()),
   124	        "label_mean_t": float(req_t.mean()) if len(req_t) else np.nan,
   125	        "labels_by_500": int((req_t < 500).sum()),
   126	        "labels_after_1000": int((req_t >= 1000).sum()),
   127	        "exhaust_t": int(req_t[budget - 1]) if len(req_t) >= budget else Tn,
   128	        "excess_vs_expected_G": float(np.sum(np.where(dep == 1, -gain, 0.0))),
   129	    }
   130	    if oracle_cost is not None:
   131	        m["regret_hindsight"] = res.net_cost - oracle_cost
   132	    if exp_path is not None:
   133	        exp_cost = float(np.sum(losses[np.arange(Tn), exp_path])
   134	                         + cs * np.sum(np.diff(np.r_[0, exp_path]) != 0))
   135	        m["regret_expected_oracle"] = res.net_cost - exp_cost
   136	    return m

--- scripts/failure_atlas_v2_flq/qsg.py ---
     1	"""QSG: query-conditional started-mixture gate (Failure Atlas v2 standalone candidate).
     2	
     3	Decision problem: incumbent (0) vs frozen challenger (1), paid delayed labels under a hard budget,
     4	switching cost, false-promotion control at level alpha.
     5	
     6	Evidence (QCE). Queried disagreement outcomes ``z_k = 1[challenger correct]`` in request order.
     7	Promotion null ``H+ : p_t <= 1/2 for every t`` (challenger never better on a disagreement). For any
     8	``p' > 1/2``, ``LR(z) = (2p')^z (2(1-p'))^(1-z)`` has ``E[LR | past] = 1 + (2p'-1)(2p-1) <= 1``
     9	under H+, because the query decision is predictable and does not read the label.
    10	
    11	Started mixture. ``E_k = sum_{p' in grid} pi(p') sum_{j <= k} w_j prod_{i=j..k} LR_{p'}(z_i)``
    12	with ``w_j = 1/(j(j+1))`` and a fixed discrete grid ``pi``. ``E_k`` itself is not a
    13	supermartingale (a new start adds ``w_k``), but ``E_k + 1/(k+1)`` is a nonnegative test
    14	supermartingale starting at 1 under H+, since each started product is one and
    15	``sum_{j > k} w_j = 1/(k+1)``; Ville then gives ``P(sup_k E_k >= 1/a) <= a``. Starting points let evidence that accrues after an early
    16	unfavourable period count without an alpha reset (late improvement).
    17	
    18	Rollback. After promotion, the mirrored started mixture tests ``H- : p_t >= 1/2`` on outcomes
    19	issued after the promotion. A rejection rolls back. Cycle ``j = 1, 2, ...`` of promotion tests
    20	runs at ``alpha / 2^j`` so total false-promotion probability under H+ is at most alpha; rollback
    21	tests use ``alpha_r`` (a false rollback costs two switches, it is not a safety error).
    22	
    23	Acquisition. While undecided, every disagreement is queried (q = 1) until the budget is gone;
    24	after a verdict, the remaining budget is paced evenly over the expected remaining disagreements
    25	(monitoring for reversal / late improvement). All propensities are predictable.
    26	
    27	Parameters were set a priori (no tuning on discovery seeds): grid p' in {.55,.6,...,.95} uniform,
    28	alpha_r = .05, discard verdict at the mirrored mixture reaching 1/alpha.
    29	"""
    30	
    31	from __future__ import annotations
    32	
    33	import sys
    34	from pathlib import Path
    35	
    36	import numpy as np
    37	
    38	SOTA = Path(__file__).resolve().parents[1] / "promising_directions/sota"
    39	for _p in (SOTA, SOTA / "competitors"):
    40	    if str(_p) not in sys.path:
    41	        sys.path.insert(0, str(_p))
    42	
    43	from controls import PacedDisagreementAcquisition  # noqa: E402
    44	from simulator import QueryRequest  # noqa: E402
    45	
    46	GRID = np.arange(0.55, 0.951, 0.05)
    47	
    48	
    49	class StartedMixture:
    50	    """Started-mixture e-process for ``H: P(z=1) <= 1/2`` (``side=+1``) or ``>= 1/2`` (``-1``)."""
    51	
    52	    def __init__(self, side: int = 1, grid=GRID):
    53	        self.side = side
    54	        self.lr1 = np.log(2.0 * grid)  # log LR when the favoured outcome occurs
    55	        self.lr0 = np.log(2.0 * (1.0 - grid))
    56	        self.pi = np.full(len(grid), 1.0 / len(grid))
    57	        self.S = np.zeros(len(grid))
    58	        self.k = 0
    59	
    60	    def update(self, z: int) -> float:
    61	        self.k += 1
    62	        w = 1.0 / (self.k * (self.k + 1))
    63	        hit = z if self.side > 0 else 1 - z
    64	        self.S = (self.S + w) * np.exp(self.lr1 if hit else self.lr0)
    65	        return self.value
    66	
    67	    @property
    68	    def value(self) -> float:
    69	        return float(self.pi @ self.S)
    70	
    71	
    72	class QSG:
    73	    def __init__(self, horizon, budget, alpha=0.05, *, rng, alpha_r=0.05, front=True,
    74	                 started=True, rollback=True, monitor=True, reserve=0.0, name="QSG"):  # fmt: skip
    75	        self.name = name
    76	        self.T, self.B, self.alpha, self.alpha_r = horizon, budget, alpha, alpha_r
    77	        self.rng = rng
    78	        self.front, self.started, self.rollback, self.monitor = front, started, rollback, monitor
    79	        self.reserve = int(round(reserve * budget))  # labels kept back from front-loading
    80	        self.acq = PacedDisagreementAcquisition(horizon, budget)
    81	        self.deployed = 0
    82	        self.cycle = 1
    83	        self.decided = False  # a verdict in the current cycle (promote or discard)
    84	        self.seg = 0  # outcomes issued before seg are ignored (new test after a decision)
    85	        self._new_tests()
    86	
    87	    def _new_tests(self):
    88	        mk = (lambda s: StartedMixture(s)) if self.started else (lambda s: _Fixed(s))
    89	        if self.deployed == 0:
    90	            self.e_up, self.e_dn = mk(+1), mk(-1)  # promote / discard
    91	        else:
    92	            self.e_up, self.e_dn = None, mk(-1)  # rollback test
    93	
    94	    def predict(self, event):
    95	        return self.deployed
    96	
    97	    def request_labels(self, event, remaining_budget):
    98	        dis = bool(event.model_predictions[0] != event.model_predictions[1])
    99	        q = self.acq.propensity(event.t, remaining_budget, dis)
   100	        self.acq.note_event(dis)
   101	        if not dis or remaining_budget <= 0:
   102	            return QueryRequest(requested=False)
   103	        if not self.decided and self.front and remaining_budget > self.reserve:
   104	            q = 1.0
   105	        elif self.decided and not self.monitor:
   106	            return QueryRequest(requested=False)
   107	        take = bool(self.rng.random() < q)
   108	        return QueryRequest(requested=take, probability=q if take else 0.0)
   109	
   110	    def observe(self, feedback):
   111	        for fb in sorted(feedback, key=lambda f: f.event_id):
   112	            if fb.event_id < self.seg:
   113	                continue
   114	            d = int(fb.model_losses[0]) - int(fb.model_losses[1])
   115	            if d == 0:
   116	                continue
   117	            z = int(d > 0)
   118	            t = fb.t_released
   119	            if self.deployed == 0:
   120	                up = self.e_up.update(z)
   121	                dn = self.e_dn.update(z)
   122	                if up >= 2.0 ** self.cycle / self.alpha:
   123	                    # a promotion is a verdict: the rollback test runs at the paced monitoring
   124	                    # rate (dev-stage fix 2026-11-03; v0 kept front-loading here and exhausted
   125	                    # the budget before any reversal could be seen)
   126	                    self.deployed, self.decided, self.seg = 1, True, t
   127	                    self._new_tests()
   128	                elif dn >= 1.0 / self.alpha:
   129	                    self.decided = True  # discard: keep incumbent, drop to monitoring rate
   130	            elif self.rollback:
   131	                if self.e_dn.update(z) >= 1.0 / self.alpha_r:
   132	                    self.deployed, self.decided, self.seg = 0, False, t
   133	                    self.cycle += 1
   134	                    self._new_tests()
   135	
   136	    def decision_state(self):
   137	        return f"dep={self.deployed};cycle={self.cycle};decided={self.decided}"
   138	
   139	    def state_dict(self):
   140	        return {}
   141	
   142	    def load_state_dict(self, s):
   143	        pass
   144	
   145	
   146	class _Fixed(StartedMixture):
   147	    """Ablation: plain (unstarted) mixture likelihood ratio, all mass on start 1."""
   148	
   149	    def update(self, z):
   150	        self.k += 1
   151	        if self.k == 1:
   152	            self.S = np.ones_like(self.S)
   153	        hit = z if self.side > 0 else 1 - z
   154	        self.S = self.S * np.exp(self.lr1 if hit else self.lr0)
   155	        return self.value
   156	
   157	
   158	EXTRA = {
   159	    "QSG": lambda T, B, cs, cq, a, d, r: QSG(T, B, a, rng=r("QSG")),
   160	    "QSG-no_front": lambda T, B, cs, cq, a, d, r: QSG(T, B, a, rng=r("QSG"), front=False,
   161	                                                      name="QSG-no_front"),
   162	    "QSG-no_started": lambda T, B, cs, cq, a, d, r: QSG(T, B, a, rng=r("QSG"), started=False,
   163	                                                        name="QSG-no_started"),
   164	    "QSG-no_rollback": lambda T, B, cs, cq, a, d, r: QSG(T, B, a, rng=r("QSG"), rollback=False,
   165	                                                         name="QSG-no_rollback"),
   166	    "QSG-r25": lambda T, B, cs, cq, a, d, r: QSG(T, B, a, rng=r("QSG"), reserve=0.25,
   167	                                                 name="QSG-r25"),
   168	    "QSG-no_monitor": lambda T, B, cs, cq, a, d, r: QSG(T, B, a, rng=r("QSG"), monitor=False,
   169	                                                        name="QSG-no_monitor"),
   170	}
   171	
   172	
   173	class EnvelopeMixture(StartedMixture):
   174	    """Started mixture against a declared Markov-persistence envelope (Atlas v1 proposal).
   175	
   176	    Null class: the disagreement-outcome sign is a Markov chain in event time with stationary
   177	    P(z=1) <= 1/2 (side +1) and persistence <= rho_bar. Given the previous queried outcome and the
   178	    event gap g, ``P(z=1 | past) <= u = 1/2 + rho_bar^g / 2`` after a favourable outcome and
   179	    ``<= 1/2`` otherwise. Each grid component bets only where ``p' > u``, with
   180	    ``LR = (p'/u)^z ((1-p')/(1-u))^(1-z)``, whose conditional mean is <= 1 for any v <= u.
   181	    """
   182	
   183	    def __init__(self, side=1, rho_bar=0.8, grid=GRID):
   184	        super().__init__(side, grid)
   185	        self.grid = np.asarray(grid)
   186	        self.rho_bar = rho_bar
   187	        self.prev = None  # (hit, event time)
   188	
   189	    def update_at(self, z, t):
   190	        self.k += 1
   191	        w = 1.0 / (self.k * (self.k + 1))
   192	        hit = z if self.side > 0 else 1 - z
   193	        u = 0.5
   194	        if self.prev is not None and self.prev[0] == 1:
   195	            u = 0.5 + 0.5 * self.rho_bar ** max(t - self.prev[1], 1)
   196	        active = self.grid > u
   197	        lr = np.ones_like(self.grid)
   198	        g = self.grid[active]
   199	        lr[active] = (g / u) if hit else ((1.0 - g) / (1.0 - u))
   200	        self.S = (self.S + w) * lr
   201	        self.prev = (hit, t)
   202	        return self.value
   203	
   204	
   205	class QSGEnvelope(QSG):
   206	    def __init__(self, *a, rho_bar=0.8, **kw):
   207	        self.rho_bar = rho_bar
   208	        super().__init__(*a, **kw)
   209	
   210	    def _new_tests(self):
   211	        mk = lambda s: EnvelopeMixture(s, self.rho_bar)  # noqa: E731
   212	        if self.deployed == 0:
   213	            self.e_up, self.e_dn = mk(+1), mk(-1)
   214	        else:
   215	            self.e_up, self.e_dn = None, mk(-1)
   216	
   217	    def observe(self, feedback):
   218	        # same as QSG.observe, but passes the issuing event time to the envelope
   219	        for fb in sorted(feedback, key=lambda f: f.event_id):
   220	            if fb.event_id < self.seg:
   221	                continue
   222	            d = int(fb.model_losses[0]) - int(fb.model_losses[1])
   223	            if d == 0:
   224	                continue
   225	            z, t, e = int(d > 0), fb.t_released, fb.event_id
   226	            if self.deployed == 0:
   227	                up = self.e_up.update_at(z, e)
   228	                dn = self.e_dn.update_at(z, e)
   229	                if up >= 2.0 ** self.cycle / self.alpha:
   230	                    self.deployed, self.decided, self.seg = 1, True, t
   231	                    self._new_tests()
   232	                elif dn >= 1.0 / self.alpha:
   233	                    self.decided = True
   234	            elif self.rollback and self.e_dn.update_at(z, e) >= 1.0 / self.alpha_r:
   235	                self.deployed, self.decided, self.seg = 0, False, t
   236	                self.cycle += 1
