   131	def main(argv=None):
   132	    ap = argparse.ArgumentParser(description=__doc__)
   133	    ap.add_argument("--kind", choices=("synthetic", "real"), default="synthetic")
   134	    ap.add_argument("--regimes", required=True)
   135	    ap.add_argument("--policies", required=True)
   136	    ap.add_argument("--seeds", type=int, default=20)
   137	    ap.add_argument("--seed-base", type=int, default=DEV_SEED_BASE)
   138	    ap.add_argument("--workers", type=int, default=max(1, mp.cpu_count() - 2))
   139	    ap.add_argument("--out", required=True)
   140	    a = ap.parse_args(argv)
   141	    from registry import EXTRA, IMPORT_ERRORS
   142	
   143	    names = [x for x in a.policies.split(",") if x]
   144	    unknown = [n for n in names if n not in EXTRA and n not in (
   145	        "gated_deployment", "discern_style", "SMCS+retain-incumbent", "model_picker_adapter",
   146	        "model_selector_causal", "online_llm_picker", "xu_acquisition_only", "cams_adapter",
   147	        "variance_min_ipw", "P7s_settled", "CONTROL_never_switch", "economic_replacement")]
   148	    if unknown:
   149	        sys.exit(f"unknown policies {unknown}; import errors: {IMPORT_ERRORS}")
   150	    regimes = [x for x in a.regimes.split(",") if x]
   151	    jobs = []
   152	    for r in regimes:
   153	        if a.kind == "synthetic":
   154	            jobs += [("synthetic", r, 0, s, a.seed_base, names) for s in range(a.seeds)]
   155	        else:
   156	            K = np.load(_loss_file(r))["l0"].shape[0]
   157	            jobs += [("real", r, e, s, a.seed_base, names) for e in range(K) for s in range(a.seeds)]
   158	    out = Path(a.out)
   159	    out.mkdir(parents=True, exist_ok=True)
   160	    t0 = time.time()
   161	    with open(out / "records.jsonl", "w") as f, mp.Pool(a.workers) as pool:
   162	        for rows in pool.imap_unordered(_job, jobs, chunksize=2):
   163	            for row in rows:
   164	                f.write(json.dumps(row) + "\n")
   165	    srcs = {p.name: hashlib.sha256(p.read_bytes()).hexdigest()[:16]
   166	            for p in sorted(HERE.glob("*.py"))}
   167	    manifest = {"argv": vars(a), "contract": CONTRACT, "git": _git_rev(), "sources": srcs,
   168	                "import_errors": IMPORT_ERRORS, "n_jobs": len(jobs),
   169	                "seconds": round(time.time() - t0, 1)}
   170	    (out / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
   171	    print(f"done {len(jobs)} jobs in {time.time() - t0:.0f}s -> {out}")
   172	
