    34	from suite import build_suite, stream_from_losses  # noqa: E402  (also adds the simulator path)
    35	from simulator import run_episode  # noqa: E402
    36	
    37	LOSS_DIR = ROOT / "data/atlas_v2_losses"
    38	FRESH_DIR = ROOT / "data/sprint_fresh_losses"  # fresh external-validation streams (aeb2d4f)
    39	FRESH_DELAYS = {"metro": 24, "beijing_pm25": 24, "bike_hour": 24, "appliances": 144,
    40	                "household_power": 144}  # = fresh_real.DELAYS, registered before any policy run
    41	
