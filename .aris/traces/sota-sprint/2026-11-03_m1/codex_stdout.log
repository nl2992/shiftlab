--- scripts/sota_sprint/fresh_real.py ---
     1	"""Fresh real chronological loss streams for final external validation (SOTA sprint, Agent E).
     2	
     3	Builds frozen incumbent/challenger loss pairs on five public UCI datasets never used before in
     4	ShiftLab, mirroring scripts/promising_directions/b3_real_data.py::build_fetched:
     5	
     6	* rows in chronological order, n rows;
     7	* incumbent  = LogisticRegression(max_iter=300, C=1.0) fit on rows [0, 0.15n);
     8	* challenger = HistGradientBoostingClassifier(max_iter=100, max_depth=4, lr=0.1, rs=0)
     9	  fit on rows [0, 0.30n);
    10	* label threshold (training-period median) and preprocessing (StandardScaler + OneHot) fit on
    11	  rows [0, 0.30n) only;
    12	* episodes: consecutive non-overlapping 2000-event windows from 0.30n, at most 20 per dataset;
    13	* losses l = 1[pred != y] (int8).
    14	
    15	This script fits models only. It never runs a ShiftLab policy or the screen runner.
    16	
    17	    uv run python scripts/sota_sprint/fresh_real.py            # download (if absent) + build
    18	"""
    19	
    20	from __future__ import annotations
    21	
    22	import gzip
    23	import hashlib
    24	import io
    25	import json
    26	import urllib.request
    27	import zipfile
    28	from pathlib import Path
    29	
    30	import numpy as np
    31	import pandas as pd
    32	from sklearn.ensemble import HistGradientBoostingClassifier
    33	from sklearn.linear_model import LogisticRegression
    34	
    35	ROOT = Path(__file__).resolve().parents[2]
    36	RAW = ROOT / "data/raw/sprint_fresh"
    37	OUT = ROOT / "data/sprint_fresh_losses"
    38	T_EP = 2000
    39	MAX_EPS = 20
    40	
    41	SOURCES = {
    42	    "metro": (492, "metro+interstate+traffic+volume"),
    43	    "beijing_pm25": (381, "beijing+pm2+5+data"),
    44	    "bike_hour": (275, "bike+sharing+dataset"),
    45	    "appliances": (374, "appliances+energy+prediction"),
    46	    "household_power": (235, "individual+household+electric+power+consumption"),
    47	}
    48	# Registered label delay, in events: one day of natural time.
    49	DELAYS = {
    50	    "metro": 24,  # hourly
    51	    "beijing_pm25": 24,  # hourly
    52	    "bike_hour": 24,  # hourly
    53	    "appliances": 144,  # 10-minute
    54	    "household_power": 144,  # 10-minute means
    55	}
    56	LICENSE = "CC BY 4.0 (UCI Machine Learning Repository)"
    57	
    58	
    59	def url(name: str) -> str:
    60	    uid, slug = SOURCES[name]
    61	    return f"https://archive.ics.uci.edu/static/public/{uid}/{slug}.zip"
    62	
    63	
    64	def raw_zip(name: str) -> Path:
    65	    p = RAW / f"uci_{SOURCES[name][0]}" / "raw.zip"
    66	    if not p.exists():
    67	        p.parent.mkdir(parents=True, exist_ok=True)
    68	        urllib.request.urlretrieve(url(name), p)
    69	    return p
    70	
    71	
    72	def sha256(p: Path) -> str:
    73	    h = hashlib.sha256()
    74	    with p.open("rb") as fh:
    75	        for b in iter(lambda: fh.read(1 << 20), b""):
    76	            h.update(b)
    77	    return h.hexdigest()
    78	
    79	
    80	def member(name: str, fname: str) -> bytes:
    81	    with zipfile.ZipFile(raw_zip(name)) as z:
    82	        return z.read(fname)
    83	
    84	
    85	def calendar(df: pd.DataFrame, ts: pd.Series) -> pd.DataFrame:
    86	    df = df.copy()
    87	    df["hour"], df["weekday"], df["month"] = ts.dt.hour, ts.dt.weekday, ts.dt.month
    88	    return df
    89	
    90	
    91	# ----------------------------------------------------------------------------- loaders
    92	# Each returns (features DataFrame, raw target Series, timestamps), chronologically sorted.
    93	def load_metro():
    94	    df = pd.read_csv(
    95	        io.BytesIO(gzip.decompress(member("metro", "Metro_Interstate_Traffic_Volume.csv.gz")))
    96	    )
    97	    ts = pd.to_datetime(df.pop("date_time"))
    98	    order = np.argsort(ts.to_numpy(), kind="stable")
    99	    df, ts = df.iloc[order].reset_index(drop=True), ts.iloc[order].reset_index(drop=True)
   100	    y = df.pop("traffic_volume")
   101	    df["holiday"] = df["holiday"].fillna("None").astype(str)
   102	    return calendar(df, ts), y, ts
   103	
   104	
   105	def load_beijing_pm25():
   106	    df = pd.read_csv(io.BytesIO(member("beijing_pm25", "PRSA_data_2010.1.1-2014.12.31.csv")))
   107	    df = df[df["pm2.5"].notna()].reset_index(drop=True)
   108	    ts = pd.to_datetime(df[["year", "month", "day", "hour"]])
   109	    y = df.pop("pm2.5")
   110	    df = df.drop(columns=["No", "year", "month", "day", "hour"])
   111	    return calendar(df, ts), y, ts
   112	
   113	
   114	def load_bike_hour():
   115	    df = pd.read_csv(io.BytesIO(member("bike_hour", "hour.csv")))
   116	    ts = pd.to_datetime(df["dteday"]) + pd.to_timedelta(df["hr"], unit="h")
   117	    y = df.pop("cnt")
   118	    # casual + registered = cnt (leakage); yr is a trend index; calendar re-derived below.
   119	    df = df.drop(
   120	        columns=["instant", "dteday", "yr", "casual", "registered", "mnth", "hr", "weekday"]
   121	    )
   122	    return calendar(df, ts), y, ts
   123	
   124	
   125	def load_appliances():
   126	    df = pd.read_csv(io.BytesIO(member("appliances", "energydata_complete.csv")))
   127	    ts = pd.to_datetime(df.pop("date"))
   128	    y = df.pop("Appliances").astype(float)
   129	    df = df.drop(columns=["rv1", "rv2"])  # documented random variables
   130	    return calendar(df, ts), y, ts
   131	
   132	
   133	def load_household_power():
   134	    raw = member("household_power", "household_power_consumption.txt")
   135	    df = pd.read_csv(io.BytesIO(raw), sep=";", na_values="?", low_memory=False)
   136	    ts = pd.to_datetime(df.pop("Date") + " " + df.pop("Time"), format="%d/%m/%Y %H:%M:%S")
   137	    df = df.set_index(ts).sort_index().astype(float)
   138	    df = df.resample("10min").mean().dropna()  # 10-minute means; drop bins with no reading
   139	    ts = pd.Series(df.index, name="ts").reset_index(drop=True)
   140	    df = df.reset_index(drop=True)
   141	    y = df.pop("Global_active_power")
   142	    # Global_intensity ~ P/V and the three sub-meterings are contemporaneous components of the
   143	    # target; drop as leakage. Keep reactive power, voltage and calendar.
   144	    df = df.drop(columns=["Global_intensity", "Sub_metering_1", "Sub_metering_2", "Sub_metering_3"])
   145	    return calendar(df, ts), y, ts
   146	
   147	
   148	LOADERS = {
   149	    "metro": load_metro,
   150	    "beijing_pm25": load_beijing_pm25,
   151	    "bike_hour": load_bike_hour,
   152	    "appliances": load_appliances,
   153	    "household_power": load_household_power,
   154	}
   155	CATEGORICAL = {
   156	    "metro": ["holiday", "weather_main", "weather_description"],
   157	    "beijing_pm25": ["cbwd"],
   158	}
   159	
   160	
   161	def prep(xtr: pd.DataFrame, cat: list[str]):
   162	    """Train-only preprocessing (as b3_real_data.prep)."""
   163	    from sklearn.preprocessing import OneHotEncoder, StandardScaler
   164	
   165	    num = [c for c in xtr.columns if c not in cat]
   166	    sc = StandardScaler().fit(xtr[num])
   167	    oh = (
   168	        OneHotEncoder(handle_unknown="ignore", min_frequency=20, sparse_output=False).fit(xtr[cat])
   169	        if cat
   170	        else None
   171	    )
   172	
   173	    def f(a):
   174	        parts = [sc.transform(a[num])]
   175	        if oh is not None:
   176	            parts.append(oh.transform(a[cat]))
   177	        return np.hstack(parts)
   178	
   179	    return f
   180	
   181	
   182	def build(name: str) -> dict:
   183	    x, yraw, ts = LOADERS[name]()
   184	    cat = CATEGORICAL.get(name, [])
   185	    for c in cat:
   186	        x[c] = x[c].astype(str)
   187	    n = len(x)
   188	    n15, n30 = int(0.15 * n), int(0.30 * n)
   189	    thr = float(np.median(yraw.to_numpy()[:n30]))
   190	    y = (yraw.to_numpy() > thr).astype(int)
   191	    f = prep(x.iloc[:n30], cat)
   192	    m0 = LogisticRegression(max_iter=300, C=1.0).fit(f(x.iloc[:n15]), y[:n15])
   193	    m1 = HistGradientBoostingClassifier(
   194	        max_iter=100, max_depth=4, learning_rate=0.1, random_state=0
   195	    ).fit(f(x.iloc[:n30]), y[:n30])
   196	    k = min(MAX_EPS, (n - n30) // T_EP)
   197	    starts = np.array([n30 + i * T_EP for i in range(k)], dtype=np.int64)
   198	    end = n30 + k * T_EP
   199	    xe = f(x.iloc[n30:end])
   200	    l0 = (m0.predict(xe) != y[n30:end]).astype(np.int8).reshape(k, T_EP)
   201	    l1 = (m1.predict(xe) != y[n30:end]).astype(np.int8).reshape(k, T_EP)
   202	    OUT.mkdir(parents=True, exist_ok=True)
   203	    out = OUT / f"{name}.npz"
   204	    np.savez(out, l0=l0, l1=l1, starts=starts)
   205	    content = hashlib.sha256(l0.tobytes() + l1.tobytes() + starts.tobytes()).hexdigest()
   206	    adv = (l0.astype(float) - l1).mean(axis=1)  # incumbent loss - challenger loss
   207	    return {
   208	        "dataset": name,
   209	        "uci_id": SOURCES[name][0],
   210	        "url": url(name),
   211	        "license": LICENSE,
   212	        "raw_sha256": sha256(raw_zip(name)),
   213	        "npz": str(out.relative_to(ROOT)),
   214	        "npz_sha256": sha256(out),
   215	        "array_content_sha256": content,
   216	        "n_rows": n,
   217	        "time_span": [str(ts.iloc[0]), str(ts.iloc[-1])],
   218	        "n_features_raw": int(x.shape[1]),
   219	        "label_threshold_train_median": thr,
   220	        "train_pos_rate": float(y[:n30].mean()),
   221	        "eval_pos_rate": float(y[n30:end].mean()),
   222	        "n15": n15,
   223	        "n30": n30,
   224	        "K": int(k),
   225	        "eval_end": int(end),
   226	        "delay_events": DELAYS[name],
   227	        "incumbent_err": float(l0.mean()),
   228	        "challenger_err": float(l1.mean()),
   229	        "disagreement": float((l0 != l1).mean()),
   230	        "mean_adv_per_episode": [round(float(a), 4) for a in adv],
   231	        "n_challenger_better": int((adv > 0).sum()),
   232	        "n_tied": int((adv == 0).sum()),
   233	    }
   234	
   235	
   236	def main() -> None:
   237	    stats = [build(nm) for nm in LOADERS]
   238	    (OUT / "stats.json").write_text(json.dumps(stats, indent=1) + "\n")
   239	    for s in stats:
   240	        print(
   241	            f"{s['dataset']:16s} n={s['n_rows']:6d} K={s['K']:2d} err0={s['incumbent_err']:.3f} "
   242	            f"err1={s['challenger_err']:.3f} dis={s['disagreement']:.3f} "
   243	            f"better={s['n_challenger_better']}/{s['K']}"
   244	        )
   245	
   246	
   247	if __name__ == "__main__":
   248	    main()

