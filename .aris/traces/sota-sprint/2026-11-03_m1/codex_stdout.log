    94	def _job(args):
    95	    kind, name, ep, seed, seed_base, names = args
    96	    from registry import EXTRA
    97	
    98	    if kind == "synthetic":
    99	        R, b = parse_regime(name)
   100	        budget = b or CONTRACT["budget"]
   101	        losses = R.sample(np.random.default_rng(np.random.SeedSequence(
   102	            [seed_base, _h(R.name), seed])))
   103	        gain, delay = R.truth_gain(), R.delay
   104	    else:
   105	        z = np.load(_loss_file(name))
   106	        losses = np.stack([z["l0"][ep], z["l1"][ep]], axis=1).astype(np.int8)
   107	        gain = np.full(losses.shape[0], float((losses[:, 0].astype(int) - losses[:, 1]).mean()))
   108	        delay, budget = {**REAL_DELAYS, **FRESH_DELAYS}[name], CONTRACT["budget"]
   109	    rows = []
   110	    run_ep = ep * 100_000 + seed
   111	    for pol in build_suite(losses.shape[0], budget, CONTRACT["cs"], CONTRACT["cq"],
   112	                           CONTRACT["alpha"], delay, run_ep, seed_base + _h(name) % 1000,
   113	                           names=names, extra=EXTRA):
   114	        stream_rng = np.random.default_rng([seed_base, _h(name), ep, seed, 7])
   115	        m = metrics(pol, losses, gain, delay=delay, budget=budget, cq=CONTRACT["cq"],
   116	                    cs=CONTRACT["cs"], stream_rng=stream_rng)
   117	        rows.append({"kind": kind, "regime": name, "ep": ep, "seed": seed, "policy": pol.name,
   118	                     "delay": delay, "budget": budget, **m})
   119	    return rows
