    48	        pol = fam_a.FamA(T, B, a, rng=r("QSG"), name=name, evidence="sui", density="adaptive",
    49	                         rho_sig=2.0, sui_kw=fam_a._B, **kw)
    50	        pol.reserve = int(round(reserve * B))  # QSG semantics: kept back from front-loading
    51	        return pol
