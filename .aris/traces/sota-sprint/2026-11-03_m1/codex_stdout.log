   122	def _git_rev() -> str:
   123	    try:
   124	        rev = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()
   125	        dirty = subprocess.call(["git", "diff", "--quiet", "--", "scripts"], cwd=ROOT) != 0
   126	        return rev + ("+dirty" if dirty else "")
   127	    except Exception:
   128	        return "unknown"
