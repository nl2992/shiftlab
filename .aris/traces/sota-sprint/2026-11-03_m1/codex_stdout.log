     1	"""Merge family ledgers into the 24-candidate registry and build the machine-readable leaderboard.
     2	
     3	Inputs: ``docs/sota_sprint/candidates.json`` (registry) and ``docs/sota_sprint/family_*/ledger.json``
     4	(each a list or dict of entries with at least ``id`` and ``status``). Optional validation summaries
     5	are merged from ``docs/sota_sprint/validation/leaderboard_inputs.json``. Development and validated
     6	results are kept in separate fields; a candidate counts as executed only with a results artifact.
     7	
     8	    uv run python scripts/sota_sprint/leaderboard.py
     9	"""
    10	
    11	from __future__ import annotations
    12	
    13	import json
    14	from pathlib import Path
    15	
    16	ROOT = Path(__file__).resolve().parents[2]
    17	DOCS = ROOT / "docs/sota_sprint"
    18	IDS = [f"{f}{i}" for f in "ABCD" for i in range(1, 7)]
    19	FIELDS = ["id", "parent", "added_components", "intended_failure_mechanism", "implementation",
    20	          "status", "dev_environments", "n_runs", "dev_cost_vs_best_certified",
    21	          "dev_efficacy", "null_safety", "strongest_comparator_beaten", "novelty",
    22	          "ablation", "real_data", "validation", "next_action", "results_artifact"]
    23	
    24	
    25	def _entries(path: Path) -> list[dict]:
    26	    d = json.loads(path.read_text())
    27	    if isinstance(d, dict):
    28	        d = d.get("candidates", d.get("entries", d))
    29	        d = list(d.values()) if isinstance(d, dict) else d
    30	    return [e for e in d if isinstance(e, dict) and "id" in e]
    31	
    32	
    33	def main():
    34	    reg = json.loads((DOCS / "candidates.json").read_text())
    35	    for led in sorted(DOCS.glob("family_*/ledger.json")):
    36	        for e in _entries(led):
    37	            if e["id"] in reg:
    38	                reg[e["id"]].update({k: v for k, v in e.items() if v is not None})
    39	                reg[e["id"]]["ledger"] = str(led.relative_to(ROOT))
    40	    val = DOCS / "validation/leaderboard_inputs.json"
    41	    if val.exists():
    42	        for cid, v in json.loads(val.read_text()).items():
    43	            reg.setdefault(cid, {"id": cid}).update({"validation": v})
    44	    (DOCS / "candidates.json").write_text(json.dumps(reg, indent=1, default=str) + "\n")
    45	    executed = [i for i in IDS if reg[i].get("results_artifact") and reg[i]["status"] not in (
    46	        "NOT_IMPLEMENTED", "IMPLEMENTED", "BLOCKED")]
    47	    board = {"executed": executed, "missing": [i for i in IDS if i not in executed],
    48	             "rows": [{k: reg[c].get(k) for k in FIELDS} for c in reg]}
    49	    (DOCS / "leaderboard.json").write_text(json.dumps(board, indent=1, default=str) + "\n")
    50	    print(f"{len(executed)}/24 mandatory candidates executed; missing: {board['missing']}")
    51	    for c in reg:
    52	        print(f"{c:>8} {reg[c].get('status', ''):<20} {str(reg[c].get('disposition', ''))[:90]}")
    53	
    54	
    55	if __name__ == "__main__":
    56	    main()
     1	"""Mechanical audit of the sprint's mandatory execution gate (brief section 14A) from RAW records.
     2	
     3	For each of the 24 candidates it checks, from saved records under ``outputs/sota_sprint/{A,B,C,D,X}``
     4	(not from ledger prose): executed in the simulator; >= 4 diagnostic environments; paired seeds
     5	(same seed set as a published comparator in the same run); >= 1 null environment; >= 1 environment
     6	outside the intended advantage region; a mechanism ablation row (another policy whose name extends
     7	the candidate's, or a registered ablation alias); cost/efficacy/safety metrics present; and a
