    43	def _loss_file(name: str) -> Path:
    44	    return (FRESH_DIR if name in FRESH_DELAYS else LOSS_DIR) / f"{name}.npz"
    45	REAL_DELAYS = {"rialto": 100, "spam": 50, "weather": 1, "openml_ldpa": 100, "uci_occupancy": 100,
    46	               "airlines": 100, "bank": 100, "elec2": 48, "criteo": 100}
