   277	class DiscernC(_Ctl, DiscernStyleStop):
   278	    c_beta = 1.0  # PrPl-EB with lam_max binding: width ~ 1/t
   279	
   280	    def __init__(self, T, B, alpha, cs, cq, delay, ctl, *, rng, name, p_min=0.25):
   281	        DiscernStyleStop.__init__(self, T, B, alpha, 0.0, rng=rng, p_min=p_min, name=name)
   282	        self._c_init(T, B, cs, cq, delay, ctl)
