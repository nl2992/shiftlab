    99	class MarkovSUI:
   100	    """Started sequential-universal-inference e-process for H_side (see module docstring).
   101	
   102	    ``update(hit, gap, prev)``: ``hit`` is the outcome in the tested direction (z for side +1,
   103	    1 - z for side -1), ``prev`` the immediately preceding observed outcome in the same coding
   104	    (None if this is the first outcome of the whole stream), ``gap`` the event gap to it.
   105	    """
   106	
   107	    def __init__(self, stride=10, started=True, rho_max=1.0, use_gap=True, n_rho=300, n_p=100,
   108	                 rho_prior=ALT_RHO_PRIOR, w_first=0.5):
   109	        pe, re_ = _p_edges(n_p), _rho_edges(n_rho)
   110	        re_ = re_[re_ <= rho_max + 1e-12]
   111	        if re_[-1] < rho_max:
   112	            re_ = np.r_[re_, rho_max]
   113	        self.plo, self.phi = pe[:-1][None, :], pe[1:][None, :]  # (1, P)
   114	        self.rlo, self.rhi = re_[:-1][:, None], re_[1:][:, None]  # (R, 1)
   115	        self.cum = np.zeros((len(re_) - 1, len(pe) - 1))  # cumulative cell log upper bound
   116	        ap, ar = np.meshgrid(ALT_P, ALT_RHO)
   117	        self.ap, self.ar = ap.ravel(), ar.ravel()
   118	        rp = np.asarray(rho_prior, float) / np.sum(rho_prior)
   119	        self.alogpi = np.log(np.repeat(rp, len(ALT_P)) / len(ALT_P))
   120	        self.w_first = w_first
   121	        self.acum = np.zeros(len(self.ap))
   122	        self.stride, self.started, self.use_gap = stride, started, use_gap
   123	        self.starts: list[tuple[np.ndarray, np.ndarray]] = []  # snapshots (cum, acum) before start
   124	        self.k = 0
   125	        self.value = 0.0
   126	        self.log_value = -np.inf
   127	
   128	    def _null_factor(self, hit, gap, prev):
   129	        if prev is None:
   130	            return np.log(np.broadcast_to(self.phi if hit else 1.0 - self.plo, self.cum.shape))
   131	        g = gap if self.use_gap else 1
   132	        ahi, alo = self.rhi ** g, self.rlo ** g
   133	        if prev == 1 and hit == 1:
   134	            f = ahi + (1.0 - ahi) * self.phi
   135	        elif prev == 1:
   136	            f = (1.0 - alo) * (1.0 - self.plo)
   137	        elif hit == 1:
   138	            f = (1.0 - alo) * self.phi
   139	        else:
   140	            f = 1.0 - (1.0 - ahi) * self.plo
   141	        with np.errstate(divide="ignore"):
   142	            return np.log(np.broadcast_to(f, self.cum.shape))
   143	
   144	    def _alt_factor(self, hit, gap, prev):
   145	        if prev is None:
   146	            f = self.ap if hit else 1.0 - self.ap
   147	        else:
   148	            a = self.ar ** gap
   149	            m = a * prev + (1.0 - a) * self.ap
   150	            f = m if hit else 1.0 - m
   151	        with np.errstate(divide="ignore"):
   152	            return np.log(f)
   153	
   154	    def update(self, hit: int, gap: int, prev) -> float:
   155	        self.k += 1
   156	        if (self.k - 1) % self.stride == 0 and (self.started or self.k == 1):
   157	            self.starts.append((self.cum.copy(), self.acum.copy()))
   158	        self.cum = np.maximum(self.cum + self._null_factor(hit, gap, prev), LOG0)
   159	        self.acum = np.maximum(self.acum + self._alt_factor(hit, gap, prev), LOG0)
   160	        terms = []
   161	        for m, (c0, a0) in enumerate(self.starts, start=1):
   162	            if not self.started:
   163	                w = 1.0
   164	            elif m == 1:
   165	                w = self.w_first
   166	            else:  # sum_{m>=2} 1/(m(m+1)) = 1/2, rescaled to the remaining 1 - w_first
   167	                w = 2.0 * (1.0 - self.w_first) / (m * (m + 1))
   168	            num = _lse(self.alogpi + self.acum - a0)
   169	            den = float(np.max(self.cum - c0))
   170	            terms.append(math.log(w) + num - den)
   171	        self.log_value = _lse(np.array(terms))
   172	        self.value = float(math.exp(min(self.log_value, 700.0)))
   173	        return self.value
   174	
   175	
   176	def _lse(x):
   177	    m = float(np.max(x))
   178	    return m + math.log(float(np.sum(np.exp(x - m))))
   179	
   180	
   181	class PostZeroMixture(StartedMixture):
   182	    """A4: QSG started mixture applied only to outcomes after an unfavourable outcome."""
   183	
   184	    def update(self, hit: int, gap: int, prev) -> float:  # type: ignore[override]
   185	        if prev is None or prev == 0:
   186	            self.k += 1
   187	            w = 1.0 / (self.k * (self.k + 1))
   188	            self.S = (self.S + w) * np.exp(self.lr1 if hit else self.lr0)
   189	        return self.value
   190	
   191	
   192	class IIDMixture(StartedMixture):
   193	    """QSG's evidence behind the common ``update(hit, gap, prev)`` interface (side handled outside)."""
   194	
   195	    def update(self, hit: int, gap: int, prev) -> float:  # type: ignore[override]
   196	        self.k += 1
   197	        w = 1.0 / (self.k * (self.k + 1))
   198	        self.S = (self.S + w) * np.exp(self.lr1 if hit else self.lr0)
   199	        return self.value
   200	
   201	
   202	def rho_mle(z: np.ndarray, t: np.ndarray, grid=np.r_[np.linspace(0, 0.9, 10), 0.95, 0.98],
   203	            sig=0.0):
   204	    """Gap-indexed Markov MLE of persistence from ordered outcomes (p profiled on the sample mean).
   205	
   206	    ``sig > 0``: return 0 unless the MLE beats rho = 0 by more than ``sig`` nats (shrinkage)."""
   207	    if len(z) < 2:
   208	        return None
   209	    p = float(np.clip(z.mean(), 0.02, 0.98))
   210	    g = np.diff(t).astype(float)
   211	    prev, cur = z[:-1], z[1:]
   212	    a = grid[:, None] ** g[None, :]
   213	    m = a * prev + (1.0 - a) * p
   214	    ll = np.sum(np.log(np.clip(np.where(cur == 1, m, 1.0 - m), 1e-12, None)), axis=1)
   215	    i = int(np.argmax(ll))
   216	    if sig > 0 and ll[i] - ll[0] <= sig:
   217	        return 0.0
   218	    return float(grid[i])
   219	
