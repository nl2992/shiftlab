   381	# Registry entries.
   382	# ------------------------------------------------------------------------------------------------
   383	# D6 frozen parameter set (one module, one setting, every host). Fixed a priori, not tuned.
   384	D6_PARAMS = dict(cert=started_mixture, acq="host_pref", and_host=True, rollback=True,
   385	                 reserve=0.25, alpha_r=0.05, share=True)
   386	A1_FACTORY, A1_SOURCE = _a1_or_standin(0.8)
   387	
   388	
   389	def _gate(kind, name, **kw):
   390	    def f(T, B, cs, cq, a, d, r):
   391	        return DeployGate(make_host(kind, r), T, B, a, rng=r("D_gate"), name=name, **kw)
   392	    return f
   393	
   394	
   395	EXTRA = {
   396	    # D1: Model Picker + anytime deploy gate (no rollback; promotion absorbing)
   397	    "D1": _gate("mp", "D1"),
   398	    "D1-host_only": _gate("mp", "D1-host_only", acq="host_only"),
   399	    "D1-always": _gate("mp", "D1-always", acq="always"),
   400	    "D1-no_and": _gate("mp", "D1-no_and", and_host=False),
   401	    "D1-no_share": _gate("mp", "D1-no_share", share=False),
   402	    # D2: CAMS (constant policies, the only information the loss-only stream supports) + gate
   403	    "D2": _gate("cams", "D2"),
   404	    "D2-host_only": _gate("cams", "D2-host_only", acq="host_only"),
   405	    # D3: Model Selector + post-decision monitoring
   406	    "D3": lambda T, B, cs, cq, a, d, r: SelectThenMonitor(T, B, a, r=r, rng=r("D_gate"),
   407	                                                          name="D3"),
   408	    "D3-gated": lambda T, B, cs, cq, a, d, r: SelectThenMonitor(T, B, a, r=r, rng=r("D_gate"),
   409	                                                                gate_initial=True,
   410	                                                                name="D3-gated"),
   411	    # D4: D1 + rollback reserve + rollback rule
   412	    "D4": _gate("mp", "D4", rollback=True, reserve=0.25),
   413	    "D4-no_reserve": _gate("mp", "D4-no_reserve", rollback=True, reserve=0.0),
   414	    "D4-r10": _gate("mp", "D4-r10", rollback=True, reserve=0.10),
   415	    # D5: D2 + gap-aware dependence-corrected certificate (A1, or the declared stand-in)
   416	    "D5": _gate("cams", "D5", cert=A1_FACTORY),
   417	    "D5-standin_env8": _gate("cams", "D5-standin_env8", cert=envelope(0.8)),
   418	    # D6: the shared wrapper, same module and parameters on three independent hosts
   419	    "D6:mp": _gate("mp", "D6:mp", **D6_PARAMS),
   420	    "D6:cams": _gate("cams", "D6:cams", **D6_PARAMS),
   421	    "D6:ms": _gate("ms", "D6:ms", **D6_PARAMS),
   422	    # post-screen addition (2026-11-03, after screen1): D1's default parameter set on the Model
   423	    # Selector host, to complete the D1-params transfer row (D2 is already D1-params on CAMS)
   424	    "D6-D1params:ms": _gate("ms", "D6-D1params:ms"),
