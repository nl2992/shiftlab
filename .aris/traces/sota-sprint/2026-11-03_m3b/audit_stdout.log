    53	class HorizonWeightedPacer(PacedDisagreementAcquisition):
    54	    """Spend density proportional to (T - t)^(k - 1): q_t = k * remaining / (rate * (T - t)).
    55	
    56	    k = 1 is the shared uniform pacer; k = 2 spends in proportion to the remaining horizon, i.e.
    57	    to the number of future events a decision made now will govern.
    58	    """
    59	
    60	    def __init__(self, horizon, budget, p_min=0.05, k: float = 2.0):
    61	        super().__init__(horizon, budget, p_min=p_min)
    62	        self.k = float(k)
    63	
    64	    def propensity(self, t, remaining, disagree):
    65	        if not disagree or remaining <= 0:
    66	            return 0.0
    67	        rate = (self.n_disagree + self.prior_rate * self.prior_w) / (t + self.prior_w)
    68	        expected_left = max(rate * (self.T - t), 1e-9)
    69	        return float(min(max(self.k * remaining / expected_left, self.p_min), 1.0))
    70	
    71	
    72	class MixtureSRDetector:
    73	    """Weighted Shiryaev-Roberts e-detector over a finite start grid; total prior mass one."""
    74	
    75	    def __init__(self, alpha: float, max_labels: int, gap: int = 10,
    76	                 lambdas: tuple[float, ...] = (0.15, 0.3, 0.5), single_start: bool = False,
    77	                 w_first: float | None = None):
    78	        self.alpha = float(alpha)
    79	        self.gap = int(gap)
    80	        self.n_starts = 1 if single_start else max(1, int(math.ceil(max_labels / self.gap)))
    81	        # prior mass of each start; total one. w_first puts extra mass on the first start.
    82	        if self.n_starts == 1:
    83	            self.pis = [1.0]
    84	        elif w_first is None:
    85	            self.pis = [1.0 / self.n_starts] * self.n_starts
    86	        else:
    87	            rest = (1.0 - w_first) / (self.n_starts - 1)
    88	            self.pis = [float(w_first)] + [rest] * (self.n_starts - 1)
    89	        self.lams = np.asarray(lambdas, float)
    90	        self.sr = np.zeros(len(self.lams))
    91	        self.n = 0
    92	
    93	    def update(self, x: int) -> bool:
    94	        if self.n % self.gap == 0 and self.n // self.gap < self.n_starts:
    95	            self.sr += self.pis[self.n // self.gap]  # a start enters before its first label
    96	        self.sr *= 1.0 + self.lams * x
    97	        self.n += 1
    98	        return self.stat >= 1.0 / self.alpha
    99	
   100	    @property
   101	    def stat(self) -> float:
   102	        return float(self.sr.mean())
   103	
   104	
   105	class _View:
   106	    """Present the stream to a restarted base with shifted time and permuted model indices."""
   107	
   108	    def __init__(self, t0: int, horizon: int, swap: bool):
   109	        self.t0, self.horizon, self.swap = t0, horizon, swap
   110	
   111	    def event(self, ev: Event) -> Event:
   112	        preds = ev.model_predictions[::-1].copy() if self.swap else ev.model_predictions
   113	        return Event(event_id=ev.event_id, t=ev.t - self.t0, horizon=self.horizon,
   114	                     model_predictions=preds, context=ev.context)
   115	
   116	    def feedback(self, fb: ReleasedFeedback) -> ReleasedFeedback:
   117	        ml = fb.model_losses[::-1].copy() if self.swap else fb.model_losses
   118	        return ReleasedFeedback(event_id=fb.event_id, t_requested=fb.t_requested - self.t0,
   119	                                t_released=fb.t_released - self.t0, label=fb.label,
   120	                                model_losses=ml, query_probability=fb.query_probability,
   121	                                extra=fb.extra)
   122	
   123	    def model(self, k: int) -> int:
   124	        return 1 - k if self.swap else k
   125	
