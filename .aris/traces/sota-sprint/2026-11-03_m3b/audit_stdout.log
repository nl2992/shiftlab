    99	        cell["best_uncertified"] = means[unc].idxmin()
   100	        cell["contrasts"] = {c: {"best_certified": diff(P, c, cell["best_certified"]),
   101	                                 "best_uncertified": diff(P, c, cell["best_uncertified"])}
   102	                             for c in SAFETY_CANDS + ["A1b"] if c in means}
   103	        res["regimes"][r] = cell
   104	
   105	    # H0 (Amendment 2): the Atlas v2 registered stop rule, verbatim criteria
   106	    s = res["null_safety"]
   107	    for c in ("A5b", "A1b"):
   108	        safe = all(s[c][r]["rate"] <= BOUND for r in ("V_null_dep_r8", "W_null_dep_r95"))
   109	        rows = {}
   110	        for r in STAT6:
   111	            P = piv[r]
   112	            base = min(("xu_acquisition_only", "gated_adaptive_range+pace_tuned"), key=lambda b: P[b].mean())
   113	            rows[r] = diff(P, c, base)
   114	        k = sum(v["hi"] < 0 for v in rows.values())
   115	        res.setdefault("H0", {})[c] = {"safety_r8_r95": safe, "rows": rows, "n_ci_below_0": k,
   116	                                       "pass": bool(safe and k >= 4)}
   117	    # H1 (Amendment 2): class-scoped safety (Wilson upper bound), Pareto part 2, NI part 3
   118	    def safe_ub(c):
   119	        return {r: s[c][r]["wilson_hi"] <= BOUND for r in NULLS}
   120	    for c in ("A5b", "A1b", "X_A5C"):
   121	        part1 = safe_ub(c)
   122	        p2 = {}
   123	        for comp in CERT:
   124	            fails = [r for r in NULLS if s[comp][r]["rate"] > BOUND and s[comp][r]["wilson_lo"] > 0.05]
   125	            dom = [r for r in STAT6 if diff(piv[r], c, comp)["hi"] < 0]
   126	            p2[comp] = {"fails_nulls": fails, "dominated_on": dom,
   127	                        "ok": bool(fails) or len(dom) >= 3}
   128	        part3 = {r: res["regimes"][r]["contrasts"][c]["best_certified"] for r in IID_ALT + ["V_bursty"]}
   129	        ni5 = sum(part3[r]["hi"] <= 5.0 for r in IID_ALT)
   130	        res["H1"][c] = {"part1_wilson_ub_safe": part1, "part1_pass": all(part1.values()),
   131	                        "part2": p2, "part2_pass": all(v["ok"] for v in p2.values()),
   132	                        "part3": part3, "part3_n_ni_of5": ni5,
   133	                        "part3_n_ni_of6_incl_bursty": ni5 + int(part3["V_bursty"]["hi"] <= 5.0),
   134	                        "part3_pass": ni5 >= 4,
   135	                        "declared_losses": {r: res["regimes"][r]["contrasts"][c]["best_certified"]
   136	                                            for r in DECLARED_LOSS}}
   137	        h = res["H1"][c]
   138	        h["pass"] = h["part1_pass"] and h["part2_pass"] and h["part3_pass"]
   139	    res["ooc"] = {p: {r: s[p][r] for r in OOC if r in s.get(p, {})} for p in s}
   140	    # H2: Holm over the 5 iid alternatives per candidate, vs best certified published
   141	    for c in H2_CANDS:
   142	        ds = [res["regimes"][r]["contrasts"][c]["best_certified"] for r in IID_ALT]
   143	        adj = holm(np.array([d["p_one_sided_less"] for d in ds]))
   144	        safe = all(s[c][r]["wilson_hi"] <= BOUND for r in NULLS)
   145	        res["H2"][c] = {"safe_all_nulls": safe,
   146	                        "rows": {r: {**d, "holm_p": round(float(a), 5)} for r, d, a in zip(IID_ALT, ds, adj)},
   147	                        "n_sig": int((adj < 0.05).sum()),
   148	                        "pass": bool(safe and (adj < 0.05).sum() >= 4)}
   149	    # H3 attribution
   150	    h3 = {}
   151	    for r in IID_ALT + ["V_bursty", "V_dep_better_r5"]:
   152	        h3[f"A5b-A1b@{r}"] = diff(piv[r], "A5b", "A1b")
   153	    for r in ["V_reversal_1000", "W_reversal_700", "V_recurrent"]:
   154	        h3[f"B2-host@{r}"] = diff(piv[r], "B2", "rmm:gated_deployment+RMM")
   155	    for r in ["V_late_600", "W_late_1000"]:
   156	        h3[f"X_A5C-A5b@{r}"] = diff(piv[r], "X_A5C", "A5b")
   157	    for r in ["V_reversal_1000", "W_reversal_700", "V_recurrent"]:
   158	        h3[f"B5-host@{r}"] = diff(piv[r], "B5", "rmm:gated_deployment+RMM")
   159	    for r in ["V_null", "V_null_dep_r8"]:
   160	        h3[f"D1-model_picker@{r}"] = diff(piv[r], "D1", "model_picker_adapter")
   161	        h3[f"D2-cams@{r}"] = diff(piv[r], "D2", "cams_adapter")
   162	    for r in IID_ALT:
   163	        h3[f"C2-front@{r}"] = diff(piv[r], "C2", "gated_adaptive_range+front")
   164	    res["H3"] = h3
   165	    DOC.mkdir(parents=True, exist_ok=True)
   166	    (DOC / "validation_results.json").write_text(json.dumps(res, indent=1, default=float) + "\n")
   167	    write_md(res)
   168	
   169	
   170	def _ci(d):
   171	    return f"{d['mean']:+.1f} [{d['lo']:+.1f},{d['hi']:+.1f}]"
   172	
   173	
   174	def write_md(res):
   175	    s = res["null_safety"]
   176	    regs = NULLS + OOC
   177	    L = ["# SOTA sprint validation results (locked protocol + Amendments 1-2)", "",
   178	         "Raw: `outputs/sota_sprint/validation/`. Synthetic 100 seeds (base 2026110601); in-class nulls "
   179	         "1000 seeds (base 2026110602); out-of-class nulls 1000 seeds (base 2026110605, descriptive).", "",
   180	         "## Null promotion rate (1000 seeds; bold = point > .0936) and harm vs never-switch", "",
   181	         "| policy | " + " | ".join(regs) + " |", "|---|" + "---|" * len(regs)]
   182	    for p in sorted(s):
   183	        cells = []
   184	        for r in regs:
   185	            v = s[p].get(r)
   186	            if v is None:
   187	                cells.append("")
   188	                continue
   189	            rate = f"**{v['rate']:.3f}**" if v["rate"] > BOUND else f"{v['rate']:.3f}"
   190	            cells.append(f"{rate} (ub {v['wilson_hi']:.3f}; harm {v['harm_vs_never']:+.2f})")
   191	        L.append(f"| {p} | " + " | ".join(cells) + " |")
   192	    L += ["", "## H0: Atlas v2 registered stop rule (vs stronger of Xu / tuned pacing)", ""]
   193	    for c, h in res["H0"].items():
   194	        L.append(f"* **{c}: {'PASS' if h['pass'] else 'FAIL'}**; safety rho .8/.95 {h['safety_r8_r95']}; "
   195	                 f"CI<0 on {h['n_ci_below_0']}/6: " + "; ".join(f"{r} {_ci(d)} vs {d['vs']}" for r, d in h["rows"].items()))
   196	    L += ["", "## H1 (Amendment 2): class-scoped reliability on the safety-cost Pareto frontier", ""]
   197	    for c, h in res["H1"].items():
   198	        L += [f"### {c}: **{'PASS' if h['pass'] else 'FAIL'}**",
   199	              f"* part 1 (Wilson ub <= .0936 on all in-class nulls): {h['part1_pass']} {h['part1_wilson_ub_safe']}",
   200	              f"* part 2 (each certified comparator fails a null or is cost-dominated on >= 3/6): {h['part2_pass']}"]
   201	        for comp, v in h["part2"].items():
   202	            L.append(f"  * {comp}: fails {v['fails_nulls']}; dominated on {v['dominated_on']} -> {'ok' if v['ok'] else 'NOT OK'}")
   203	        L.append(f"* part 3 NI (+5): {h['part3_n_ni_of5']}/5 iid ({h['part3_n_ni_of6_incl_bursty']}/6 incl. bursty): "
   204	                 + "; ".join(f"{r} {_ci(d)} vs {d['vs']}" for r, d in h["part3"].items()))
   205	        L.append("* declared losses: " + "; ".join(f"{r} {_ci(d)}" for r, d in h["declared_losses"].items()))
   206	    L += ["", "## H2 (cost superiority vs best certified; Holm over 5 iid; requires Wilson-ub safety)", "",
   207	          "| candidate | safe | " + " | ".join(IID_ALT) + " | n sig | pass |", "|---|---|" + "---|" * len(IID_ALT) + "---|---|"]
   208	    for c, v in res["H2"].items():
   209	        L.append(f"| {c} | {v['safe_all_nulls']} | " + " | ".join(
   210	            f"{v['rows'][r]['mean']:+.1f} (p={v['rows'][r]['holm_p']:.3g})" for r in IID_ALT)
   211	            + f" | {v['n_sig']} | {v['pass']} |")
   212	    L += ["", "## H3 attribution (paired, 95% CI)", "", "| contrast | mean [CI] |", "|---|---|"]
   213	    L += [f"| {k} | {_ci(d)} |" for k, d in res["H3"].items()]
   214	    keys = ["A5b", "A1b", "X_A5C", "D1", "D2", "C2", "C6", "B2", "B5", "QSG", "xu_acquisition_only",
   215	            "gated_adaptive_range+pace_tuned", "gated_adaptive_range+front", "choe_ramdas_eb+front",
   216	            "gated_deployment+QCE+front", "SMCS+retain-incumbent", "discern_style", "CONTROL_never_switch"]
   217	    L += ["", "## All regimes: mean cost", "",
   218	          "| regime | best cert | best uncert | " + " | ".join(keys) + " |", "|---|---|---|" + "---|" * len(keys)]
   219	    for r, c in res["regimes"].items():
   220	        m = c["mean"]
   221	        L.append(f"| {r} | {c['best_certified']} {m[c['best_certified']]:.1f} | {c['best_uncertified']} "
   222	                 f"{m[c['best_uncertified']]:.1f} | " + " | ".join(f"{m.get(k, float('nan')):.1f}" for k in keys) + " |")
   223	    (DOC / "validation_results.md").write_text("\n".join(L) + "\n")
   224	    print("\n".join(L[: 40 + len(s)]))
