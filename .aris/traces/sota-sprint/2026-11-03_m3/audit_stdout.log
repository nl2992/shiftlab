===== scripts/sota_sprint/analyze_real.py =====
     1	"""Real-data analysis per docs/sota_sprint/fresh_real_protocol.md (fresh) and, descriptively, exposed streams.
     2	
     3	Unit = episode (policy seeds averaged within an episode). Per dataset: paired Delta J (candidate -
     4	comparator) with a 95% t-interval over episodes, the fraction of episodes improved, and a two-sided sign
     5	test. Episodes are consecutive windows of one stream, so intervals are optimistic.
     6	
     7	    uv run python scripts/sota_sprint/analyze_real.py
     8	"""
     9	
    10	from __future__ import annotations
    11	
    12	import json
    13	from pathlib import Path
    14	
    15	import numpy as np
    16	import pandas as pd
    17	from scipy import stats
    18	
    19	ROOT = Path(__file__).resolve().parents[2]
    20	VAL = ROOT / "outputs/sota_sprint/validation"
    21	DOC = ROOT / "docs/sota_sprint/validation"
    22	CERT = ["gated_deployment", "gated_adaptive_range", "gated_adaptive_range+front", "discern_style",
    23	        "discern_design_floor", "SMCS+retain-incumbent", "xu_acquisition_only", "choe_ramdas_eb",
    24	        "choe_ramdas_eb+front"]
    25	UNC = ["model_picker_adapter", "model_selector_causal", "online_llm_picker", "cams_adapter",
    26	       "variance_min_ipw", "gong_zhang_paid_obs", "qiu_delayed_movement", "ryabchenko_capacity"]
    27	CANDS = {"A5b": None, "X_A5C": None, "D1": "model_picker_adapter", "D2": "cams_adapter",
    28	         "C2": "gated_adaptive_range+front", "C6": "gated_adaptive_range+front",
    29	         "B2": "rmm:gated_deployment+RMM", "B5": "rmm:gated_deployment+RMM"}
    30	
    31	
    32	def contrast(E, a, b):
    33	    d = (E[a] - E[b]).dropna().to_numpy()
    34	    se = d.std(ddof=1) / np.sqrt(len(d)) if len(d) > 1 else float("nan")
    35	    k = int((d < 0).sum())
    36	    nz = int((d != 0).sum())
    37	    return {"vs": b, "mean": round(float(d.mean()), 2), "lo": round(float(d.mean() - 1.96 * se), 2),
    38	            "hi": round(float(d.mean() + 1.96 * se), 2), "K": len(d), "improved": k,
    39	            "sign_p": float(stats.binomtest(k, nz, 0.5).pvalue) if nz else 1.0}
    40	
    41	
    42	def analyse(run: str) -> dict:
    43	    df = pd.read_json(VAL / run / "records.jsonl", lines=True)
    44	    out = {}
    45	    for ds, g in df.groupby("regime"):
    46	        E = g.groupby(["ep", "policy"]).net.mean().unstack()
    47	        best_c = E[[c for c in CERT if c in E]].mean().idxmin()
    48	        best_u = E[[c for c in UNC if c in E]].mean().idxmin()
    49	        prom = g.groupby("policy").ever_promote.mean()
    50	        cell = {"K": int(E.shape[0]), "best_certified": best_c, "best_uncertified": best_u,
    51	                "mean": E.mean().round(2).to_dict(), "promote": prom.round(3).to_dict(),
    52	                "contrasts": {}}
    53	        for c, host in CANDS.items():
    54	            if c not in E:
    55	                continue
    56	            cc = {"best_certified": contrast(E, c, best_c), "best_uncertified": contrast(E, c, best_u),
    57	                  "never_switch": contrast(E, c, "CONTROL_never_switch")}
    58	            if host and host in E:
    59	                cc["host"] = contrast(E, c, host)
    60	            cell["contrasts"][c] = cc
    61	        out[ds] = cell
    62	    return out
    63	
    64	
    65	def md(res: dict, title: str) -> list[str]:
    66	    L = [f"## {title}", "", "| dataset | K | candidate | vs best certified | vs host | vs best uncertified | improved/K (sign p) |",
    67	         "|---|---|---|---|---|---|---|"]
    68	    for ds, cell in res.items():
    69	        for c, cc in cell["contrasts"].items():
    70	            b = cc["best_certified"]
    71	            h = cc.get("host")
    72	            u = cc["best_uncertified"]
    73	            L.append(f"| {ds} | {cell['K']} | {c} | {b['mean']:+.1f} [{b['lo']:+.1f},{b['hi']:+.1f}] ({b['vs']}) | "
    74	                     + (f"{h['mean']:+.1f} [{h['lo']:+.1f},{h['hi']:+.1f}]" if h else "") + " | "
    75	                     f"{u['mean']:+.1f} ({u['vs']}) | {b['improved']}/{b['K']} (p={b['sign_p']:.3g}) |")
    76	    return L + [""]
    77	
    78	
    79	def main():
    80	    fresh, exposed = analyse("real_fresh"), analyse("real_exposed")
    81	    DOC.mkdir(parents=True, exist_ok=True)
    82	    (DOC / "real_results.json").write_text(json.dumps({"fresh": fresh, "exposed": exposed}, indent=1,
    83	                                                      default=float) + "\n")
    84	    L = ["# Real-data validation", "", "Fresh streams registered in aeb2d4f before any policy run (20 policy seeds, "
    85	         "base 2026110604). Exposed streams are descriptive (10 seeds, base 2026110603). Unit = episode; "
    86	         "consecutive windows, so CIs are optimistic.", ""]
    87	    L += md(fresh, "Fresh, never-used streams (external validation)")
    88	    L += md(exposed, "Previously exposed streams (descriptive only)")
    89	    (DOC / "real_results.md").write_text("\n".join(L) + "\n")
    90	    print("\n".join(L))
    91	
    92	
    93	if __name__ == "__main__":
    94	    main()
===== scripts/sota_sprint/analyze_transfer.py =====
     1	"""Evaluate Amendment 3 (RMM transfer, HR/HR2) and Amendment 4 (deploy-gate transfer, HD) as registered.
     2	
     3	    uv run python scripts/sota_sprint/analyze_transfer.py
     4	"""
     5	
     6	from __future__ import annotations
     7	
     8	import json
     9	from pathlib import Path
    10	
    11	import numpy as np
    12	import pandas as pd
    13	
    14	from analyze_real import contrast as ep_contrast
    15	from analyze_validation import BOUND, CERT, IID_ALT, diff, holm, wilson
    16	
    17	ROOT = Path(__file__).resolve().parents[2]
    18	OUT = ROOT / "outputs/sota_sprint"
    19	DOC = ROOT / "docs/sota_sprint/validation"
    20	HOSTS = ["gated_deployment", "discern_style", "SMCS+retain-incumbent", "model_picker_adapter",
    21	         "cams_adapter"]
    22	FAM = ["V_late_600", "W_late_1000", "V_better_a", "V_better_b", "V_better_c", "V_near"]
    23	CERT_A3 = ["gated_deployment", "gated_adaptive_range", "gated_adaptive_range+front", "discern_style",
    24	           "discern_design_floor", "xu_acquisition_only", "choe_ramdas_eb+front"]
    25	
    26	
    27	def _ci(x):
    28	    se = x.std(ddof=1) / np.sqrt(len(x))
    29	    return {"mean": round(float(x.mean()), 2), "lo": round(float(x.mean() - 1.96 * se), 2),
    30	            "hi": round(float(x.mean() + 1.96 * se), 2), "n": len(x)}
    31	
    32	
    33	def null_table(df):
    34	    t = {}
    35	    for (r, p), g in df.groupby(["regime", "policy"]):
    36	        k, n = int(g.ever_promote.sum()), len(g)
    37	        t.setdefault(p, {})[r] = {"rate": k / n, "wilson_hi": round(wilson(k, n)[1], 4)}
    38	    return t
    39	
    40	
    41	def rmm():
    42	    syn = pd.read_json(OUT / "rmm_transfer/synth/records.jsonl", lines=True)
    43	    nul = null_table(pd.read_json(OUT / "rmm_transfer/null1000/records.jsonl", lines=True))
    44	    P = syn[syn.regime.isin(FAM)].pivot_table(index="seed", columns=["regime", "policy"], values="net")
    45	    fam = {p: P.xs(p, axis=1, level=1).mean(axis=1) for p in syn.policy.unique()}  # per-seed family mean
    46	    res = {"HR": {}, "attribution": {}, "nulls": nul}
    47	    n_ok = 0
    48	    for h in HOSTS:
    49	        d = _ci((fam[f"rmm:{h}+RMM"] - fam[h]).to_numpy())
    50	        safe = all(nul[f"rmm:{h}+RMM"][r]["wilson_hi"] <= BOUND for r in ("V_null", "V_worse"))
    51	        res["HR"][h] = {"family_delta": d, "iid_null_safe": safe,
    52	                        "dep_null_r8": nul[f"rmm:{h}+RMM"]["V_null_dep_r8"]["rate"],
    53	                        "dep_null_r95": nul[f"rmm:{h}+RMM"]["W_null_dep_r95"]["rate"],
    54	                        "per_regime": {r: diff(syn[syn.regime == r].pivot_table(
    55	                            index="seed", columns="policy", values="net"), f"rmm:{h}+RMM", h)
    56	                            for r in FAM + ["V_reversal_1000", "W_reversal_700", "V_recurrent"]}}
    57	        n_ok += int(d["hi"] < 0 and safe)
    58	    res["HR_pass"] = n_ok >= 4
    59	    res["HR_n_hosts_ok"] = n_ok
    60	    best = min((f"rmm:{h}+RMM" for h in HOSTS), key=lambda p: fam[p].mean())
    61	    res["HR2"] = {"best_rmm": best, "family_vs": {}}
    62	    for c in ["gated_adaptive_range+front", "gated_deployment+QCE+front", "xu_acquisition_only",
    63	              "discern_design_floor", "P7s_settled", "A5b", "rmm:LRMD"]:
    64	        if c in fam:
    65	            res["HR2"]["family_vs"][c] = _ci((fam[best] - fam[c]).to_numpy())
    66	    rows = []
    67	    for r in ("V_late_600", "W_late_1000"):
    68	        Q = syn[syn.regime == r].pivot_table(index="seed", columns="policy", values="net")
    69	        bc = Q[[c for c in CERT_A3 if c in Q]].mean().idxmin()
    70	        rows.append((r, diff(Q, best, bc)))
    71	    adj = holm(np.array([d["p_one_sided_less"] for _, d in rows]))
    72	    res["HR2"]["late_test"] = {r: {**d, "holm_p": round(float(a), 5)} for (r, d), a in zip(rows, adj)}
    73	    for a, b in [("rmm:gated_deployment+RMM", "rmm:gated_deployment+RMM_single"),
    74	                 ("rmm:discern_style+RMM", "rmm:discern_style+RMM_single"),
    75	                 ("rmm:SMCS+retain-incumbent+RMM", "rmm:SMCS+retain-incumbent+RMM_single"),
    76	                 ("rmm:gated_deployment+RMM", "rmm:gated_deployment+RMM_noacq"),
    77	                 ("rmm:discern_style+RMM", "rmm:discern_style+RMM_noacq")]:
    78	        res["attribution"][f"{a} - {b}"] = _ci((fam[a] - fam[b]).to_numpy())
    79	    return res
    80	
    81	
    82	def gate():
    83	    syn = pd.read_json(OUT / "gate_transfer/synth/records.jsonl", lines=True)
    84	    nul = null_table(pd.read_json(OUT / "gate_transfer/null1000/records.jsonl", lines=True))
    85	    real = pd.read_json(OUT / "gate_transfer/real_fresh/records.jsonl", lines=True)
    86	    pairs = {"D1": "model_picker_adapter", "D2": "cams_adapter", "D6-D1params:ms": "model_selector_causal"}
    87	    res = {"HD": {}, "nulls": nul}
    88	    Pall = syn.pivot_table(index=["regime", "seed"], columns="policy", values="net")
    89	    n_ok = 0
    90	    for g, h in pairs.items():
    91	        vs_host = _ci((Pall[g] - Pall[h]).dropna().to_numpy())
    92	        rows = []
    93	        for r in IID_ALT:
    94	            Q = syn[syn.regime == r].pivot_table(index="seed", columns="policy", values="net")
    95	            bc = Q[[c for c in CERT if c in Q]].mean().idxmin()
    96	            rows.append((r, diff(Q, g, bc)))
    97	        adj = holm(np.array([d["p_one_sided_less"] for _, d in rows]))
    98	        nsig = int((adj < 0.05).sum())
    99	        safe = all(nul[g][r]["wilson_hi"] <= BOUND for r in ("V_null", "V_worse", "V_null_dep_r5"))
   100	        realc = {}
   101	        for ds, gg in real.groupby("regime"):
   102	            E = gg.groupby(["ep", "policy"]).net.mean().unstack()
   103	            bc = E[[c for c in CERT if c in E]].mean().idxmin()
   104	            realc[ds] = {"best_certified": ep_contrast(E, g, bc), "host": ep_contrast(E, g, h)}
   105	        res["HD"][g] = {"host": h, "vs_host_all_regimes": vs_host,
   106	                        "vs_best_certified_iid": {r: {**d, "holm_p": round(float(a), 5)}
   107	                                                  for (r, d), a in zip(rows, adj)},
   108	                        "n_sig": nsig, "iid_null_safe": safe,
   109	                        "null_rates": {r: nul[g][r]["rate"] for r in nul[g]},
   110	                        "real_fresh": realc, "pass": bool(safe and nsig >= 3)}
   111	        n_ok += int(safe and nsig >= 3)
   112	    res["HD_pass"] = n_ok == 3
   113	    return res
   114	
   115	
   116	def main():
   117	    out = {"amendment3_rmm": rmm(), "amendment4_gate": gate()}
   118	    DOC.mkdir(parents=True, exist_ok=True)
   119	    (DOC / "transfer_results.json").write_text(json.dumps(out, indent=1, default=float) + "\n")
   120	    a3, a4 = out["amendment3_rmm"], out["amendment4_gate"]
   121	    L = ["# Transfer tests (Amendments 3 and 4)", "",
   122	         f"## HR, RMM transfer across 5 hosts: **{'PASS' if a3['HR_pass'] else 'FAIL'}** ({a3['HR_n_hosts_ok']}/5 hosts with CI<0 and iid-null safety)", "",
   123	         "| host | family Delta J (host+RMM - host) | iid nulls safe | rho .8 null | rho .95 null | reversal_1000 | reversal_700 |", "|---|---|---|---|---|---|---|"]
   124	    for h, v in a3["HR"].items():
   125	        d = v["family_delta"]
   126	        L.append(f"| {h} | {d['mean']:+.1f} [{d['lo']:+.1f},{d['hi']:+.1f}] | {v['iid_null_safe']} | {v['dep_null_r8']:.3f} | "
   127	                 f"{v['dep_null_r95']:.3f} | {v['per_regime']['V_reversal_1000']['mean']:+.1f} | {v['per_regime']['W_reversal_700']['mean']:+.1f} |")
   128	    L += ["", f"HR2, best host+RMM = {a3['HR2']['best_rmm']}; family Delta vs: " + "; ".join(
   129	        f"{k} {v['mean']:+.1f} [{v['lo']:+.1f},{v['hi']:+.1f}]" for k, v in a3["HR2"]["family_vs"].items()),
   130	          "", "Late-regime test vs best certified published (Holm): " + "; ".join(
   131	        f"{r} {v['mean']:+.1f} [{v['lo']:+.1f},{v['hi']:+.1f}] vs {v['vs']} (holm p={v['holm_p']:.3g})"
   132	        for r, v in a3["HR2"]["late_test"].items()),
   133	          "", "Attribution (family mean): " + "; ".join(f"{k}: {v['mean']:+.1f} [{v['lo']:+.1f},{v['hi']:+.1f}]"
   134	                                                         for k, v in a3["attribution"].items()), "",
   135	          f"## HD, deploy-gate transfer across 3 hosts: **{'PASS' if a4['HD_pass'] else 'FAIL'}**", "",
   136	          "| gated host | vs native host (all regimes) | Holm-sig vs best certified (of 5) | iid nulls safe | null rates | fresh real vs best certified (improved/K) |",
   137	          "|---|---|---|---|---|---|"]
   138	    for g, v in a4["HD"].items():
   139	        d = v["vs_host_all_regimes"]
   140	        rr = "; ".join(f"{ds} {c['best_certified']['mean']:+.1f} ({c['best_certified']['improved']}/{c['best_certified']['K']})"
   141	                       for ds, c in v["real_fresh"].items())
   142	        L.append(f"| {g} ({v['host']}) | {d['mean']:+.1f} [{d['lo']:+.1f},{d['hi']:+.1f}] | {v['n_sig']} | {v['iid_null_safe']} | "
   143	                 + ", ".join(f"{r} {x:.3f}" for r, x in v["null_rates"].items()) + f" | {rr} |")
   144	    (DOC / "transfer_results.md").write_text("\n".join(L) + "\n")
