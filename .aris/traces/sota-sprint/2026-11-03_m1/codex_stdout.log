   187	# =============================================================================== host mixin
   188	class _Ctl:
   189	    """Mixin over a ``_CertificateStop`` host: controller-driven (pi, q), frozen at issue."""
   190	
   191	    c_beta = 0.5  # assumed CS width decay exponent in recorded events (C4 projection)
   192	
   193	    def _c_init(self, T, B, cs, cq, delay, ctl):
   194	        self.c_T, self.c_B, self.c_cs, self.c_cq, self.c_delay = T, B, cs, cq, delay
   195	        self.ctl = ctl
   196	        self.c_n_rel = 0
   197	        self.c_sum_z = 0.0
   198	        self.c_issue_q: dict[int, float] = {}  # event -> issue-time q (test hook)
   199	
   200	    def request_labels(self, event, remaining_budget):
   201	        if self.stopped:
   202	            return QueryRequest(requested=False)
   203	        self._on_event_start(event)
   204	        dis = bool(event.model_predictions[0] != event.model_predictions[1])
   205	        t = event.t
   206	        pi, q = self.ctl.decide(self, t, remaining_budget, dis)
   207	        self.acq.note_event(dis)
   208	        if self.stopped or self.exhausted:
   209	            return QueryRequest(requested=False)
   210	        if dis and remaining_budget <= 0:  # same freeze as the host
   211	            self.exhausted = True
   212	            return QueryRequest(requested=False)
   213	        if pi < 1.0 and not (pi > 0.0 and self.rng.random() < pi):
   214	            return QueryRequest(requested=False)  # unrecorded event (predictable coin)
   215	        if not dis:
   216	            self._c_record_agree(t)
   217	            self._queue.append(_Rec(t, True, 1.0, 0))
   218	            self._flush()
   219	            return QueryRequest(requested=False)
   220	        q = float(min(max(q, self.c_qfloor()), 1.0))
   221	        take = bool(self.rng.random() < q)
   222	        self._c_record_dis(t, q)
   223	        rec = _Rec(t, not take, 0.0, 0)
   224	        self._queue.append(rec)
   225	        if take:
   226	            self._pending[t] = rec
   227	            self.c_issue_q[t] = q
   228	        else:
   229	            self._flush()
   230	        return QueryRequest(requested=take, probability=q)
   231	
   232	    def observe(self, feedback):
   233	        for fb in feedback:
   234	            if fb.event_id in self._pending:
   235	                d = int(fb.model_losses[0]) - int(fb.model_losses[1])
   236	                self.c_n_rel += 1
   237	                self.c_sum_z += (d + 1) / 2.0
   238	        super().observe(feedback)
   239	
   240	    # host-specific hooks
   241	    def c_qfloor(self):
   242	        return 1e-9
   243	
   244	    def _c_record_agree(self, t):
   245	        pass
   246	
   247	    def _c_record_dis(self, t, q):
   248	        pass
   249	
   250	    def c_phase2(self, rem, exp_left):
   251	        raise NotImplementedError
   252	
   253	    def c_skip(self, action, explore):
   254	        raise NotImplementedError
   255	
