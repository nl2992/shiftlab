   198	        self._mark_decided()
   199	        return self.deployed
   200	
   201	    def request_labels(self, event: Event, remaining_budget: int) -> QueryRequest:
   202	        self.remaining = remaining_budget
   203	        self._remaining_hint = remaining_budget
   204	        eff = self._effective(event.t, remaining_budget)
   205	        dis = bool(event.model_predictions[0] != event.model_predictions[1])
   206	        req = self.base.request_labels(self.view.event(event), eff)
   207	        q_own = self.acq.propensity(event.t, eff, dis)
   208	        self.acq.note_event(dis)
