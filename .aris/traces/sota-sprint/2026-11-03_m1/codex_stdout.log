    56	def build_suite(T, budget, cs, cq, alpha, delay, ep, seed_base, *, names=None, extra=None):
    57	    def r(nm):
    58	        return policy_rng(seed_base, ep, nm)
    59	
    60	    def p7s():
    61	        from b3_plus_policy import b1
    62	        from b3_plus_policy_adapter import P7sPolicy
    63	
    64	        return P7sPolicy(horizon=T, budget=budget, delay=delay, switch_cost=cs, label_price=cq,
    65	                         rng=r("P7s"), params=b1.Params(T=T, delay=delay, cq=cq, alpha=alpha))
    66	
    67	    makers = {
    68	        "gated_deployment": lambda: GatedDeploymentStop(T, budget, alpha, rng=r("gated_deployment")),
    69	        "discern_style": lambda: DiscernStyleStop(T, budget, alpha, 0.0, rng=r("discern_style")),
    70	        "SMCS+retain-incumbent": lambda: SMCSDeploymentPolicy(2, r("smcs"), alpha=alpha),
    71	        "model_picker_adapter": lambda: ModelPickerDeploymentAdapter(2, 2, r("model_picker")),
    72	        "model_selector_causal": lambda: ModelSelectorCausalAdapter(2, 2, r("model_selector")),
    73	        "online_llm_picker": lambda: OnlineLLMPicker(2, 2, rng=r("online_llm_picker")),
    74	        "xu_acquisition_only": lambda: XuAcquisitionPolicy("acquisition_only", r("xu"),
    75	                                                           delay=delay),
    76	        "cams_adapter": lambda: CAMSDeploymentAdapter(n_models=2, n_classes=2,
    77	                                                      advice_fn=stack_advice(2, []),
    78	                                                      rng=r("cams")),
    79	        "variance_min_ipw": lambda: VarianceMinStreamingIPW(2, 2, r("vmin"), rate=budget / T,
    80	                                                            class_prior=np.array([.5, .5])),
    81	        "P7s_settled": p7s,
    82	        "CONTROL_never_switch": lambda: FixedModel(0, name="CONTROL_never_switch"),
    83	        "economic_replacement": lambda: EconomicReplacement(T, budget, cs, rng=r("econ")),
    84	    }
    85	    if extra:
    86	        makers.update({k: (lambda f=f: f(T, budget, cs, cq, alpha, delay, r)) for k, f in extra.items()})
    87	    names = names or list(makers)
    88	    out = []
    89	    for n in names:
    90	        pol = makers[n]()
    91	        pol.name = n
    92	        out.append(pol)
    93	    return out
