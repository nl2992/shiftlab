   127	class DeadlinePacer(HorizonWeightedPacer):
   128	    """Uniform pacer over [t, t_dead): no spend after the deadline, all budget usable before it."""
   129	
   130	    def __init__(self, horizon, budget, t_dead, p_min=0.05, k=1.0):
   131	        super().__init__(horizon, budget, p_min=p_min, k=k)
   132	        self.t_dead = int(t_dead)
   133	
   134	    def propensity(self, t, remaining, disagree):
   135	        if not disagree or remaining <= 0 or t >= self.t_dead:
   136	            return 0.0
   137	        rate = (self.n_disagree + self.prior_rate * self.prior_w) / (t + self.prior_w)
   138	        expected_left = max(rate * (self.t_dead - t), 1e-9)
   139	        return float(min(max(self.k * remaining / expected_left, self.p_min), 1.0))
   140	
