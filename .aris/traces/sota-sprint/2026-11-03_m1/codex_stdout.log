--- scripts/sota_sprint/analyze.py ---
     1	"""Screening analysis: per-regime summaries and paired contrasts against the strongest comparators.
     2	
     3	For each candidate and regime it reports mean net cost, promotion rate, rollbacks, labels, delay
     4	and the paired difference (candidate - comparator, 95% t-interval over seeds/episodes) against:
     5	its declared host, the best certified published comparator present (chosen per regime on the same
     6	seeds: conservative for the candidate), the best uncertified published method, and the best
     7	policy of any kind. Null regimes also get the promotion rate against the registered bound.
     8	
     9	    uv run python scripts/sota_sprint/analyze.py outputs/sota_sprint/screen/A \
    10	        --candidates A1,A2 --hosts A1=QSG,A2=QSG --out docs/sota_sprint/screen_A.json
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	import argparse
    16	import json
    17	import sys
    18	from pathlib import Path
    19	
    20	import numpy as np
    21	import pandas as pd
    22	
    23	HERE = Path(__file__).resolve().parent
    24	sys.path.insert(0, str(HERE))
    25	from bench import CERTIFIED_PUBLISHED, NULL_PROMOTION_BOUND, UNCERTIFIED_PUBLISHED, parse_regime  # noqa: E402
    26	
    27	
    28	def load(dirs) -> pd.DataFrame:
    29	    return pd.concat([pd.read_json(Path(d) / "records.jsonl", lines=True) for d in dirs],
    30	                     ignore_index=True)
    31	
    32	
    33	def paired(df: pd.DataFrame, a: str, b: str) -> dict | None:
    34	    piv = df.pivot_table(index=["regime", "ep", "seed"], columns="policy", values="net")
    35	    if a not in piv or b not in piv:
    36	        return None
    37	    d = (piv[a] - piv[b]).dropna().to_numpy()
    38	    if len(d) < 2:
    39	        return None
    40	    se = d.std(ddof=1) / np.sqrt(len(d))
    41	    return {"vs": b, "mean": round(float(d.mean()), 2), "lo": round(float(d.mean() - 1.96 * se), 2),
    42	            "hi": round(float(d.mean() + 1.96 * se), 2), "n": int(len(d)),
    43	            "frac_better": round(float((d < 0).mean()), 3)}
    44	
    45	
    46	def summarise(df: pd.DataFrame, candidates, hosts) -> dict:
    47	    out = {}
    48	    for reg, g in df.groupby("regime"):
    49	        try:
    50	            tags = parse_regime(reg)[0].tags
    51	        except KeyError:
    52	            tags = ("real",)
    53	        means = g.groupby("policy")["net"].mean()
    54	        pol = g.groupby("policy").agg(net=("net", "mean"), promote=("ever_promote", "mean"),
    55	                                      rollbacks=("n_rollbacks", "mean"),
    56	                                      labels=("labels", "mean"), switches=("switches", "mean"),
    57	                                      first=("first_deploy", lambda s: float(np.median(s[s >= 0]))
    58	                                             if (s >= 0).any() else -1),
    59	                                      delay=("detect_delay", lambda s: float(np.median(s[s >= 0]))
    60	                                             if (s >= 0).any() else -1),
    61	                                      regret=("regret_expected_oracle", "mean"),
    62	                                      pending=("max_pending", "mean"),
    63	                                      runtime=("runtime_s", "mean"))
    64	        cert = [p for p in CERTIFIED_PUBLISHED if p in means]
    65	        unc = [p for p in UNCERTIFIED_PUBLISHED if p in means]
    66	        best_cert = means[cert].idxmin() if cert else None
    67	        best_unc = means[unc].idxmin() if unc else None
    68	        cell = {"tags": list(tags), "policies": pol.round(3).to_dict(orient="index"),
    69	                "best_certified": best_cert, "best_uncertified": best_unc, "contrasts": {}}
    70	        for c in candidates:
    71	            if c not in means:
    72	                continue
    73	            others = means.drop(c)
    74	            best_any = others.idxmin()
    75	            cc = {k: paired(g, c, v) for k, v in (("host", hosts.get(c)),
    76	                                                 ("best_certified", best_cert),
    77	                                                 ("best_uncertified", best_unc),
    78	                                                 ("best_any", best_any)) if v}
    79	            if "null" in tags:
    80	                cc["null_promotion"] = round(float(pol.loc[c, "promote"]), 3)
    81	                cc["null_bound_ok"] = bool(pol.loc[c, "promote"] <= NULL_PROMOTION_BOUND)
    82	            cell["contrasts"][c] = cc
    83	        out[reg] = cell
    84	    return out
    85	
    86	
    87	def to_markdown(summary: dict, candidates) -> str:
    88	    lines = ["| candidate | regime | net | promote | first | labels | rb | vs host | vs best cert | vs best uncert |",
    89	             "|---|---|---|---|---|---|---|---|---|---|"]
    90	
    91	    def f(x):
    92	        return "" if not x else f"{x['mean']:+.1f} [{x['lo']:+.1f},{x['hi']:+.1f}] ({x['vs']})"
    93	
    94	    for c in candidates:
    95	        for reg, cell in summary.items():
    96	            if c not in cell["contrasts"]:
    97	                continue
    98	            p = cell["policies"][c]
    99	            k = cell["contrasts"][c]
   100	            lines.append(f"| {c} | {reg} | {p['net']:.1f} | {p['promote']:.2f} | {p['first']:.0f} | "
   101	                         f"{p['labels']:.0f} | {p['rollbacks']:.2f} | {f(k.get('host'))} | "
   102	                         f"{f(k.get('best_certified'))} | {f(k.get('best_uncertified'))} |")
   103	    return "\n".join(lines) + "\n"
   104	
   105	
   106	def main(argv=None):
   107	    ap = argparse.ArgumentParser(description=__doc__)
   108	    ap.add_argument("dirs", nargs="+")
   109	    ap.add_argument("--candidates", required=True)
   110	    ap.add_argument("--hosts", default="", help="cand=host,...")
   111	    ap.add_argument("--out", required=True)
   112	    a = ap.parse_args(argv)
   113	    cands = [c for c in a.candidates.split(",") if c]
   114	    hosts = dict(x.split("=", 1) for x in a.hosts.split(",") if x)
   115	    df = load(a.dirs)
   116	    s = summarise(df, cands, hosts)
   117	    Path(a.out).parent.mkdir(parents=True, exist_ok=True)
   118	    Path(a.out).write_text(json.dumps(s, indent=1, default=float) + "\n")
   119	    Path(a.out).with_suffix(".md").write_text(to_markdown(s, cands))
   120	    print(to_markdown(s, cands))
   121	
   122	
   123	if __name__ == "__main__":
   124	    main()

