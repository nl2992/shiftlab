===== scripts/sota_sprint/ooc_regimes.py =====
     1	"""Out-of-class null regimes (Amendment 2, reviewer objection O2). Registered before any validation row
     2	was read. Marginal P(challenger right on a disagreement) = 1/2 in both, so they are marginal nulls, but
     3	the sign process is NOT a first-order homogeneous Markov chain, i.e. outside A1/A5b's declared class.
     4	Results on them are descriptive (they test robustness to misspecification, not the guarantee).
     5	
     6	* O_null_semimarkov: sign runs in event time with discrete Pareto run lengths (tail index 1.5, min 1);
     7	  each run's sign is a fresh fair coin.
     8	* O_null_order2: s_t copies s_{t-1} w.p. .45, s_{t-2} w.p. .4, else a fresh fair coin.
     9	"""
    10	
    11	from __future__ import annotations
    12	
    13	from dataclasses import dataclass
    14	
    15	import numpy as np
    16	
    17	from bench import SPRINT_REGIMES
    18	
    19	
    20	@dataclass(frozen=True)
    21	class OOCNull:
    22	    name: str
    23	    kind: str
    24	    dis: float = 0.25
    25	    delay: int = 100
    26	    err_agree: float = 0.1
    27	    tags: tuple = ("null", "dep", "out_of_class")
    28	    family: str = "out_of_class"
    29	
    30	    def truth_gain(self, horizon: int = 2000) -> np.ndarray:
    31	        return np.zeros(horizon)
    32	
    33	    def sample(self, rng: np.random.Generator, horizon: int = 2000) -> np.ndarray:
    34	        on = rng.random(horizon) < self.dis
    35	        sign = np.empty(horizon, dtype=bool)
    36	        if self.kind == "semimarkov":
    37	            t = 0
    38	            while t < horizon:
    39	                run = int(np.floor(rng.pareto(1.5) + 1.0))
    40	                sign[t:t + run] = rng.random() < 0.5
    41	                t += run
    42	        else:
    43	            sign[:2] = rng.random(2) < 0.5
    44	            for t in range(2, horizon):
    45	                u = rng.random()
    46	                sign[t] = sign[t - 1] if u < 0.45 else (sign[t - 2] if u < 0.85 else rng.random() < 0.5)
    47	        both_wrong = rng.random(horizon) < self.err_agree
    48	        l0 = np.where(on, sign, both_wrong).astype(np.int8)
    49	        l1 = np.where(on, ~sign, both_wrong).astype(np.int8)
    50	        return np.stack([l0, l1], axis=1)
    51	
    52	
    53	OOC = {r.name: r for r in [OOCNull("O_null_semimarkov", "semimarkov"),
    54	                           OOCNull("O_null_order2", "order2")]}
    55	SPRINT_REGIMES.update(OOC)

