   257	class GatedC(_Ctl, GatedAdaptiveRange):
   258	    def __init__(self, T, B, alpha, cs, cq, delay, ctl, *, rng, name):
   259	        GatedAdaptiveRange.__init__(self, T, B, alpha, rng=rng, name=name)
   260	        self._c_init(T, B, cs, cq, delay, ctl)
   261	
   262	    def _c_record_agree(self, t):
   263	        self._wmax[t] = 2.0  # agreement: w = 1 exactly
   264	
   265	    def _c_record_dis(self, t, q):
   266	        self._wmax[t] = max(1.0 / q, 2.0)  # frozen at issue, used by the CS bet for this step
   267	
   268	    def c_phase2(self, rem, exp_left):
   269	        return (min(rem / exp_left, 1.0), 1.0)  # protected phase: thin uniformly, q = 1
   270	
   271	    def c_skip(self, action, explore):
   272	        if (action or "unrecorded") == "unrecorded":
   273	            return (explore, 1.0)
   274	        return (1.0, self.p_min)
