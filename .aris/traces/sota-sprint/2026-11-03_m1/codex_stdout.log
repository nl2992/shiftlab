     1	"""Evaluate the locked validation protocol (docs/sota_sprint/validation_protocol.md) exactly as written.
     2	
     3	    uv run python scripts/sota_sprint/analyze_validation.py
     4	"""
     5	
     6	from __future__ import annotations
     7	
     8	import json
     9	import math
    10	from pathlib import Path
    11	
    12	import numpy as np
    13	import pandas as pd
    14	from scipy import stats
    15	
    16	ROOT = Path(__file__).resolve().parents[2]
    17	OUT = ROOT / "outputs/sota_sprint/validation"
    18	DOC = ROOT / "docs/sota_sprint/validation"
    19	BOUND = 0.0936
    20	CERT = ["gated_deployment", "gated_adaptive_range", "gated_adaptive_range+front", "discern_style",
    21	        "discern_design_floor", "SMCS+retain-incumbent", "xu_acquisition_only", "choe_ramdas_eb",
    22	        "choe_ramdas_eb+front"]
    23	UNC = ["model_picker_adapter", "model_selector_causal", "online_llm_picker", "cams_adapter",
    24	       "variance_min_ipw", "gong_zhang_paid_obs", "qiu_delayed_movement", "ryabchenko_capacity"]
    25	IID_ALT = ["V_better_a", "V_better_b", "V_better_c", "V_near", "W_delay600_better"]
    26	DECLARED_LOSS = ["V_bursty", "V_dep_better_r5", "W_better_dep_r7", "W_better_dep_r9", "V_late_600",
    27	                 "W_late_1000", "V_reversal_1000", "W_reversal_700", "V_recurrent"]
    28	NULLS = ["V_null", "V_worse", "V_null_dep_r5", "V_null_dep_r8", "W_null_dep_r9", "W_null_dep_r95",
    29	         "W_worse_dep_r8"]
    30	H2_CANDS = ["A5b", "D1", "D2", "C2", "C6", "X_A5C"]
    31	SAFETY_CANDS = ["A5b", "A1b", "X_A5C", "C2", "C6", "D1", "D2", "B2", "rmm:gated_deployment+RMM", "QSG"]
    32	
    33	
    34	def wilson(k, n, z=1.96):
    35	    p = k / n
    36	    c = (p + z * z / (2 * n)) / (1 + z * z / n)
    37	    h = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / (1 + z * z / n)
    38	    return max(0.0, c - h), min(1.0, c + h)
    39	
    40	
    41	def diff(piv, a, b):
    42	    d = (piv[a] - piv[b]).dropna().to_numpy()
    43	    se = d.std(ddof=1) / np.sqrt(len(d))
    44	    t = d.mean() / se if se > 0 else 0.0
    45	    return {"vs": b, "mean": round(float(d.mean()), 2), "lo": round(float(d.mean() - 1.96 * se), 2),
    46	            "hi": round(float(d.mean() + 1.96 * se), 2), "n": len(d),
    47	            "p_one_sided_less": float(stats.t.cdf(t, len(d) - 1)),
    48	            "frac_better": round(float((d < 0).mean()), 3)}
    49	
    50	
    51	def holm(ps):
    52	    order = np.argsort(ps)
    53	    adj = np.empty(len(ps))
    54	    run = 0.0
    55	    for i, j in enumerate(order):
    56	        run = max(run, min(1.0, (len(ps) - i) * ps[j]))
    57	        adj[j] = run
    58	    return adj
    59	
    60	
    61	def main():
    62	    syn = pd.read_json(OUT / "synth/records.jsonl", lines=True)
    63	    nul = pd.read_json(OUT / "null1000/records.jsonl", lines=True)
    64	    piv = {r: g.pivot_table(index="seed", columns="policy", values="net")
    65	           for r, g in syn.groupby("regime")}
    66	    res = {"null_safety": {}, "regimes": {}, "H1": {}, "H2": {}, "H3": {}}
    67	
    68	    # null safety, 1000 seeds
    69	    for (r, p), g in nul.groupby(["regime", "policy"]):
    70	        k, n = int(g.ever_promote.sum()), len(g)
    71	        lo, hi = wilson(k, n)
    72	        res["null_safety"].setdefault(p, {})[r] = {"k": k, "n": n, "rate": k / n,
    73	                                                  "wilson_lo": round(lo, 4), "wilson_hi": round(hi, 4)}
    74	    # per-regime cost table (synthetic 100 seeds)
    75	    for r, P in piv.items():
    76	        means = P.mean()
    77	        g = syn[syn.regime == r].groupby("policy")
    78	        cell = {"mean": means.round(2).to_dict(),
    79	                "promote": g.ever_promote.mean().round(3).to_dict(),
    80	                "first": g.first_deploy.apply(lambda s: float(np.median(s[s >= 0])) if (s >= 0).any() else -1).to_dict(),
    81	                "labels": g.labels.mean().round(1).to_dict(),
    82	                "switches": g.switches.mean().round(2).to_dict()}
    83	        cert = [c for c in CERT if c in means]
    84	        unc = [c for c in UNC if c in means]
    85	        cell["best_certified"] = means[cert].idxmin()
    86	        cell["best_uncertified"] = means[unc].idxmin()
    87	        cell["contrasts"] = {c: {"best_certified": diff(P, c, cell["best_certified"]),
    88	                                 "best_uncertified": diff(P, c, cell["best_uncertified"])}
    89	                             for c in SAFETY_CANDS + ["A1b"] if c in means}
    90	        res["regimes"][r] = cell
    91	
    92	    # H1 for A5b
    93	    s = res["null_safety"]
    94	    part1 = {r: s["A5b"][r]["rate"] <= BOUND for r in NULLS}
    95	    part2 = {c: [r for r in NULLS if s[c][r]["rate"] > BOUND and s[c][r]["wilson_lo"] > 0.05]
    96	             for c in CERT}
    97	    part3 = {r: res["regimes"][r]["contrasts"]["A5b"]["best_certified"] for r in IID_ALT}
    98	    ni = sum(v["hi"] <= 5.0 for v in part3.values())
    99	    res["H1"] = {"part1_safety": part1, "part1_pass": all(part1.values()),
   100	                 "part2_failures": part2, "part2_pass": all(len(v) > 0 for v in part2.values()),
   101	                 "part3_noninferiority": part3, "part3_n_ni": ni, "part3_pass": ni >= 4,
   102	                 "declared_losses": {r: res["regimes"][r]["contrasts"]["A5b"]["best_certified"]
   103	                                     for r in DECLARED_LOSS}}
   104	    res["H1"]["pass"] = res["H1"]["part1_pass"] and res["H1"]["part2_pass"] and res["H1"]["part3_pass"]
   105	    # comparators that pass every null (for a restated H1)
   106	    res["H1"]["certified_passing_all_nulls"] = [c for c in CERT if not part2[c]
   107	                                                and all(s[c][r]["rate"] <= BOUND for r in NULLS)]
   108	
   109	    # H2: Holm over the 5 iid alternatives per candidate, vs best certified published
   110	    for c in H2_CANDS:
   111	        ds = [res["regimes"][r]["contrasts"][c]["best_certified"] for r in IID_ALT]
   112	        adj = holm(np.array([d["p_one_sided_less"] for d in ds]))
   113	        safe = all(s[c][r]["rate"] <= BOUND for r in NULLS)
   114	        res["H2"][c] = {"safe_all_nulls": safe,
   115	                        "rows": {r: {**d, "holm_p": round(float(a), 5)} for r, d, a in zip(IID_ALT, ds, adj)},
   116	                        "n_sig": int((adj < 0.05).sum())}
   117	    # H3 attribution
   118	    h3 = {}
   119	    for r in IID_ALT + ["V_bursty", "V_dep_better_r5"]:
   120	        h3[f"A5b-A1b@{r}"] = diff(piv[r], "A5b", "A1b")
   121	    for r in ["V_reversal_1000", "W_reversal_700", "V_recurrent"]:
   122	        h3[f"B2-host@{r}"] = diff(piv[r], "B2", "rmm:gated_deployment+RMM")
   123	    for r in ["V_null", "V_null_dep_r8"]:
   124	        h3[f"D1-model_picker@{r}"] = diff(piv[r], "D1", "model_picker_adapter")
   125	        h3[f"D2-cams@{r}"] = diff(piv[r], "D2", "cams_adapter")
   126	    for r in IID_ALT:
   127	        h3[f"C2-front@{r}"] = diff(piv[r], "C2", "gated_adaptive_range+front")
   128	    res["H3"] = h3
   129	    DOC.mkdir(parents=True, exist_ok=True)
   130	    (DOC / "validation_results.json").write_text(json.dumps(res, indent=1, default=float) + "\n")
   131	    write_md(res)
   132	
   133	
   134	def write_md(res):
   135	    s = res["null_safety"]
   136	    L = ["# SOTA sprint validation results (locked protocol)", "",
   137	         "Raw: `outputs/sota_sprint/validation/{synth,null1000}`. Synthetic 100 seeds (base 2026110601); "
   138	         "nulls 1000 seeds (base 2026110602).", "", "## Null safety (promotion rate over 1000 seeds; bound .0936)", "",
   139	         "| policy | " + " | ".join(NULLS) + " |", "|---|" + "---|" * len(NULLS)]
   140	    for p in sorted(s):
   141	        L.append(f"| {p} | " + " | ".join(
   142	            (f"**{s[p][r]['rate']:.3f}**" if s[p][r]["rate"] > BOUND else f"{s[p][r]['rate']:.3f}")
   143	            for r in NULLS) + " |")
   144	    h1 = res["H1"]
   145	    L += ["", f"## H1 (A5b reliability at matched cost): **{'PASS' if h1['pass'] else 'FAIL'}**", "",
   146	          f"* Part 1 safety: {'pass' if h1['part1_pass'] else 'FAIL'}",
   147	          f"* Part 2 every certified comparator fails a null: {'pass' if h1['part2_pass'] else 'FAIL'}; "
   148	          f"failures {json.dumps(h1['part2_failures'])}; passing all nulls: {h1['certified_passing_all_nulls']}",
   149	          f"* Part 3 non-inferiority (+5 margin) on {h1['part3_n_ni']}/5: {'pass' if h1['part3_pass'] else 'FAIL'}", "",
   150	          "| regime | A5b - best certified [95% CI] | comparator |", "|---|---|---|"]
   151	    for r, d in {**h1["part3_noninferiority"], **h1["declared_losses"]}.items():
   152	        L.append(f"| {r}{' (declared loss)' if r in DECLARED_LOSS else ''} | {d['mean']:+.1f} [{d['lo']:+.1f},{d['hi']:+.1f}] | {d['vs']} |")
   153	    L += ["", "## H2 (cost superiority vs best certified published, Holm over 5 iid alternatives)", "",
   154	          "| candidate | safe on all nulls | " + " | ".join(IID_ALT) + " | n sig |", "|---|---|" + "---|" * len(IID_ALT) + "---|"]
   155	    for c, v in res["H2"].items():
   156	        L.append(f"| {c} | {v['safe_all_nulls']} | " + " | ".join(
   157	            f"{v['rows'][r]['mean']:+.1f} (p={v['rows'][r]['holm_p']:.3g})" for r in IID_ALT) + f" | {v['n_sig']} |")
   158	    L += ["", "## H3 attribution (paired, 95% CI)", "", "| contrast | mean [CI] |", "|---|---|"]
   159	    for k, d in res["H3"].items():
   160	        L.append(f"| {k} | {d['mean']:+.1f} [{d['lo']:+.1f},{d['hi']:+.1f}] |")
   161	    L += ["", "## All regimes: mean cost of key policies", ""]
   162	    keys = ["A5b", "A1b", "X_A5C", "D1", "D2", "C2", "C6", "B2", "QSG", "xu_acquisition_only",
   163	            "gated_adaptive_range+front", "choe_ramdas_eb+front", "SMCS+retain-incumbent",
   164	            "discern_design_floor", "CONTROL_never_switch"]
   165	    L += ["| regime | best cert | best uncert | " + " | ".join(keys) + " |", "|---|---|---|" + "---|" * len(keys)]
   166	    for r, c in res["regimes"].items():
   167	        m = c["mean"]
   168	        L.append(f"| {r} | {c['best_certified']} {m[c['best_certified']]:.1f} | {c['best_uncertified']} "
   169	                 f"{m[c['best_uncertified']]:.1f} | " + " | ".join(f"{m.get(k, float('nan')):.1f}" for k in keys) + " |")
   170	    (DOC / "validation_results.md").write_text("\n".join(L) + "\n")
   171	    print("\n".join(L[:60]))
   172	
   173	
   174	if __name__ == "__main__":
   175	    main()

