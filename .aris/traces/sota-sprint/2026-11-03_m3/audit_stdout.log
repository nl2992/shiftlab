   105	class _View:
   106	    """Present the stream to a restarted base with shifted time and permuted model indices."""
   107	
   108	    def __init__(self, t0: int, horizon: int, swap: bool):
   109	        self.t0, self.horizon, self.swap = t0, horizon, swap
   110	
   111	    def event(self, ev: Event) -> Event:
   112	        preds = ev.model_predictions[::-1].copy() if self.swap else ev.model_predictions
   113	        return Event(event_id=ev.event_id, t=ev.t - self.t0, horizon=self.horizon,
   114	                     model_predictions=preds, context=ev.context)
   115	
   116	    def feedback(self, fb: ReleasedFeedback) -> ReleasedFeedback:
   117	        ml = fb.model_losses[::-1].copy() if self.swap else fb.model_losses
   118	        return ReleasedFeedback(event_id=fb.event_id, t_requested=fb.t_requested - self.t0,
   119	                                t_released=fb.t_released - self.t0, label=fb.label,
   120	                                model_losses=ml, query_probability=fb.query_probability,
   121	                                extra=fb.extra)
   122	
   123	    def model(self, k: int) -> int:
   124	        return 1 - k if self.swap else k
