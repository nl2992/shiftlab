    53	def metrics(pol, losses, gain, *, delay, budget, cq, cs, stream_rng) -> dict:
    54	    preds, labels = stream_from_losses(losses, stream_rng)
    55	    t0 = time.perf_counter()
    56	    res = run_episode(pol, model_predictions=preds, labels=labels, delay=delay, budget=budget,
    57	                      label_price=cq, switch_cost=cs, trace=True)
    58	    runtime = time.perf_counter() - t0
    59	    if res.requested_labels > budget:
    60	        raise AssertionError(f"{pol.name} exceeded budget")
    61	    rec = res.records
    62	    dep = np.fromiter((r["deployed_model"] for r in rec), int, len(rec))
    63	    req = np.fromiter((r["requested"] for r in rec), int, len(rec))
    64	    Tn = len(dep)
    65	    req_t = np.flatnonzero(req)
    66	    first1 = int(np.argmax(dep == 1)) if (dep == 1).any() else -1
    67	    better, worse = gain > 0, gain < 0
    68	    on_wrong = ((dep == 1) & worse) | ((dep == 0) & better)
    69	    trans = np.diff(np.r_[0, dep])
    70	    pending = np.convolve(req, np.ones(max(delay, 1), int))[:Tn]  # requested, not yet released
    71	    onset = int(np.argmax(better)) if better.any() else -1
    72	    after = np.flatnonzero((dep == 1) & (np.arange(Tn) >= onset)) if onset >= 0 else []
    73	    exp_path = expected_oracle_path(gain, cs)
    74	    exp_cost = float(np.sum(losses[np.arange(Tn), exp_path])
    75	                     + cs * np.sum(np.diff(np.r_[0, exp_path]) != 0))
    76	    return {
    77	        "net": res.net_cost, "loss": res.prediction_loss, "labels": res.requested_labels,
    78	        "switches": res.deployment_switches, "first_deploy": first1, "final": int(dep[-1]),
    79	        "ever_promote": int(first1 >= 0), "n_promotions": int((trans == 1).sum()),
    80	        "n_rollbacks": int((trans == -1).sum()),
    81	        "frac_on_wrong": float(on_wrong.mean()),
    82	        "detect_delay": int(after[0] - onset) if len(after) else -1,
    83	        "labels_by_500": int((req_t < 500).sum()),
    84	        "labels_after_1000": int((req_t >= 1000).sum()),
    85	        "exhaust_t": int(req_t[budget - 1]) if len(req_t) >= budget else Tn,
    86	        "max_pending": int(pending.max()) if Tn else 0,
    87	        "excess_vs_expected_G": float(np.sum(np.where(dep == 1, -gain, 0.0))),
    88	        "regret_hindsight": res.net_cost - hindsight_oracle_cost(losses, cs),
    89	        "regret_expected_oracle": res.net_cost - exp_cost,
    90	        "runtime_s": round(runtime, 4),
    91	    }
