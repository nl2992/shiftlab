    66	# =============================================================================== controller
    67	class Controller:
    68	    """Acquisition controller. One class, flags select the mechanism (so ablations are exact).
    69	
    70	    base:
    71	      ``uniform``   q = remaining / expected remaining disagreements (the host pacer)
    72	      ``k``         horizon-weighted pacing, q = k * remaining / expected remaining (k-pacer)
    73	      ``frontfrac`` q = 1 until ``f*B`` labels are spent, then uniform (tuned-baseline family)
    74	      ``front``     q = 1 while undecided (the ``+front`` repair)
    75	      ``verdict``   C4: pace the remaining budget to the *projected verdict time* rather than T
    76	    mechanisms (applied on top of the base; a gated-off event takes the host's skip action):
    77	      ``credit``    C1 pending-label credit
    78	      ``shadow``    C2 value-of-label vs adaptive shadow price of budget
    79	      ``deadline``  C6 deadline-aware value (release t+delay must precede the last useful moment)
    80	      ``two_stage`` C3/C6 phase 1 base up to ``f2*B`` labels, then protected uniform phase
    81	    """
    82	
    83	    def __init__(self, base="front", *, k=1.0, f=1.0, credit=False, kappa=1.0, shadow=False,
    84	                 gamma=1.0, zeta=0.5, deadline=False, two_stage=None, n0=10,
    85	                 explore=0.0, skip_action=None, beta=None):  # fmt: skip
    86	        self.base, self.k, self.f = base, float(k), float(f)
    87	        self.credit, self.kappa = credit, float(kappa)
    88	        self.shadow, self.gamma, self.zeta = shadow, float(gamma), float(zeta)
    89	        self.deadline, self.two_stage, self.n0 = deadline, two_stage, int(n0)
    90	        self.explore = float(explore)
    91	        self.skip_action = skip_action  # None -> host default
    92	        self.beta = beta  # C4 width-decay exponent override (None -> host default)
    93	        self.n_gated_off = 0
    94	
    95	    # ---- estimates the controller may use (all from released labels / past events only)
    96	    @staticmethod
    97	    def stats(pol, t):
    98	        rate = (pol.acq.n_disagree + PRIOR_RATE * PRIOR_W) / (t + PRIOR_W)
    99	        p_hat = (pol.c_sum_z + 1.0) / (pol.c_n_rel + 2.0)
   100	        g_hat = rate * (2.0 * p_hat - 1.0)  # per-event advantage estimate
   101	        g_lo, g_hi = pol.gain_bounds
   102	        return rate, g_hat, g_lo, g_hi
   103	
   104	    def decide(self, pol, t, rem, dis):
   105	        T, B = pol.c_T, pol.c_B
   106	        rate = (pol.acq.n_disagree + PRIOR_RATE * PRIOR_W) / (t + PRIOR_W)
   107	        exp_left = max(rate * (T - t), 1e-9)
   108	        uni = min(max(rem / exp_left, pol.p_min), 1.0)
   109	        spent = B - rem
   110	        phase2 = self.two_stage is not None and spent >= self.two_stage * B
   111	        # ---- base intensity (pi, q)
   112	        if phase2:
   113	            base = pol.c_phase2(rem, exp_left)
   114	        elif self.base == "uniform":
   115	            base = (1.0, uni)
   116	        elif self.base == "k":
   117	            base = (1.0, min(max(self.k * rem / exp_left, pol.p_min), 1.0))
   118	        elif self.base == "frontfrac":
   119	            base = (1.0, 1.0) if spent < self.f * B else (1.0, uni)
   120	        elif self.base == "front":
   121	            base = (1.0, 1.0)
   122	        elif self.base == "verdict":
   123	            base = (1.0, self._verdict_q(pol, t, rem, rate))
   124	        else:
   125	            raise ValueError(self.base)
   126	        if not (self.credit or self.shadow or self.deadline):
   127	            return base
   128	        if not self._value_gate(pol, t, rem, rate, base, phase2):
   129	            self.n_gated_off += 1
   130	            return pol.c_skip(self.skip_action, self.explore)
   131	        return base
   132	
   133	    def _value_gate(self, pol, t, rem, rate, base, phase2) -> bool:
   134	        if pol.c_n_rel < self.n0:
   135	            return True  # warm-up: no estimate yet
   136	        T, cs, cq, delay = pol.c_T, pol.c_cs, pol.c_cq, pol.c_delay
   137	        _, g_hat, g_lo, g_hi = self.stats(pol, t)
   138	        hw = max((g_hi - g_lo) / 2.0, 1e-9)
   139	        n = pol.c_n_rel
   140	        P = len(pol._pending)
   141	        # C1: will the labels already requested settle the verdict? (point estimate, safety kappa)
   142	        if self.credit and g_hat > 0:
   143	            n_tot_pt = n * (hw / g_hat) ** 2
   144	            if n + P >= self.kappa * n_tot_pt:
   145	                return False
   146	        if not (self.shadow or self.deadline):
   147	            return True
   148	        g_eff = max(0.0, (1.0 - self.zeta) * max(g_hat, 0.0) + self.zeta * max(g_hi, 0.0))
   149	        if g_eff <= 0.0:
   150	            return False
   151	        n_tot = n * (hw / g_eff) ** 2
   152	        n_rem = max(n_tot - n - (P if self.credit else 0), 1.0)
   153	        horizon = T - t
   154	        if self.deadline:
   155	            pi_hi = base[0] * base[1]
   156	            collect = n_rem / max(rate * pi_hi, 1e-9)
   157	            horizon = T - t - delay - collect
   158	            if horizon * g_eff <= cs:
   159	                return False  # its release comes after the last moment a verdict is worth c_s
   160	        if not self.shadow:
   161	            return True
   162	        value = max(0.0, g_eff * horizon - cs) / n_rem
   163	        spend_rate = (pol.c_B - rem + PRIOR_W * pol.c_B / T) / (t + PRIOR_W)
   164	        demand = spend_rate * (T - t)
   165	        lam = cq * max(1.0, demand / max(rem, 1)) ** self.gamma
   166	        return value >= lam
   167	
   168	    def _verdict_q(self, pol, t, rem, rate):
   169	        """C4: spend the remaining budget evenly up to the projected verdict time, not up to T."""
   170	        T = pol.c_T
   171	        if pol.c_n_rel < self.n0:
   172	            tau = T
   173	        else:
   174	            _, g_hat, g_lo, g_hi = self.stats(pol, t)
   175	            hw = max((g_hi - g_lo) / 2.0, 1e-9)
   176	            g_eff = abs(g_hat)  # either verdict ends acquisition
   177	            n_ev = max(pol.n_ingested, 1)
   178	            if g_eff <= 1e-9:
   179	                tau = T
   180	            else:
   181	                ev_tot = n_ev * (hw / g_eff) ** (1.0 / (self.beta or pol.c_beta))
   182	                tau = min(T, t + pol.c_delay + self.k * max(ev_tot - n_ev, 0.0))
   183	        left = max(rate * max(tau - t, 1.0), 1e-9)
   184	        return float(min(max(rem / left, pol.p_min), 1.0))
   185	
